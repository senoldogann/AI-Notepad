---
// Kullanım şartları. Sınırlar ve ödeme davranışı sunucuyla aynıdır (server/wrangler.jsonc `vars`, server/src/billing.ts,
// server/src/account.ts, trialLedger.ts, deviceCheck.ts). Ödeme Stripe Managed Payments ile alınır: satıcı (merchant of
// record) Link'tir; iade ve cayma hakkı Link'in şartlarına bağlıdır (link.com/terms "Sold Through Link Terms": AB
// tüketicisine erişimden itibaren 14 gün, Link desteğine "cooling off period" gerekçesiyle başvurulur). Davet programının
// kuralları (ödül, bekleme süresi, yıllık sınır) sunucunun davet kurallarıyla aynı tutulur.
import LegalSection from "../components/LegalSection.astro";
import Legal from "../layouts/Legal.astro";
import { cardStatementDescriptor, productName } from "../config";
import { copy } from "../copy";
import type { LegalSectionInfo } from "../lib/legal";
import { operator } from "../legal/operator";
import { routes } from "../routes";

const sections: readonly LegalSectionInfo[] = [
  { id: "about", title: "About these terms" },
  { id: "service", title: "The service" },
  { id: "account", title: "Your account" },
  { id: "trial", title: "Free trial" },
  { id: "subscription", title: "Subscription, price and payment" },
  { id: "cancel", title: "Cancelling" },
  { id: "withdrawal", title: "Refunds and right of withdrawal" },
  { id: "invites", title: "Invites: give a month, get a month" },
  { id: "limits", title: "Fair use and limits" },
  { id: "use", title: "Acceptable use and recording consent" },
  { id: "content", title: "Your content" },
  { id: "dpa", title: "Processing personal data on your behalf" },
  { id: "ai", title: "AI-generated output" },
  { id: "third-party", title: "Integrations and third-party services" },
  { id: "availability", title: "Availability and changes to the service" },
  { id: "termination", title: "Suspension and termination" },
  { id: "liability", title: "Liability" },
  { id: "changes", title: "Changes to these terms" },
  { id: "law", title: "Governing law and disputes" },
  { id: "contact", title: "Contact" },
];
const mail: string = `mailto:${operator.email}`;
/** Link'in satın alma şartları (Stripe Managed Payments: satıcı Link) ve destek adresi. */
const linkTermsUrl: string = "https://link.com/terms#sold-through-link-terms";
const linkSupportUrl: string = "https://support.link.com/topics/sold-through-link";
---

<Legal page="terms" meta={copy.termsMeta} title={copy.common.nav.terms} sections={sections}>
  <p class="legal-lead">
    These terms govern your use of {productName}. Please read them together with the{" "}
    <a href={routes.privacy}>Privacy policy</a>, which explains how we handle personal data.
  </p>

  <LegalSection sections={sections} id="about">
    <p>
      {productName} is provided by <strong>{operator.name}</strong>, {operator.legalForm}, business ID (Y-tunnus) {operator.businessId},{" "}
      {operator.address} (“we”, “us”). These terms are an agreement between you and us. By creating an
      account, starting a free trial or subscribing, you accept them.
    </p>
    <p>
      If you use {productName} for a business, you confirm that you may accept these terms on its behalf. Some sections
      apply differently to consumers and to business customers; where they do, we say so. Nothing in these terms limits
      the rights you have as a consumer under mandatory law.
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="service">
    <p>
      {productName} is a Mac app that records your meetings, shows a live transcript and optional live translation, and
      writes a note when the meeting ends — your tasks first, then decisions and a summary. Transcription after the meeting
      and the AI features run through our servers using our providers (see the Privacy policy); the live transcript is
      produced on your Mac or, when available, by our speech-to-text provider from audio streamed directly from your Mac.
      Your notes and recordings are stored on your Mac.
    </p>
    <p>
      Subject to these terms, you may download and use the app on Macs you own or control, for as long as you have an
      account. The service requires macOS 15 or later on a Mac with Apple silicon, and an internet connection.
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="account">
    <ul>
      <li>You sign in with Sign in with Apple or Sign in with Google. You must be at least 18 years old.</li>
      <li>Your account is personal. Keep your Apple or Google account and your Mac secure; you are responsible for activity under your account.</li>
      <li>Creating several accounts to get more free trials, or sharing an account between people, is not allowed.</li>
    </ul>
  </LegalSection>

  <LegalSection sections={sections} id="trial">
    <p>
      New users get one free trial, with no payment card required: <strong>3 meetings or 7 days</strong> from your first
      trial meeting, whichever comes first. Trial meetings not used within the 7 days expire, and each trial meeting can be
      up to 90 minutes long. During the trial, AI features used outside a meeting (for example Ask or rewriting a note)
      have a small daily limit.
    </p>
    <ul>
      <li>
        There is one free trial per person and one per Mac. We keep a pseudonymous record of the sign-in identity (Apple
        or Google account) that used a trial, and Apple DeviceCheck tells us whether a Mac has already been used for one.
      </li>
      <li>
        If you delete your account and sign in again with the same Apple or Google account, your trial continues where it
        left off; it does not start again.
      </li>
      <li>We may refuse to start new free trials when many accounts start from the same network on the same day.</li>
      <li>When the trial ends, you can keep reading your existing notes, but you need a subscription to start new meetings.</li>
    </ul>
  </LegalSection>

  <LegalSection sections={sections} id="subscription">
    <ul>
      <li>
        The subscription is billed either monthly, at <strong>USD 5.99 per month</strong>, or yearly, at{" "}
        <strong>USD 49 per year</strong>, <strong>taxes included</strong>: any sales tax, VAT or GST that applies where
        you live is part of that price. You choose the plan when you subscribe. The price is shown at checkout before you
        pay; it may be shown in your local currency.
      </li>
      <li>
        Subscriptions are sold through <strong>Link</strong>, Stripe's payment service, which acts as the{" "}
        <strong>merchant of record</strong> (the seller) for your purchase. Checkout is hosted by Stripe, and Link
        calculates, collects and remits the taxes. <a href={linkTermsUrl}>Link's terms</a> apply to the purchase and
        payment; these terms apply to your use of {productName}. Receipts and some subscription emails are sent by Link, and your card statement shows{" "}
        <code>{cardStatementDescriptor}</code>. We never see your card details.
      </li>
      <li>
        You subscribe from your <a href={routes.account}>account page</a> or in the app. The subscription starts when the
        payment is confirmed. <strong>It renews automatically</strong> at the end of each billing period — every month on
        the same day of the month, or every year on the same date — and each renewal is charged to your saved payment
        method, <strong>until you cancel</strong>. You can cancel at any time (see section 6).
      </li>
      <li>
        To move between the monthly and yearly plan, cancel your current plan and, once it has ended, subscribe again with
        the other plan. A subscription can't be bought while another one is still running.
      </li>
      <li>
        If a payment fails, it is retried over the following days. You keep access for up to 7 days after the end of the
        paid period; after that, new meetings can't be started until the payment succeeds.
      </li>
      <li>
        If we change the price, we will tell you in the app and on our website at least 30 days in advance (Link also
        emails you before a renewal at a new price). The new price applies from your next billing
        period after the notice period, and you can cancel before it takes effect.
      </li>
      <li>
        Purchases are not available in some countries and regions where Stripe cannot sell, including China, Cuba, Iran,
        North Korea, Russia and Syria.
      </li>
    </ul>
  </LegalSection>

  <LegalSection sections={sections} id="cancel">
    <p>
      You can cancel at any time with “Manage subscription” on your <a href={routes.account}>account page</a>, or at
      link.com, where you can also update your payment method. Cancelling stops the next renewal; you keep access until the
      end of the period you have already paid for.
    </p>
    <p>
      If you delete your account, any active subscription is cancelled immediately and the rest of the current period ends
      with it. Refunds for the remaining time follow the refund rules below.
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="withdrawal">
    <p>
      Link is the merchant of record for the subscription, so payment questions, refunds and the statutory right of
      withdrawal are handled by Link under <a href={linkTermsUrl}>Link's terms</a>, which also provide the way to withdraw.
    </p>
    <ul>
      <li>
        <strong>Right of withdrawal (EU and EEA consumers).</strong> Under Link's terms, you can cancel your order within 14
        days from the day you get access to the subscription. To do so, contact{" "}
        <a href={linkSupportUrl}>Link support</a>, follow its instructions for requesting a refund and give “cooling off
        period” as the reason.
      </li>
      <li>
        <strong>A service that has already started.</strong> The subscription is a digital service that starts, at your
        request, as soon as your payment is confirmed. If you withdraw within the 14 days, EU consumer law lets the seller
        charge an amount in proportion to the service provided until you withdrew; the right of withdrawal ends early only
        if the service has been fully provided with your express prior consent. How this applies to your request is set
        out in Link's terms.
      </li>
      <li>
        <strong>Other refunds.</strong> Link may also refund a payment within 60 days in certain other cases, such as a
        duplicate or unauthorised charge. Apart from these cases, or where mandatory law requires otherwise, unused parts of
        a subscription period are not refunded.
      </li>
    </ul>
    <p>
      You can also write to us at <a href={mail}>{operator.email}</a> and we will help you with a request to Link. Nothing in
      these terms limits any statutory right you have as a consumer.
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="invites">
    <p>
      Subscribers get a personal invite code. The invite programme works as follows; it doesn't change the rest of these
      terms.
    </p>
    <ul>
      <li>
        <strong>Your friend's discount.</strong> A new subscriber who enters a valid invite code when subscribing gets their
        first month free on the monthly plan, or USD 5.99 off the first year on the yearly plan. Invite codes are only for
        accounts that have never subscribed before, and each person can use one invite only once.
      </li>
      <li>
        <strong>Your reward.</strong> When your friend's first payment has gone through and has not been refunded or
        disputed for 30 days, a credit of USD 5.99 is added to your Stripe customer balance and taken off your next
        payment (on the monthly plan, that covers a month). The reward is cancelled if that payment is refunded or
        disputed before then.
      </li>
      <li>
        <strong>Limits.</strong> You can earn up to 12 rewards in any 12 months, and one reward per new paying account.
        Using your own code, a code from another account of yours, or an account created to collect rewards doesn't
        count; we may cancel rewards and discounts obtained that way, or in breach of these terms.
      </li>
      <li>
        <strong>No cash value.</strong> Rewards and discounts are credit towards future payments for {productName} only.
        They have no cash value and can't be exchanged, transferred or paid out. Credit that hasn't been used when your
        subscription ends stays with your Stripe customer record and is used if you subscribe again.
      </li>
      <li>
        <strong>Changes.</strong> We may change or end the invite programme at any time by updating these terms. Rewards
        already earned before a change remain yours.
      </li>
    </ul>
  </LegalSection>

  <LegalSection sections={sections} id="limits">
    <p>The subscription is for normal individual use. To keep the service fair and affordable:</p>
    <ul>
      <li>It includes up to <strong>10 hours of meetings per month</strong>. The allowance resets on the first day of each month (UTC).</li>
      <li>A single meeting can last up to <strong>4 hours</strong>; longer recordings are closed at that point.</li>
      <li>Up to 20 meetings can be started per day, and AI features have daily and monthly usage ceilings.</li>
      <li>When you reach a limit, the app tells you clearly and new meetings can't be started until the limit resets. Your existing notes remain available.</li>
      <li>To protect the service, AI features may pause temporarily if overall usage reaches a daily safety ceiling.</li>
    </ul>
  </LegalSection>

  <LegalSection sections={sections} id="use">
    <ul>
      <li>
        <strong>Recording consent.</strong> Laws on recording conversations differ between countries. Before you record,
        you are responsible for informing everyone in the meeting and, where required, getting their consent. The app
        reminds you, but the responsibility is yours.
      </li>
      <li>Don't use the service for anything unlawful, to infringe other people's rights, or to record conversations you are not entitled to record.</li>
      <li>
        Don't access our servers other than through the app and our website, try to get around limits or device checks, resell the
        service or overload it. Don't reverse engineer, decompile or disassemble the app or the service, except as
        permitted by applicable law.
      </li>
    </ul>
  </LegalSection>

  <LegalSection sections={sections} id="content">
    <p>
      Your recordings, transcripts and notes belong to you. You give us permission to process them only as needed to
      provide the service to you. We don't store your meeting content on our servers and don't use it to train AI models.
      Because your notes are stored on your Mac, keeping backups of your Mac is up to you.
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="dpa">
    <p>
      The meetings you record include personal data of other participants: their voices, what they say and their names.
      For that data you are the controller and we are your processor. This section is our data processing agreement under
      Article 28 of the GDPR.
    </p>
    <ul>
      <li>
        <strong>Subject, purpose and duration.</strong> We process meeting audio, transcripts, notes and the participant
        names and terms you add, only to transcribe your meetings and to produce notes, translations and answers for you,
        for as long as you use the service. The categories of data depend on what is said in your meetings.
      </li>
      <li>
        <strong>Your instructions.</strong> These terms and the <a href={routes.privacy}>Privacy policy</a> are your
        documented instructions. We process the data for no other purpose, unless EU or Finnish law requires us to; in that
        case we tell you first unless the law forbids it.
      </li>
      <li>
        <strong>Confidentiality and security.</strong> Only the operator has access to the service's systems and is bound
        by confidentiality. Meeting content is encrypted in transit; our servers keep no audio or notes, and keep the final
        transcript encrypted for at most 2 hours so it can be re-sent; our other security
        measures are described in the Privacy policy.
      </li>
      <li>
        <strong>Sub-processors.</strong> You authorise the sub-processors listed in{" "}
        <a href={`${routes.privacy}#providers`}>section 7 of the Privacy policy</a> (Cloudflare, Deepgram, ElevenLabs
        and Anthropic for meeting content). We bind them by written data processing terms with data protection obligations equivalent to
        these, and we remain responsible to you for them. We announce changes to this list in the Privacy policy before
        they take effect; if you object, you can stop using the service and delete your account.
      </li>
      <li>
        <strong>Assistance.</strong> Taking into account the nature of the processing, we help you answer requests from
        people who use their data protection rights, and with security, data breach notifications, impact assessments and
        consultations with supervisory authorities. We tell you without undue delay after becoming aware of a personal data
        breach affecting this data.
      </li>
      <li>
        <strong>Deletion.</strong> We don't keep meeting content after processing it: transcripts and notes are returned
        to your Mac, and you delete them there; the encrypted copy of the final transcript is deleted from our server
        within 2 hours, or immediately when you delete your account. Our sub-processors delete it under the retention rules described in the
        Privacy policy.
      </li>
      <li>
        <strong>Demonstrating compliance.</strong> We give you the information you need to show that these obligations are
        met, including written answers to reasonable audit questions.
      </li>
    </ul>
  </LegalSection>

  <LegalSection sections={sections} id="ai">
    <p>
      Transcripts, translations, summaries, tasks and answers are produced automatically by AI models. They can be
      incomplete or wrong — for example misheard names, numbers or speakers. Check anything important against the recording
      before you rely on it, especially for legal, medical, financial or other high-stakes decisions.
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="third-party">
    <p>
      You connect integrations such as Notion, Slack, Microsoft Teams, Discord, Zoom, Linear, Jira, Apple Notes, Markdown
      folders and webhooks (for example Zapier, Make or n8n) with your own
      accounts. Those services are provided by third parties under their own terms, and we are not responsible for how they
      work. Product names and logos belong to their owners.
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="availability">
    <p>
      We work to keep {productName} running well, but we can't promise uninterrupted availability. The service may pause
      for maintenance, outages at our providers, or security reasons. We may improve and change features; if we make a
      change that substantially reduces what the subscription includes, we will tell you in advance and you may cancel.
      If we discontinue the service, we will give you at least 30 days' notice and arrange a refund of any prepaid period that remains.
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="termination">
    <p>
      You can stop using {productName} and delete your account at any time on your <a href={routes.account}>account page</a>.
      We may suspend or close an account that seriously or repeatedly breaches these terms, or where the law requires us to.
      Where appropriate, we will warn you first and give you a chance to fix the problem. If we close your account without
      it being your fault, we arrange a refund of any prepaid period that remains.
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="liability">
    <p>
      <strong>Consumers.</strong> We are responsible for providing the service as described in these terms, and you have
      the rights that mandatory consumer law gives you if it doesn't meet them. Nothing in these terms limits those rights.
    </p>
    <p>
      <strong>Business customers.</strong> To the extent permitted by law, we are not liable for indirect or consequential
      loss (such as lost profits, lost business or loss of data), and our total liability is limited to the amount you
      paid us in the 12 months before the event that gave rise to the claim.
    </p>
    <p>
      These limits do not apply to damage caused intentionally or through gross negligence, or to any other liability that
      cannot be limited by law.
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="changes">
    <p>
      We may update these terms, for example when the service or the law changes. We announce material changes in the app
      and on our website at least 30 days before they take effect. If you don't agree, you can cancel before then; continuing to
      use the service after the change means you accept it.
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="law">
    <p>
      These terms are governed by the laws of Finland. If you are a consumer, you also keep the protection of the mandatory
      consumer laws of the country where you live.
    </p>
    <p>
      If something goes wrong, please contact us first — most issues are quickest to solve directly. Consumers in Finland can
      get help from the Consumer Advisory Services (kuluttajaneuvonta) and can bring a dispute to the Consumer Disputes Board
      (Kuluttajariitalautakunta, <a href="https://www.kuluttajariita.fi/en/">kuluttajariita.fi</a>). Consumers in other EU
      countries, Iceland and Norway can get free help with a cross-border dispute from the European Consumer Centre in
      their own country, which works together with the European Consumer Centre Finland (ECC Finland,{" "}
      <a href="https://www.ecc.fi/en/">ecc.fi</a>). Consumers can also take a dispute to the courts of the place where they
      live. For business customers, disputes are settled by the Oulu District
      Court (Oulun käräjäoikeus).
    </p>
  </LegalSection>

  <LegalSection sections={sections} id="contact">
    <p>
      {operator.name}<br />
      {operator.address}<br />
      Business ID {operator.businessId}<br />
      <a href={mail}>{operator.email}</a>
    </p>
  </LegalSection>
</Legal>
