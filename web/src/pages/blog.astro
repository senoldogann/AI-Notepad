---
// Blog dizini: yazılar yeniden eskiye kart olarak (kapak, başlık, özet, tarih, okuma süresi) ve RSS bağlantısı.
import Base from "../layouts/Base.astro";
import BlogCard from "../components/BlogCard.astro";
import Icon from "../components/Icon.astro";
import { copy, type BlogCopy } from "../copy";
import { type BlogPost, blogEntries, blogPost } from "../lib/blog";
import { websiteCard } from "../lib/social";
import { blogFeedPath } from "../routes";

const text: BlogCopy = copy.blog;
const posts: readonly BlogPost[] = (await blogEntries()).map(blogPost);
---

<Base page="blog" meta={text.meta} indexed={true} social={websiteCard}>
  <section class="page blog-intro">
    <p class="eyebrow">{text.eyebrow}</p>
    <h1 class="title-xl">{text.title}</h1>
    <p class="lead">{text.lead}</p>
    <a class="text-link small" href={blogFeedPath}>{text.feedLink} <Icon name="arrow-right" size={14} class="" /></a>
  </section>

  <section class="page blog-posts" aria-labelledby="blog-list-title">
    <h2 class="visually-hidden" id="blog-list-title">{text.title}</h2>
    <ol class="blog-grid">
      {
        posts.map((post: BlogPost) => (
          <li>
            <BlogCard post={post} />
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .blog-intro {
    display: grid;
    gap: 18px;
    justify-items: start;
    padding-block: clamp(48px, 8vw, 96px) clamp(28px, 4vw, 48px);
  }

  .blog-intro .lead {
    max-width: 44rem;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: clamp(36px, 4vw, 48px) clamp(20px, 2.6vw, 32px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blog-grid > li {
    min-width: 0;
  }
</style>
