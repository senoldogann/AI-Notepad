---
// Blog dizini: yazılar yeniden eskiye (başlık, özet, tarih, okuma süresi) ve RSS bağlantısı.
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { copy, type BlogCopy } from "../copy";
import { type BlogPost, blogEntries, blogPost, publishedIso, publishedText } from "../lib/blog";
import { blogFeedPath, blogPostPath } from "../routes";

const text: BlogCopy = copy.blog;
const posts: readonly BlogPost[] = (await blogEntries()).map(blogPost);
---

<Base page="blog" meta={text.meta} indexed={true}>
  <section class="page blog-intro">
    <p class="eyebrow">{text.eyebrow}</p>
    <h1 class="title-xl">{text.title}</h1>
    <p class="lead">{text.lead}</p>
    <a class="text-link small" href={blogFeedPath}>{text.feedLink} <Icon name="arrow-right" size={14} class="" /></a>
  </section>

  <section class="page" aria-labelledby="blog-list-title">
    <h2 class="visually-hidden" id="blog-list-title">{text.title}</h2>
    <ol class="blog-list">
      {
        posts.map((post: BlogPost) => (
          <li class="blog-item">
            <article>
              <p class="small muted blog-item__meta">
                <time datetime={publishedIso(post.published)}>{publishedText(post.published)}</time>
                <span aria-hidden="true">·</span>
                <span>
                  {post.minutes} {text.minutesRead}
                </span>
              </p>
              <h3 class="title-m blog-item__title">
                <a href={blogPostPath(post.slug)}>{post.title}</a>
              </h3>
              <p class="muted">{post.description}</p>
            </article>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .blog-intro {
    display: grid;
    gap: 18px;
    justify-items: start;
    padding-block: clamp(48px, 8vw, 96px) clamp(28px, 4vw, 48px);
  }

  .blog-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
    max-width: 52rem;
  }

  .blog-item {
    padding-block: 28px;
    border-bottom: 1px solid var(--line);
  }

  .blog-item article {
    display: grid;
    gap: 8px;
  }

  .blog-item__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .blog-item__title {
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
  }

  .blog-item__title a {
    text-decoration: none;
  }

  .blog-item__title a:hover {
    text-decoration: underline;
  }
</style>
