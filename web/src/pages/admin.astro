            <section id="blog-list-view" class="blog" aria-labelledby="blog-list-title">
              <p id="blog-notice" class="notice hidden" role="status"></p>
              <div class="blog__top">
                <div id="blog-cadence" class="card kpi blog-cadence">
                  <p class="kpi__label">
                    <Icon name="calendar" size={16} class="kpi__icon" />
                    {blogText.cadenceTitle}
                  </p>
                  <p id="blog-cadence-latest" class="blog-cadence__latest"></p>
                  <p id="blog-cadence-next" class="kpi__sub small"></p>
                </div>
                <div class="blog__actions">
                  <a id="blog-open-blog" class="button button--secondary button--small blog__new" href={routes.blog} target="_blank" rel="noopener">
                    <Icon name="external" size={16} class="" />
                    {blogText.openBlog}
                  </a>
                  {/* Liste yüklenince açılır: yeni yazının önerilen tarihi ve yazarı listeden gelir (admin-blog.ts). */}
                  <button id="blog-new" class="button button--primary button--small blog__new" type="button" disabled>
                    <Icon name="note" size={16} class="" />
                    {blogText.newPost}
                  </button>
                </div>
              </div>
              {/* Yayındaki yazının satırındaki "sitede aç" simge bağlantısı; betik kopyalayıp adresini yazar. */}
              <template id="blog-open-template">
                <a class="blog-open" target="_blank" rel="noopener" title={blogText.openOnSite}>
                  <Icon name="external" size={16} class="" />
                </a>
              </template>
              <div class="card table-card">
                <h2 class="detail__label table-card__title" id="blog-list-title">{blogText.listTitle}</h2>
                <div class="table-scroll" tabindex="0" role="region" aria-labelledby="blog-list-title">
                  <table class="data-table blog-table">
                    <thead>
                      <tr>{blogColumns.map((column: Column) => <th scope="col" class:list={{ numeric: column.numeric }}>{column.label}</th>)}</tr>
                    </thead>
                    <tbody id="blog-rows"></tbody>
                  </table>
                </div>
                <p id="blog-empty" class="muted table-empty hidden">{blogText.empty}</p>
              </div>
            </section>

            <section id="blog-editor-view" class="blog-editor hidden" aria-labelledby="blog-editor-title">
              <div class="user-detail__head">
                <button id="blog-back" class="button button--secondary button--small" type="button">{blogText.back}</button>
                <h2 id="blog-editor-title" class="title-m blog-editor__title">{blogText.newTitle}</h2>
                <div id="blog-editor-status" class="pill-row"></div>
                <a id="blog-open-post" class="blog-open blog-open--labelled hidden" href={routes.blog} target="_blank" rel="noopener">
                  <Icon name="external" size={16} class="" />
                  {blogText.openOnSite}
                </a>
              </div>
              <p id="blog-editor-notice" class="notice hidden" role="status"></p>
              <div id="blog-share" class="blog-share hidden">
                <span class="detail__label">{blogText.shareTitle}</span>
