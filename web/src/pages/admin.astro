---
// Yönetim paneli (menüde ve site haritasında yok, arama motorlarına kapalı, önbelleğe alınmaz): dört görünüm — genel
// bakış (özet kutuları ve son 30 günün grafikleri), kullanıcılar (liste ve ayrıntı), işletim (açık toplantılar, takılı
// işler, Stripe olayları, son çökmeler) ve bildirim kutusu. Değerler tarayıcıda `/v1/admin/*` uçlarından doldurulur
// (src/client/admin*.ts). Panelin varlığı belli olmaz: sayfa başlığı nötrdür, panel `<template>` içinde durur ve
// yalnızca sunucu yönetici erişimini doğrulayınca (`/v1/admin/stats` başarılı) sayfaya eklenir. O zamana dek yalnızca
// nötr bir yükleme satırı görünür; oturum yoksa ya da sunucu 403 (veya yenilemesi başarısız 401) dönerse standart
// "sayfa bulunamadı" görünümü.
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import NotFound from "../components/NotFound.astro";
import { type AdminCopy, copy } from "../copy";
import type { IconName } from "../lib/icons";

const text: AdminCopy = copy.admin;

/** Özet kutusu: kimlik (betik `kpi-<id>`, `kpi-<id>-sub` ve varsa `kpi-<id>-meter` doldurur), etiket, simge, ölçer var mı. */
interface KpiSpec {
  readonly id: string;
  readonly label: string;
  readonly icon: IconName;
  readonly meter: boolean;
}

/** Özet kutusu grubu: başlık ve kutular (her grup dört kutu, tam genişlik). */
interface KpiGroup {
  readonly id: "growth" | "revenue" | "usage" | "costs";
  readonly title: string;
  readonly kpis: readonly KpiSpec[];
}

/** Genel bakışın özet kutuları dört grupta: büyüme, gelir, kullanım, maliyet ve kapasite. */
const groups: readonly KpiGroup[] = [
  {
    id: "growth",
    title: text.groups.growth,
    kpis: [
      { id: "downloads", label: text.kpis.downloads, icon: "download", meter: false },
      { id: "users", label: text.kpis.users, icon: "users", meter: false },
      { id: "trials", label: text.kpis.trials, icon: "gift", meter: false },
      { id: "subscribers", label: text.kpis.subscribers, icon: "card", meter: false },
    ],
  },
  {
    id: "revenue",
    title: text.groups.revenue,
    kpis: [
      { id: "mrr", label: text.kpis.mrr, icon: "chart", meter: false },
      { id: "conversion", label: text.kpis.conversion, icon: "sparkle", meter: true },
      { id: "churn", label: text.kpis.churn, icon: "rewind", meter: false },
      { id: "payments", label: text.kpis.payments, icon: "wallet", meter: false },
    ],
  },
  {
    id: "usage",
    title: text.groups.usage,
    kpis: [
      { id: "meetings", label: text.kpis.meetings, icon: "calendar", meter: false },
      { id: "hours", label: text.kpis.hours, icon: "clock", meter: false },
      { id: "audio", label: text.kpis.audio, icon: "waveform", meter: false },
      { id: "tokens", label: text.kpis.tokens, icon: "tokens", meter: false },
    ],
  },
  {
    id: "costs",
    title: text.groups.costs,
    kpis: [
      { id: "spend", label: text.kpis.spend, icon: "chip", meter: true },
      { id: "elevenlabs", label: text.kpis.elevenLabs, icon: "timer", meter: true },
      { id: "deepgram", label: text.kpis.deepgram, icon: "translate", meter: true },
      { id: "refusals", label: text.kpis.refusals, icon: "lock", meter: false },
    ],
  },
];

/** İşletim görünümünün özet kutuları (betik `kpi-ops-<id>` doldurur). */
const opsKpis: readonly KpiSpec[] = [
  { id: "ops-open", label: text.operations.kpis.open, icon: "play", meter: false },
  { id: "ops-unended", label: text.operations.kpis.unended, icon: "pause", meter: false },
  { id: "ops-reservations", label: text.operations.kpis.reservations, icon: "disk", meter: false },
  { id: "ops-deepgram", label: text.operations.kpis.deepgram, icon: "translate", meter: false },
  { id: "ops-webhook", label: text.operations.kpis.webhook, icon: "plug", meter: false },
  { id: "ops-reports", label: text.operations.kpis.reports, icon: "inbox", meter: false },
];

/** Grafikler: kimlik (betik `chart-<id>` çizer) ve başlık. */
const charts: readonly { readonly id: string; readonly title: string; readonly legend: boolean }[] = [
  { id: "downloads", title: text.charts.downloads, legend: false },
  { id: "users", title: text.charts.users, legend: false },
  { id: "meetings", title: text.charts.meetings, legend: true },
  { id: "spend", title: text.charts.spend, legend: false },
];

/** Panelin görünümleri (betik `view-<id>` düğmesiyle `panel-<id>` açar). */
const views: readonly { readonly id: string; readonly label: string; readonly icon: IconName }[] = [
  { id: "overview", label: text.views.overview, icon: "chart" },
  { id: "users", label: text.views.users, icon: "users" },
  { id: "operations", label: text.views.operations, icon: "laptop" },
  { id: "inbox", label: text.views.inbox, icon: "inbox" },
];

/** Bildirim kutusu sekmeleri. */
const tabs: readonly { readonly kind: string; readonly label: string; readonly icon: IconName }[] = [
  { kind: "feedback", label: text.tabs.feedback, icon: "message" },
  { kind: "crash", label: text.tabs.crash, icon: "sparkle" },
  { kind: "contact", label: text.tabs.contact, icon: "mail" },
];

/** Kullanıcı listesi kesimleri (değer sunucunun `segment` parametresidir; boş = tümü). */
const segments: readonly { readonly value: string; readonly label: string }[] = [
  { value: "", label: text.users.segments.all },
  { value: "subscribed", label: text.users.segments.subscribed },
  { value: "past_due", label: text.users.segments.pastDue },
  { value: "canceled", label: text.users.segments.canceled },
  { value: "trial", label: text.users.segments.trial },
  { value: "free", label: text.users.segments.free },
];

const providerOptions: readonly { readonly value: string; readonly label: string }[] = [
  { value: "", label: text.users.providers.all },
  { value: "apple", label: text.users.providers.apple },
  { value: "google", label: text.users.providers.google },
];

const userColumns: readonly string[] = [
  text.users.columns.user,
  text.users.columns.provider,
  text.users.columns.created,
  text.users.columns.plan,
  text.users.columns.trial,
  text.users.columns.subscription,
  text.users.columns.meetings,
  text.users.columns.hours,
  text.users.columns.lastActive,
];

const meetingColumns: readonly string[] = [
  text.users.meetingColumns.started,
  text.users.meetingColumns.kind,
  text.users.meetingColumns.state,
  text.users.meetingColumns.duration,
  text.users.meetingColumns.audio,
  text.users.meetingColumns.tokens,
  text.users.meetingColumns.notes,
];

const openColumns: readonly string[] = [
  text.operations.openColumns.user,
  text.operations.openColumns.kind,
  text.operations.openColumns.started,
  text.operations.openColumns.endsBy,
  text.operations.openColumns.notes,
];

/** Kullanıcı ayrıntısının ölçerleri (betik `user-meter-<id>` ve `user-meter-<id>-text` doldurur). */
const userMeters: readonly { readonly id: string; readonly label: string }[] = [
  { id: "hours", label: text.users.usage.hours },
  { id: "tokens", label: text.users.usage.tokens },
  { id: "account", label: text.users.usage.accountTokens },
];

/** Kullanıcı ayrıntısının alanları (betik `user-field-<id>` doldurur). */
const userFields: readonly { readonly id: string; readonly label: string; readonly mono: boolean }[] = [
  { id: "provider", label: text.users.fields.provider, mono: false },
  { id: "created", label: text.users.fields.created, mono: false },
  { id: "last-active", label: text.users.fields.lastActive, mono: false },
  { id: "subscription", label: text.users.fields.subscription, mono: false },
  { id: "trial", label: text.users.fields.trial, mono: false },
  { id: "trial-device", label: text.users.fields.trialDevice, mono: false },
  { id: "stripe", label: text.users.fields.stripeCustomer, mono: true },
];
---

<Base page="admin" meta={text.meta} indexed={false}>
  <div id="admin-not-found" hidden data-title={copy.notFound.meta.title}>
    <NotFound />
  </div>

  <section class="page admin" id="admin" data-title={text.documentTitle}>
    <p id="admin-loading" class="muted admin__loading" role="status">{text.loading}</p>
    <p id="admin-error" class="notice notice--error hidden" role="alert"></p>
    <div id="admin-mount" class="admin__mount"></div>
  </section>

  {/* Panel: yönetici erişimi doğrulanınca `#admin-mount` içine kopyalanır (admin.ts). */}
  <template id="admin-template">
    <div class="admin__head">
      <div>
        <h1 class="title-l">{text.title}</h1>
        <p id="admin-updated" class="small muted" aria-live="polite"></p>
      </div>
      <button id="admin-refresh" class="button button--secondary button--small" type="button">
        <Icon name="refresh" size={16} class="" />
        {text.refresh}
      </button>
    </div>

    <div class="segmented admin__views" role="group" aria-label={text.views.label}>
      {
        views.map((view, index: number) => (
          <button id={`view-${view.id}`} class="segmented__button" type="button" aria-pressed={index === 0 ? "true" : "false"} aria-controls={`panel-${view.id}`}>
            <Icon name={view.icon} size={16} class="" />
            {view.label}
            {view.id === "inbox" ? <span id="count-inbox" class="segmented__count tabular" /> : null}
          </button>
        ))
      }
    </div>

    {/* ---------- Genel bakış ---------- */}
    <div id="panel-overview" class="admin__panel">
      <div class="kpi-groups">
        {
          groups.map((group: KpiGroup) => (
            <section class:list={["kpi-group", `kpi-group--${group.id}`]} aria-labelledby={`group-${group.id}`}>
              <h2 class="eyebrow kpi-group__title" id={`group-${group.id}`}>
                {group.title}
              </h2>
              <div class="kpi-group__grid">
                {group.kpis.map((kpi: KpiSpec) => (
                  <div class:list={["card", "kpi", { "kpi--meter": kpi.meter, "kpi--accent": kpi.id === "mrr" }]} id={`kpi-${kpi.id}-card`}>
                    <p class="kpi__label">
                      <Icon name={kpi.icon} size={16} class="kpi__icon" />
                      {kpi.label}
                    </p>
                    <p id={`kpi-${kpi.id}`} class="kpi__value tabular" />
                    {kpi.meter ? <progress id={`kpi-${kpi.id}-meter`} class="meter kpi__meter" aria-label={kpi.label} max="1" value="0" /> : null}
                    <p id={`kpi-${kpi.id}-sub`} class="kpi__sub small" />
                  </div>
                ))}
              </div>
            </section>
          ))
        }
      </div>

      <section aria-labelledby="charts-title">
        <h2 class="title-m section-title" id="charts-title">{text.chartsTitle}</h2>
        <div class="charts">
          {
            charts.map((chart) => (
              <figure class="card chart">
                <div class="chart__head">
                  <h3 class="chart__title">{chart.title}</h3>
                  {chart.legend ? (
                    <p class="chart__legend small muted" aria-hidden="true">
                      <span class="legend legend--main">{text.legendSubscription}</span>
                      <span class="legend legend--accent">{text.legendTrial}</span>
                    </p>
                  ) : null}
                </div>
                <div id={`chart-${chart.id}`} class="chart__plot" />
                <figcaption id={`chart-${chart.id}-summary`} class="small muted" />
              </figure>
            ))
          }
        </div>
      </section>
    </div>

    {/* ---------- Kullanıcılar ---------- */}
    <div id="panel-users" class="admin__panel hidden">
      <section id="users-list-view" class="users" aria-labelledby="users-title">
        <h2 class="visually-hidden" id="users-title">{text.users.title}</h2>
        <form id="users-form" class="users__toolbar" role="search">
          <div class="field users__search">
            <label for="users-query">{text.users.searchLabel}</label>
            <input
              id="users-query"
              class="input input--small mono"
              type="search"
              placeholder={text.users.searchPlaceholder}
              autocomplete="off"
              spellcheck="false"
              maxlength="36"
            />
          </div>
          <div class="field">
            <label for="users-segment">{text.users.segmentLabel}</label>
            <select id="users-segment" class="input input--small select">
              {segments.map((segment) => <option value={segment.value}>{segment.label}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="users-provider">{text.users.providerLabel}</label>
            <select id="users-provider" class="input input--small select">
              {providerOptions.map((provider) => <option value={provider.value}>{provider.label}</option>)}
            </select>
          </div>
          <button class="button button--primary button--small users__submit" type="submit">
            <Icon name="search" size={16} class="" />
            {text.users.search}
          </button>
        </form>

        <div class="card table-card">
          <div class="table-scroll" tabindex="0" role="region" aria-labelledby="users-title">
            <table class="data-table">
              <thead>
                <tr>{userColumns.map((column: string) => <th scope="col">{column}</th>)}</tr>
              </thead>
              <tbody id="users-rows"></tbody>
            </table>
          </div>
          <p id="users-empty" class="muted table-empty hidden">{text.users.empty}</p>
          <div class="table-foot">
            <span id="users-shown" class="small muted tabular"></span>
            <button id="users-more" class="button button--secondary button--small hidden" type="button">{text.users.loadMore}</button>
          </div>
        </div>
      </section>

      <section id="user-detail-view" class="user-detail hidden" aria-labelledby="user-title">
        <div class="user-detail__head">
          <button id="user-back" class="button button--secondary button--small" type="button">{text.users.back}</button>
          <h2 id="user-title" class="title-m user-detail__title"></h2>
          <div id="user-pills" class="pill-row"></div>
        </div>

        <div class="user-detail__grid">
          <div class="card user-card">
            <dl class="detail__fields">
              {
                userFields.map((field) => (
                  <div>
                    <dt>{field.label}</dt>
                    <dd id={`user-field-${field.id}`} class:list={{ mono: field.mono }} />
                  </div>
                ))
              }
            </dl>
          </div>
          <div class="card user-card">
            <h3 class="detail__label">{text.users.usageTitle}</h3>
            <div class="usage-meters">
              {
                userMeters.map((meter) => (
                  <div class="usage-meter">
                    <p class="usage-meter__label">
                      <span>{meter.label}</span>
                      <span id={`user-meter-${meter.id}-text`} class="tabular muted" />
                    </p>
                    <progress id={`user-meter-${meter.id}`} class="meter" aria-label={meter.label} max="1" value="0" />
                  </div>
                ))
              }
              <p class="usage-meter__label">
                <span>{text.users.usage.audio}</span>
                <span id="user-audio" class="tabular muted"></span>
              </p>
            </div>
          </div>
        </div>

        <div class="card table-card">
          <h3 class="detail__label table-card__title">{text.users.meetingsTitle}</h3>
          <div class="table-scroll" tabindex="0" role="region" aria-label={text.users.meetingsTitle}>
            <table class="data-table">
              <thead>
                <tr>{meetingColumns.map((column: string) => <th scope="col">{column}</th>)}</tr>
              </thead>
              <tbody id="user-meetings"></tbody>
            </table>
          </div>
          <p id="user-meetings-empty" class="muted table-empty hidden">{text.users.noMeetings}</p>
        </div>

        <div class="user-detail__grid">
          <div class="card user-card">
            <h3 class="detail__label">{text.users.timelineTitle}</h3>
            <ol id="user-timeline" class="timeline"></ol>
            <p class="small muted">{text.users.timelineNote}</p>
          </div>
          <div class="card user-card">
            <h3 class="detail__label">{text.users.reportsTitle}</h3>
            <ul id="user-reports" class="link-list"></ul>
            <p id="user-reports-empty" class="muted hidden">{text.users.noReports}</p>
          </div>
        </div>
      </section>
    </div>

    {/* ---------- İşletim ---------- */}
    <div id="panel-operations" class="admin__panel hidden">
      <div class="kpi-group__grid ops-kpis">
        {
          opsKpis.map((kpi: KpiSpec) => (
            <div class="card kpi" id={`kpi-${kpi.id}-card`}>
              <p class="kpi__label">
                <Icon name={kpi.icon} size={16} class="kpi__icon" />
                {kpi.label}
              </p>
              <p id={`kpi-${kpi.id}`} class="kpi__value tabular" />
              <p id={`kpi-${kpi.id}-sub`} class="kpi__sub small" />
            </div>
          ))
        }
      </div>

      <div class="ops-grid">
        <section class="card table-card ops-grid__wide" aria-labelledby="ops-open-title">
          <h3 class="detail__label table-card__title" id="ops-open-title">{text.operations.openTitle}</h3>
          <div class="table-scroll" tabindex="0" role="region" aria-labelledby="ops-open-title">
            <table class="data-table">
              <thead>
                <tr>{openColumns.map((column: string) => <th scope="col">{column}</th>)}</tr>
              </thead>
              <tbody id="ops-open-rows"></tbody>
            </table>
          </div>
          <p id="ops-open-empty" class="muted table-empty hidden">{text.operations.noOpen}</p>
        </section>

        <section class="card table-card" aria-labelledby="ops-stripe-title">
          <h3 class="detail__label table-card__title" id="ops-stripe-title">{text.operations.stripeTitle}</h3>
          <div class="table-scroll" tabindex="0" role="region" aria-labelledby="ops-stripe-title">
            <table class="data-table">
              <thead>
                <tr>
                  <th scope="col">{text.operations.stripeColumns.type}</th>
                  <th scope="col" class="numeric">{text.operations.stripeColumns.count}</th>
                </tr>
              </thead>
              <tbody id="ops-stripe-rows"></tbody>
            </table>
          </div>
          <p id="ops-stripe-empty" class="muted table-empty hidden">{text.operations.noStripe}</p>
        </section>

        <section class="card user-card" aria-labelledby="ops-crashes-title">
          <h3 class="detail__label" id="ops-crashes-title">{text.operations.crashesTitle}</h3>
          <ul id="ops-crashes" class="link-list"></ul>
          <p id="ops-crashes-empty" class="muted hidden">{text.operations.noCrashes}</p>
        </section>
      </div>
    </div>

    {/* ---------- Bildirim kutusu ---------- */}
    <div id="panel-inbox" class="admin__panel hidden">
      <section class="inbox" aria-labelledby="inbox-title">
        <div class="inbox__toolbar">
          <h2 class="title-m" id="inbox-title">{text.inboxTitle}</h2>
          <div class="segmented" role="group" aria-label={text.inboxTitle}>
            {
              tabs.map((tab, index: number) => (
                <button id={`tab-${tab.kind}`} class="segmented__button" type="button" aria-pressed={index === 0 ? "true" : "false"}>
                  <Icon name={tab.icon} size={16} class="" />
                  {tab.label}
                  <span id={`count-${tab.kind}`} class="segmented__count tabular" />
                </button>
              ))
            }
          </div>
          <div class="segmented segmented--quiet" role="group" aria-label={`${text.statusOpen} / ${text.statusDone}`}>
            <button id="status-open" class="segmented__button" type="button" aria-pressed="true">{text.statusOpen}</button>
            <button id="status-done" class="segmented__button" type="button" aria-pressed="false">{text.statusDone}</button>
          </div>
        </div>

        <div class="inbox__body">
          <div class="card inbox__list-card">
            <ul id="inbox-list" class="inbox__list"></ul>
            <p id="inbox-empty" class="muted inbox__empty hidden">{text.empty}</p>
            <button id="inbox-more" class="button button--secondary button--small hidden" type="button">{text.loadMore}</button>
          </div>

          <div id="inbox-detail" class="card inbox__detail">
            <p id="detail-empty" class="muted inbox__empty">{text.detailEmpty}</p>
            <div id="detail-body" class="detail hidden">
              <div class="detail__head">
                <span id="detail-status" class="pill"></span>
                <button
                  id="detail-toggle"
                  class="button button--secondary button--small"
                  type="button"
                  data-label-done={text.markDone}
                  data-label-reopen={text.reopen}>{text.markDone}</button
                >
              </div>
              <dl class="detail__fields">
                <div><dt>{text.fields.received}</dt><dd id="detail-received"></dd></div>
                <div><dt>{text.fields.email}</dt><dd id="detail-email"></dd></div>
                <div><dt>{text.fields.user}</dt><dd id="detail-user" class="mono"></dd></div>
                <div><dt>{text.fields.app}</dt><dd id="detail-app"></dd></div>
                <div><dt>{text.fields.os}</dt><dd id="detail-os"></dd></div>
              </dl>
              <h3 class="detail__label">{text.messageTitle}</h3>
              <p id="detail-message" class="detail__message"></p>
              <div id="detail-payload-block" class="hidden">
                <h3 class="detail__label">{text.payloadTitle}</h3>
                <pre id="detail-payload" class="detail__payload" tabindex="0"></pre>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </template>
</Base>

<script>
  import "../client/admin";
</script>

<style>
  .admin {
    display: grid;
    gap: 20px;
    padding-top: clamp(28px, 5vw, 56px);
  }

  .admin__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }

  /* Görünüm seçici: başlığın altında, sola yaslı; görünümler kendi aralıklarıyla akar. */
  .admin__views {
    justify-self: start;
  }

  .admin__panel {
    display: grid;
    gap: clamp(32px, 4vw, 48px);
    min-width: 0;
  }

  /* Panel eklenince yükleme satırı gizlenir; panel kendi aralıklarıyla akar. */
  .admin__mount {
    display: grid;
    gap: 20px;
  }

  .admin__mount:empty {
    display: none;
  }

  .admin__loading {
    min-height: 40vh;
  }

  .section-title {
    margin-bottom: 16px;
  }

  /* ---------- Özet kutuları ---------- */

  /* Gruplar alt alta, tam genişlikte; her grup dörtlü ızgara (dar ekranda ikişerli, telefonda tek). */
  .kpi-groups {
    display: grid;
    gap: 28px;
  }

  .kpi-group {
    display: grid;
    gap: 12px;
    min-width: 0;
  }

  .kpi-group__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 16px;
  }

  /* İşletim kutuları üçlü (altı kutu, iki satır). */
