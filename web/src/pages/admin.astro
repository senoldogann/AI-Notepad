                    { id: "ops-open", label: text.operations.kpis.open, hint: clientCopy.admin.opsOpenHint, meter: false, spark: false },
                    { id: "ops-unended", label: text.operations.kpis.unended, hint: clientCopy.admin.opsUnendedHint, meter: false, spark: false },
                    { id: "ops-reservations", label: text.operations.kpis.reservations, hint: null, meter: false, spark: false },
                  ]}
