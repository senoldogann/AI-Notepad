    gap: 16px;
    align-items: start;
  }

  .inbox__list-card,
  .inbox__detail {
    display: grid;
    gap: 12px;
    padding: 12px;
  }

  .inbox__detail {
    padding: 20px 22px;
  }

  .inbox__list {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .inbox__list :global(.inbox__item) {
    display: grid;
    gap: 2px;
    width: 100%;
    padding: 10px 12px;
    border: 0;
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .inbox__list :global(.inbox__item:hover) {
    background: var(--soft);
  }

  .inbox__list :global(.inbox__item[aria-current="true"]) {
    background: var(--selected);
  }

  .inbox__list :global(.inbox__summary) {
    font-size: 0.9375rem;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .inbox__list :global(.inbox__meta) {
    font-size: 0.8125rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .inbox__empty {
    padding: 12px;
  }

  #inbox-more {
    justify-self: center;
  }

  .detail {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .detail__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .detail__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 16px;
    margin: 0;
  }

  .detail__fields dt {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
  }

  .detail__fields dd {
    margin: 0;
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }

  .mono {
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  .detail__label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0;
  }

  .detail__message {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .detail__payload {
    max-height: 420px;
    margin: 8px 0 0;
    padding: 14px 16px;
    overflow: auto;
    border-radius: var(--radius-s);
    border: 1px solid var(--line);
    background: var(--soft);
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    white-space: pre;
  }

  /* ---------- Tablolar (kullanıcılar, toplantılar, işletim) ---------- */

  .table-card {
    display: grid;
    gap: 8px;
    padding: 8px;
    min-width: 0;
  }

  .table-card__title {
    padding: 12px 14px 0;
  }

  /* Geniş tablo kartın içinde yatay kayar; sayfa yana taşmaz. */
  .table-scroll {
    overflow-x: auto;
    border-radius: var(--radius-s);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .data-table th {
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
    text-align: left;
    white-space: nowrap;
  }

  .data-table .numeric,
  .data-table :global(td.numeric) {
    text-align: right;
  }

  .data-table :global(td) {
    padding: 10px 14px;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent);
    white-space: nowrap;
    vertical-align: middle;
  }

  .data-table :global(tr:last-child td) {
    border-bottom: 0;
  }

  .data-table :global(tr.is-clickable) {
    cursor: pointer;
  }

  .data-table :global(tr.is-clickable:hover td) {
    background: var(--soft);
  }

  /* Hesap kimliği düğmesi: satırın klavyeyle açılan bağlantısı. */
  .data-table :global(.id-button) {
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-family: var(--mono);
    font-size: 0.8125rem;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.25em;
    cursor: pointer;
  }

  .data-table :global(.id-button:hover) {
    text-decoration-color: currentColor;
  }

  .table-empty {
    padding: 16px 14px;
  }

  .table-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 4px 14px 8px;
  }

  /* Küçük rozetler (tablo hücrelerinde). */
  .admin__panel :global(.pill--compact) {
    padding: 2px 8px;
    font-size: 0.75rem;
  }

  .admin__panel :global(.pill-row),
  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* Betiğin oluşturduğu öğelerde de eş aralıklı yazı (Stripe olay türü). */
  .admin__panel :global(.mono) {
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  /* ---------- Kullanıcılar ---------- */

  .users,
  .user-detail {
    display: grid;
    gap: 16px;
    min-width: 0;
  }

  .users__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 12px;
  }

  .users__toolbar .field {
    gap: 6px;
  }

  .users__toolbar label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
  }

  .users__search {
    flex: 1 1 260px;
  }

  .input--small {
    min-height: 40px;
    padding: 0 12px;
    font-size: 0.9375rem;
  }

  .select {
    padding-right: 32px;
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%);
    background-position:
      calc(100% - 17px) 50%,
      calc(100% - 12px) 50%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
    cursor: pointer;
  }

  .users__submit {
    min-height: 40px;
  }

  .user-detail__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }

  .user-detail__title {
    font-family: var(--mono);
    font-size: 1.0625rem;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }

  /* Hesaba yönelik işlem (ücretsiz erişim) başlık satırının sağında. */
  .user-detail__action {
    margin-left: auto;
  }

  .user-detail__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    align-items: start;
  }

  .user-card {
    display: grid;
    gap: 14px;
    padding: 20px 22px;
    min-width: 0;
  }

  .usage-meters {
    display: grid;
    gap: 14px;
  }

  .usage-meter {
    display: grid;
    gap: 6px;
  }

  .usage-meter__label {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.875rem;
  }

  /* Zaman çizelgesi: solda ince çizgi ve noktalar. */
  .timeline {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0 0 0 18px;
    list-style: none;
    border-left: 1px solid var(--line);
  }

  .timeline :global(li) {
    position: relative;
    display: grid;
    gap: 2px;
    font-size: 0.875rem;
  }

  .timeline :global(li::before) {
    content: "";
    position: absolute;
    left: -22px;
    top: 7px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .timeline :global(.timeline__time) {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* Rapor ve çökme listeleri: tıklanınca bildirim kutusunda açılır. */
  .link-list {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link-list :global(.link-list__item) {
    display: grid;
    gap: 2px;
    width: 100%;
    padding: 8px 10px;
    border: 0;
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .link-list :global(.link-list__item:hover) {
    background: var(--soft);
  }

  .link-list :global(.link-list__title) {
    font-size: 0.9375rem;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .link-list :global(.link-list__meta) {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* ---------- İşletim ---------- */

  .ops-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    align-items: start;
  }

  .ops-grid__wide {
    grid-column: 1 / -1;
  }

  /* ---------- Ürün ---------- */

  /* Bölüm içinde kutular, grafikler ve tablolar arasında başlık aralığından biraz geniş aralık. */
  .product-section {
    gap: 16px;
  }

  /* ---------- İçgörüler ---------- */

  .insights-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    align-items: start;
  }

  .table-note {
    padding: 0 14px 10px;
    line-height: 1.5;
  }

  .table-note:empty {
    display: none;
  }

  /* Uyarı satırı (bugünlerde tavana takılan istek var): ilk hücre uyarı renginde. */
  .data-table :global(tr.is-warn td:first-child) {
    color: var(--warn);
    font-weight: 600;
  }

  /* Huni adımı: adı ve altında en büyük adıma göre ince çubuk. */
  .data-table :global(.funnel__step) {
    display: grid;
    gap: 6px;
    min-width: 150px;
  }

  .data-table :global(.funnel__bar) {
    width: 100%;
    height: 4px;
  }

  /* Hücredeki rozetler en az iki rozet genişliğinde sarar: dar sütun onları tek tek alt alta dizip satırı uzatmaz. */
  .data-table :global(td .pill-row) {
    min-width: 15rem;
  }

  /* Hata kodu: eş aralıklı, en çok 26 karakterde sarar (sıkışan tablo onu harf harf bölmez); toplantı satırında uyarı
     renginde. */
  .data-table :global(.failure-code) {
    display: inline-block;
    width: max-content;
    max-width: 26ch;
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--muted);
    white-space: normal;
    overflow-wrap: anywhere;
  }

  /* İçgörü tablolarında ilk sütun (sorun, adım, düğme, site) sarar: telefonda sayılar görünür alanda kalır. */
  .insights-grid .data-table :global(td:first-child) {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .insights-grid .data-table :global(td:first-child .mono) {
    font-size: 0.75rem;
  }

  .data-table :global(.failure-code--warn) {
    color: var(--warn);
  }

  /* Yorum gibi uzun başlıklar satıra sarar. */
  .link-list :global(.link-list__title--wrap) {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  /* ---------- Blog ---------- */

  .blog,
  .blog-editor {
    display: grid;
    gap: 16px;
    min-width: 0;
  }

  /* Bildirim görünür alana kaydırılınca yapışkan üst çubuğun altında kalmaz. */
  #blog-notice,
  #blog-editor-notice {
    scroll-margin-top: 112px;
  }

  .blog__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 16px;
  }

  .blog-cadence {
    flex: 1 1 320px;
    min-height: 0;
  }

  .blog-cadence__latest {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .blog__new {
    min-height: 40px;
  }

  .blog__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Sitede aç: satırda yalnızca simge, düzenleyicide simge ve metin. */
  :global(.blog-open) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 28px;
    min-height: 28px;
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
  }

  :global(.blog-open:hover) {
    background: var(--soft);
    color: var(--ink);
  }

  .blog-open--labelled {
    padding: 4px 10px;
    border: 1px solid var(--line);
    color: var(--ink);
  }

  .blog-table :global(.blog-row__meta) {
    display: flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
  }

  .blog-cover-picker {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Kapağın küçük önizlemesi: paylaşım görseliyle aynı oran. */
  .blog-cover-swatch {
    flex: 0 0 auto;
    width: 76px;
    aspect-ratio: 1200 / 630;
    border-radius: 8px;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06);
  }

  .blog-cover-picker .select {
    flex: 1 1 auto;
    min-width: 0;
  }

  .blog-editor__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .blog-image {
    display: grid;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    background: var(--soft);
  }

  .blog-image__grid {
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }

  .blog-image__preview {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px dashed var(--line);
    border-radius: var(--radius-s);
    background: var(--card);
    color: var(--muted);
  }

  .blog-image__preview :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .blog-image__preview:has(img) :global(.blog-image__placeholder) {
    display: none;
  }

  .blog-image__fields {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .blog-image__fields .field {
    gap: 6px;
  }

  .blog-image__fields label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
  }

  .blog-image__label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
  }

  .blog-image__picker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    min-width: 0;
  }

  .blog-image__fields label.blog-image__choose {
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }

  /* Klavyeyle gizli dosya alanına gelince görünen düğme odak halkası alır. */
  .blog-image__picker input:focus-visible + .blog-image__choose {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .blog-image__file-name {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* Bölüm görünür alana kaydırılınca yapışkan üst çubuğun altında kalmaz. */
  #blog-image {
    scroll-margin-top: 112px;
  }

  .blog-image__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 560px) {
    .blog-image__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Başlık sütunu satıra sarar (uzun başlık tabloyu genişletmesin). */
  .blog-table :global(td:first-child) {
    min-width: 16rem;
    white-space: normal;
  }

  .blog-table :global(.blog-row) {
    display: grid;
    gap: 2px;
  }

  .blog-table :global(.blog-row__title) {
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-weight: 500;
    text-align: left;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.25em;
    cursor: pointer;
  }

  .blog-table :global(.blog-row__title:hover) {
    text-decoration-color: currentColor;
  }

  .blog-table :global(.blog-row__slug) {
    color: var(--muted);
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }

  .blog-editor__title {
    font-size: 1.125rem;
  }

  .blog-share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
  }

  .blog-editor__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 16px;
    align-items: start;
  }

  .blog-editor__meta,
  .blog-editor__body {
    display: grid;
    gap: 18px;
    padding: 20px 22px;
    min-width: 0;
  }

  .blog-editor__body {
    gap: 14px;
  }

  .blog-editor__meta .field {
    gap: 6px;
  }

  .blog-editor__meta label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
  }

  .blog-field__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .blog-counter--warn {
    color: var(--warn);
  }

  .blog-hint {
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .blog-textarea {
    min-height: 92px;
    padding-block: 10px;
    resize: vertical;
    line-height: 1.5;
    font-size: 0.9375rem;
  }

  .blog-editor__meta .blog-toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
  }

  .blog-toggle input {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--primary);
  }

  .blog-body {
    min-height: 520px;
    padding-block: 12px;
    resize: vertical;
    font-family: var(--mono);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  /* Izgara öğesi içeriğine göre genişlemez: tablo ve kod bloğu kendi kutularında yatay kayar. */
  /* Önizleme kendi içinde kayar: uzun yazı sayfayı aşağı uzatmaz (yükseklik yazma alanıyla aynı ölçekte). */
  .blog-preview {
    min-width: 0;
    min-height: 520px;
    max-height: min(720px, 72vh);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 4px 10px 4px 2px;
    overflow-wrap: anywhere;
  }

  /* Sitedeki yazı kapağının küçük hali (components/BlogCover.astro): gradyan ve başlık, ölçüler kapak genişliğine göre. */
  .blog-preview :global(.blog-preview__cover) {
    container-type: inline-size;
    display: flex;
    align-items: flex-start;
    aspect-ratio: 1200 / 630;
    margin-bottom: 18px;
    padding: 6.4cqi 7cqi;
    border-radius: 18px;
  }

  .blog-preview :global(.blog-preview__cover-title) {
    max-width: 88%;
    margin: 0;
    color: #0a0a0a;
    font-size: 6.6cqi;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .blog-preview :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 8px auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
  }

  .blog-preview :global(pre) {
    overflow-x: auto;
    padding: 12px 14px;
    border-radius: var(--radius-s);
    background: var(--soft);
    font-size: 0.8125rem;
  }

  .blog-editor__actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .blog-editor__delete {
    margin-left: auto;
  }

  .blog-confirm {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    flex: 1 1 100%;
    padding: 12px 16px;
    border: 1px solid color-mix(in srgb, var(--danger) 35%, var(--line));
    border-radius: var(--radius-s);
    background: color-mix(in srgb, var(--danger) 6%, var(--card));
  }

  .blog-confirm p {
    flex: 1 1 260px;
    font-size: 0.9375rem;
  }

  @media (max-width: 1040px) {
    .kpi-group__grid,
    .ops-kpis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Dar ekranda menü üstte, yatay kayan bir şerit olur. */
  @media (max-width: 860px) {
    .console {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
    }

    .console__sidebar {
      flex-direction: row;
      align-items: center;
      gap: 12px;
      padding: 10px 12px;
      overflow-x: auto;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .console__nav {
      display: flex;
    }

    .console__nav-item {
