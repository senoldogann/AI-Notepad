---
// Yönetim paneli (menüde ve site haritasında yok, arama motorlarına kapalı, önbelleğe alınmaz). Tam ekran bir yönetim
// kabuğu: solda gruplu menü (genel bakış; Analytics: gelir, büyüme, kullanım, güvenilirlik, maliyet; Manage:
// kullanıcılar, bildirim kutusu, işletim, blog), üstte görünümün adı, açıklaması ve yenileme. Her analiz görünümü aynı
// düzeni izler: üstte en çok dört ölçülük özet şeridi, altında grafikler ve döküm kartları, sonra başlıklı bölümlerde
// tablolar (12 sütunlu ızgara; bileşenler src/components/admin). Değerler tarayıcıda `/v1/admin/*` uçlarından
// doldurulur (src/client/admin*.ts); bir görünüm açılınca yalnızca onun veri kaynakları yüklenir. Panelin varlığı belli
// olmaz: sayfa başlığı nötrdür, panel `<template>` içinde durur ve yalnızca sunucu yönetici erişimini doğrulayınca
// (`/v1/admin/stats` başarılı) sayfaya eklenir; o zamana dek nötr bir yükleme satırı, erişim yoksa standart "sayfa
// bulunamadı" görünümü.
import Base from "../layouts/Base.astro";
// Sitenin genel stillerinden sonra yüklenir: eşit özgüllükte panelin kuralı geçerlidir.
import "../styles/admin.css";
import { websiteCard } from "../lib/social";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import NotFound from "../components/NotFound.astro";
import ChartPanel from "../components/admin/ChartPanel.astro";
import FactsPanel from "../components/admin/FactsPanel.astro";
import ListPanel from "../components/admin/ListPanel.astro";
import Section from "../components/admin/Section.astro";
import Stats from "../components/admin/Stats.astro";
import TablePanel from "../components/admin/TablePanel.astro";
import { productName } from "../config";
import { type AdminCopy, copy } from "../copy";
import { type FilmPalette, filmPalettes } from "../lib/film";
import type { IconName } from "../lib/icons";
import { type Column, numberColumn, textColumn } from "../lib/admin-table";
import { routes } from "../routes";
import { clientCopy } from "../client/copy";
import { type AdminInviteCopy, adminInviteCopy } from "../client/admin-invites-copy";
import { type AdminBlogCopy, adminBlogCopy } from "../client/admin-blog-copy";
import { type AdminLayoutCopy, type AdminView, type NavGroup, adminLayoutCopy, navGroups } from "../client/admin-layout-copy";
import { type AdminProductCopy, adminProductCopy } from "../client/admin-product-copy";
import { type AdminTrendsCopy, type TrendTableId, adminTrendsCopy } from "../client/admin-trends-copy";
import { type AdminTelemetryCopy, adminTelemetryCopy, countEventKinds, durationEventKinds } from "../client/admin-telemetry-copy";

const text: AdminCopy = copy.admin;
const layout: AdminLayoutCopy = adminLayoutCopy;
const inviteText: AdminInviteCopy = adminInviteCopy;
const blogText: AdminBlogCopy = adminBlogCopy;
const productText: AdminProductCopy = adminProductCopy;
const trendsText: AdminTrendsCopy = adminTrendsCopy;
const telemetryText: AdminTelemetryCopy = adminTelemetryCopy;
const productColumns: AdminProductCopy["columns"] = productText.columns;

/** Menüdeki simgeler. */
const viewIcons: Readonly<Record<AdminView, IconName>> = {
  overview: "grid",
  revenue: "wallet",
  growth: "trending",
  engagement: "activity",
  reliability: "shield",
  costs: "chip",
  users: "users",
  inbox: "inbox",
  operations: "laptop",
  blog: "note",
};

/** Eğilimler tablosunun sütunları (admin-trends-copy.ts). Saf fonksiyondur. */
function trendColumns(table: TrendTableId): readonly Column[] {
  return trendsText.tables[table].columns;
}

/** Ürün tablolarının başlığı ve sabit notu. */
const product = productText.tables;

/** Kohort tablosunun hafta sütunları (kayıttan sonraki 0.–4. hafta; sunucu `cohortWeekColumns`). */
const cohortWeeks: readonly number[] = [0, 1, 2, 3, 4];

/** Kesim seçeneği (değer sunucunun `segment` parametresidir; boş = tümü). */
interface SegmentOption {
  readonly value: string;
  readonly label: string;
}

const planSegments: readonly SegmentOption[] = [
  { value: "subscribed", label: text.users.segments.subscribed },
  { value: "past_due", label: text.users.segments.pastDue },
  { value: "canceled", label: text.users.segments.canceled },
  { value: "trial", label: text.users.segments.trial },
  { value: "free", label: text.users.segments.free },
  { value: "invited", label: inviteText.segment },
];

const dropOffSegments: readonly SegmentOption[] = [
  { value: "no_meeting", label: text.users.segments.noMeeting },
  { value: "trial_ended", label: text.users.segments.trialEnded },
  { value: "inactive", label: text.users.segments.inactive },
  { value: "failed", label: text.users.segments.failed },
];

const providerOptions: readonly SegmentOption[] = [
  { value: "", label: text.users.providers.all },
  { value: "apple", label: text.users.providers.apple },
  { value: "google", label: text.users.providers.google },
];

const userColumns: readonly Column[] = [
  textColumn(text.users.columns.user),
  textColumn(text.users.columns.provider),
  textColumn(text.users.columns.created),
  textColumn(text.users.columns.plan),
  textColumn(text.users.columns.trial),
  textColumn(text.users.columns.subscription),
  numberColumn(text.users.columns.meetings),
  numberColumn(text.users.columns.hours),
  textColumn(text.users.columns.lastActive),
  textColumn(text.users.columns.problems),
];

const meetingColumns: readonly Column[] = [
  textColumn(text.users.meetingColumns.started),
  textColumn(text.users.meetingColumns.kind),
  textColumn(text.users.meetingColumns.state),
  numberColumn(text.users.meetingColumns.duration),
  numberColumn(text.users.meetingColumns.audio),
  numberColumn(text.users.meetingColumns.tokens),
  textColumn(text.users.meetingColumns.problem),
  textColumn(text.users.meetingColumns.notes),
];

const inviteFriendColumns: readonly Column[] = [
  textColumn(inviteText.friendColumns.friend),
  textColumn(inviteText.friendColumns.status),
  textColumn(inviteText.friendColumns.joined),
  textColumn(inviteText.friendColumns.firstPayment),
  textColumn(inviteText.friendColumns.reward),
];

const blogColumns: readonly Column[] = [
  textColumn(blogText.columns.title),
  textColumn(blogText.columns.status),
  textColumn(blogText.columns.date),
  textColumn(blogText.columns.author),
];

/** Kullanıcı ayrıntısının ölçerleri (betik `user-meter-<id>` ve `user-meter-<id>-text` doldurur). */
const userMeters: readonly { readonly id: string; readonly label: string }[] = [
  { id: "hours", label: text.users.usage.hours },
  { id: "tokens", label: text.users.usage.tokens },
  { id: "account", label: text.users.usage.accountTokens },
];

/** Ayrıntı alanı: kimlik (betik `<önek><id>` doldurur), etiket ve eş aralıklı mı. */
interface DetailField {
  readonly id: string;
  readonly label: string;
  readonly mono: boolean;
}

const userFields: readonly DetailField[] = [
  { id: "provider", label: text.users.fields.provider, mono: false },
  { id: "created", label: text.users.fields.created, mono: false },
  { id: "last-active", label: text.users.fields.lastActive, mono: false },
  { id: "subscription", label: text.users.fields.subscription, mono: false },
  { id: "trial", label: text.users.fields.trial, mono: false },
  { id: "trial-device", label: text.users.fields.trialDevice, mono: false },
  { id: "stripe", label: text.users.fields.stripeCustomer, mono: true },
  { id: "cancellation", label: text.users.fields.cancellation, mono: false },
];

const invitedByFields: readonly DetailField[] = [
  { id: "referrer", label: inviteText.invitedByFields.referrer, mono: false },
  { id: "code", label: inviteText.invitedByFields.code, mono: true },
  { id: "status", label: inviteText.invitedByFields.status, mono: false },
  { id: "free-month", label: inviteText.invitedByFields.freeMonth, mono: false },
  { id: "card", label: inviteText.invitedByFields.card, mono: false },
  { id: "dates", label: inviteText.invitedByFields.dates, mono: false },
];

const invitesFields: readonly DetailField[] = [
  { id: "code", label: inviteText.invitesFields.code, mono: true },
  { id: "counts", label: inviteText.invitesFields.counts, mono: false },
  { id: "next", label: inviteText.invitesFields.nextReward, mono: false },
  { id: "left", label: inviteText.invitesFields.rewardsLeft, mono: false },
];

/** Bildirim kutusu sekmeleri. */
const tabs: readonly { readonly kind: string; readonly label: string; readonly icon: IconName }[] = [
  { kind: "feedback", label: text.tabs.feedback, icon: "message" },
  { kind: "crash", label: text.tabs.crash, icon: "sparkle" },
  { kind: "contact", label: text.tabs.contact, icon: "mail" },
];

const facts = layout.facts;
const stats = layout.stats;
const sections = layout.sections;
const legendPlans: { readonly main: string; readonly accent: string } = { main: layout.charts.subscription, accent: layout.charts.trial };
---

<Base page="admin" meta={text.meta} indexed={false} social={websiteCard}>
  <div id="admin-not-found" hidden data-title={copy.notFound.meta.title}>
    <NotFound />
  </div>

  <section class="page admin" id="admin" data-title={text.documentTitle}>
    <p id="admin-loading" class="muted admin__loading" role="status">{text.loading}</p>
    <p id="admin-error" class="notice notice--error hidden" role="alert"></p>
    <div id="admin-mount" class="admin__mount"></div>
  </section>

  {/* Panel: yönetici erişimi doğrulanınca `#admin-mount` içine kopyalanır (admin.ts). */}
  <template id="admin-template">
    <div class="console">
      <aside class="console__sidebar">
        <a class="console__brand" href={routes.home} aria-label={text.backToSite}>
          <Logo size={22} />
          <span class="console__brand-name">{productName}</span>
          <span class="console__badge">{text.title}</span>
        </a>
        <nav class="console__nav" aria-label={layout.navLabel}>
          {
            navGroups.map((group: NavGroup) => (
              <div class="console__group">
                {group.label === null ? null : <p class="console__group-label">{group.label}</p>}
                {group.views.map((view: AdminView) => (
                  <button
                    id={`view-${view}`}
                    class="console__nav-item"
                    type="button"
                    aria-pressed={view === "overview" ? "true" : "false"}
                    aria-controls={`panel-${view}`}
                    data-title={layout.views[view].label}
                    data-description={layout.views[view].description}>
                    <Icon name={viewIcons[view]} size={16} class="" />
                    <span class="console__nav-label">{layout.views[view].label}</span>
                    {view === "inbox" ? <span id="count-inbox" class="console__count tabular" /> : null}
                  </button>
                ))}
              </div>
            ))
          }
        </nav>
        <a class="console__site-link" href={routes.home}>
          <Icon name="arrow-right" size={14} class="console__site-icon" />
          {text.backToSite}
        </a>
      </aside>

      <div id="console-main" class="console__main">
        <header class="console__topbar">
          <div class="console__heading">
            <h1 id="admin-view-title" class="console__title">{layout.views.overview.label}</h1>
            <p id="admin-view-description" class="console__description">{layout.views.overview.description}</p>
          </div>
          <div class="console__tools">
            <p id="admin-updated" class="console__updated tabular" aria-live="polite"></p>
            <button id="admin-refresh" class="icon-button" type="button" aria-label={text.refresh} title={text.refresh}>
              <Icon name="refresh" size={16} class="" />
            </button>
          </div>
        </header>

        <div class="console__content">
          {/* ---------- Genel bakış ---------- */}
          <div id="panel-overview" class="admin__panel">
            <Section id="overview-top" title={null} description={null}>
              <div class="span-12">
                <Stats
                  label={layout.views.overview.label}
                  stats={[
                    { id: "ov-mrr", label: stats.mrr.label, hint: stats.mrr.hint, meter: false, spark: true },
                    { id: "ov-subscribers", label: stats.subscribers.label, hint: stats.subscribers.hint, meter: false, spark: true },
                    { id: "ov-users", label: stats.newUsers.label, hint: stats.newUsers.hint, meter: false, spark: true },
                    { id: "ov-meetings", label: stats.meetings30.label, hint: stats.meetings30.hint, meter: false, spark: true },
                  ]}
                />
              </div>
              <ChartPanel id="ov-meetings" title={layout.charts.meetings} hint={null} span={8} legend={legendPlans} size="large" />
              <div class="span-4 stack">
                <section class="panel panel--flush attention" aria-labelledby="ov-attention-title">
                  <header class="panel__head">
                    <h3 class="panel__title" id="ov-attention-title">{layout.attention.title}</h3>
                  </header>
                  <ul id="ov-attention" class="attention__list"></ul>
                  <p id="ov-attention-empty" class="table-empty hidden">{layout.attention.empty}</p>
                </section>
                <FactsPanel
                  id="ov-capacity"
                  title={facts.capacity.title}
                  hint={null}
                  span={4}
                  rows={[
                    { id: "spend", label: facts.capacity.spend },
                    { id: "elevenlabs", label: facts.capacity.elevenLabs },
                    { id: "deepgram", label: facts.capacity.deepgram },
                    { id: "near", label: facts.capacity.nearCap },
                  ]}
                />
              </div>
              <ChartPanel id="ov-users" title={layout.charts.newUsers} hint={null} span={6} legend={null} size="small" />
              <ChartPanel id="ov-downloads" title={layout.charts.downloads} hint={null} span={6} legend={null} size="small" />
            </Section>
          </div>

          {/* ---------- Gelir ---------- */}
          <div id="panel-revenue" class="admin__panel hidden">
            <Section id="revenue-top" title={null} description={null}>
              <div class="span-12">
                <Stats
                  label={layout.views.revenue.label}
                  stats={[
                    { id: "mrr", label: stats.mrr.label, hint: stats.mrr.hint, meter: false, spark: false },
                    { id: "subscribers", label: stats.subscribers.label, hint: stats.subscribers.hint, meter: false, spark: false },
                    { id: "conversion", label: stats.conversion.label, hint: stats.conversion.hint, meter: false, spark: false },
                    { id: "product-checkout", label: productText.kpis.checkout, hint: productText.kpiHints.checkout, meter: false, spark: false },
                    { id: "churn", label: stats.churn.label, hint: stats.churn.hint, meter: false, spark: false },
                  ]}
                />
              </div>
              <ChartPanel id="trend-mrr" title={trendsText.charts.mrr.title} hint={trendsText.chartsNote} span={8} legend={null} size="large" />
              <FactsPanel
                id="rev-subscriptions"
                title={facts.subscriptions.title}
                hint={null}
                span={4}
                rows={[
                  { id: "monthly", label: facts.subscriptions.monthly },
                  { id: "yearly", label: facts.subscriptions.yearly },
                  { id: "invite", label: facts.subscriptions.invite },
                  { id: "grace", label: facts.subscriptions.grace },
                  { id: "ending", label: facts.subscriptions.ending },
                  { id: "canceled", label: facts.subscriptions.canceled },
                  { id: "free", label: facts.subscriptions.free },
                ]}
              />
              <ChartPanel
                id="trend-subscribers"
                title={trendsText.charts.subscribers.title}
                hint={trendsText.chartsNote}
                span={6}
                legend={{ main: trendsText.charts.subscribers.main, accent: trendsText.charts.subscribers.accent ?? "" }}
                size="small"
              />
              <ChartPanel
                id="trend-revenue"
                title={trendsText.charts.revenue.title}
                hint={null}
                span={6}
                legend={{ main: trendsText.charts.revenue.main, accent: trendsText.charts.revenue.accent ?? "" }}
                size="small"
              />
            </Section>

            <Section id="revenue-currencies" title={sections.revenueTrends.title} description={sections.revenueTrends.description}>
              <TablePanel
                id="trend-revenue"
                title={trendsText.tables.revenue.title}
                hint={null}
                columns={trendColumns("revenue")}
                span={12}
                empty={trendsText.tables.revenue.empty}
                note={trendsText.tables.revenue.note === "" ? null : trendsText.tables.revenue.note}
                scroll={false}>
                <p slot="foot" id="trend-revenue-paid" class="panel__note"></p>
              </TablePanel>
            </Section>

            <Section id="revenue-billing" title={sections.billing.title} description={sections.billing.description}>
              <FactsPanel
                id="rev-billing"
                title={facts.billing.title}
                hint={null}
                span={4}
                rows={[
                  { id: "refunds", label: facts.billing.refunds },
                  { id: "disputes", label: facts.billing.disputes },
                  { id: "failed", label: facts.billing.failed },
                  { id: "duplicates", label: facts.billing.duplicates },
                  { id: "past-due", label: facts.billing.pastDue },
                  { id: "unpaid", label: facts.billing.unpaid },
                ]}
              />
              <TablePanel
                id="insights-feedback"
                title={text.insights.cancellationsTitle}
                hint={null}
                columns={[textColumn(text.insights.cancellationColumns.reason), numberColumn(text.insights.cancellationColumns.count)]}
                span={4}
                empty={text.insights.noCancellations}
                note={null}
                scroll={false}>
                <p slot="foot" id="insights-reasons" class="panel__note"></p>
              </TablePanel>
              <ListPanel id="insights-cancellations" title={text.insights.recentCancellationsTitle} span={4} empty={layout.empty.recentCancellations} />
            </Section>

            <Section id="revenue-conversion" title={sections.conversion.title} description={sections.conversion.description}>
              <TablePanel
                id="product-trials"
                title={product.trials}
                hint={null}
                columns={[textColumn(productColumns.outcome), numberColumn(productColumns.accounts), numberColumn(productColumns.share)]}
                span={5}
                empty={null}
                note={productText.notes.trials}
                scroll={false}
              />
              <TablePanel
                id="product-payers"
                title={product.payers}
                hint={null}
                columns={[
                  textColumn(productColumns.month),
                  numberColumn(productColumns.payers),
                  numberColumn(productColumns.costPerPayer),
                  numberColumn(productColumns.listRevenue),
                  numberColumn(productColumns.grossMargin),
                ]}
                span={7}
                empty={null}
                note=""
                scroll={false}
              />
            </Section>
          </div>

          {/* ---------- Büyüme ---------- */}
          <div id="panel-growth" class="admin__panel hidden">
            <Section id="growth-top" title={null} description={null}>
              <div class="span-12">
                <Stats
                  label={layout.views.growth.label}
                  stats={[
                    { id: "downloads", label: stats.downloads.label, hint: stats.downloads.hint, meter: false, spark: false },
                    { id: "users", label: stats.users.label, hint: stats.users.hint, meter: false, spark: false },
                    { id: "trials", label: stats.trials.label, hint: stats.trials.hint, meter: false, spark: false },
                    { id: "refusals", label: stats.refusals.label, hint: stats.refusals.hint, meter: false, spark: false },
                  ]}
                />
              </div>
              <ChartPanel id="downloads" title={layout.charts.downloads} hint={null} span={6} legend={null} size="small" />
              <ChartPanel id="users" title={layout.charts.newUsers} hint={null} span={6} legend={null} size="small" />
            </Section>

            <Section id="growth-funnel" title={sections.funnel.title} description={sections.funnel.description}>
              <TablePanel
                id="insights-funnel"
                title={text.insights.funnelTitle}
                hint={text.insights.funnelNote}
                columns={[
                  textColumn(text.insights.funnelColumns.step),
                  numberColumn(text.insights.funnelColumns.count),
                  numberColumn(text.insights.funnelColumns.fromPrevious),
                  numberColumn(text.insights.funnelColumns.lost),
                ]}
                span={8}
                empty={null}
                note={null}
                scroll={false}
              />
              <FactsPanel
                id="growth-signups"
                title={facts.signups.title}
                hint={null}
                span={4}
                rows={[
                  { id: "today", label: facts.signups.today },
                  { id: "week", label: facts.signups.week },
                  { id: "month", label: facts.signups.month },
                  { id: "apple", label: facts.signups.apple },
                  { id: "google", label: facts.signups.google },
                ]}
              />
              <TablePanel
                id="product-steps"
                title={product.steps}
                hint={null}
                columns={[textColumn(productColumns.step), numberColumn(productColumns.accounts), numberColumn(productColumns.median)]}
                span={8}
                empty={null}
                note=""
                scroll={false}
              />
              <FactsPanel
                id="growth-refusals"
                title={facts.refusals.title}
                hint={null}
                span={4}
                rows={[
                  { id: "device", label: facts.refusals.device },
                  { id: "ip", label: facts.refusals.ip },
                  { id: "exhausted", label: facts.refusals.exhausted },
                  { id: "expired", label: facts.refusals.expired },
                  { id: "today", label: facts.refusals.today },
                ]}
              />
            </Section>

            <Section id="growth-acquisition" title={sections.acquisition.title} description={sections.acquisition.description}>
              <TablePanel
                id="insights-sources"
                title={text.insights.sourcesTitle}
                hint={null}
                columns={[textColumn(text.insights.sourceColumns.source), numberColumn(text.insights.sourceColumns.count)]}
                span={4}
                empty={text.insights.noDownloads}
                note={null}
                scroll={false}
              />
              <TablePanel
                id="insights-referrers"
                title={text.insights.referrersTitle}
                hint={text.insights.downloadsNote}
                columns={[textColumn(text.insights.referrerColumns.host), numberColumn(text.insights.referrerColumns.count)]}
                span={4}
                empty={text.insights.noDownloads}
                note={null}
                scroll={false}
              />
              <TablePanel
                id="trend-campaigns"
                title={trendsText.tables.campaigns.title}
                hint={null}
                columns={trendColumns("campaigns")}
                span={4}
                empty={trendsText.tables.campaigns.empty}
                note={trendsText.tables.campaigns.note === "" ? null : trendsText.tables.campaigns.note}
                scroll={false}
              />
            </Section>

            <Section id="growth-website" title={sections.website.title} description={sections.website.description}>
              <div class="span-12 site-lead">
                <p id="trend-site-summary" class="site-lead__summary tabular"></p>
                <p id="trend-site-error" class="notice hidden" role="status"></p>
              </div>
              <ChartPanel id="trend-site" title={trendsText.siteChart.title} hint={null} span={12} legend={null} size="small" />
              <TablePanel
                id="trend-paths"
                title={trendsText.tables.paths.title}
                hint={null}
                columns={trendColumns("paths")}
                span={6}
                empty={trendsText.tables.paths.empty}
                note={trendsText.tables.paths.note === "" ? null : trendsText.tables.paths.note}
                scroll={true}
              />
              <TablePanel
                id="trend-referrers"
                title={trendsText.tables.referrers.title}
                hint={null}
                columns={trendColumns("referrers")}
                span={6}
                empty={trendsText.tables.referrers.empty}
                note={trendsText.tables.referrers.note === "" ? null : trendsText.tables.referrers.note}
                scroll={true}
              />
            </Section>

            <Section id="growth-invites" title={sections.invites.title} description={sections.invites.description}>
              <TablePanel
                id="insights-invites"
                title={inviteText.insightsTitle}
                hint={null}
                columns={[textColumn(inviteText.insightsColumns.measure), numberColumn(inviteText.insightsColumns.count)]}
                span={4}
                empty={null}
                note={null}
                scroll={false}>
                <p slot="foot" id="insights-invites-voided" class="panel__note"></p>
              </TablePanel>
              <FactsPanel
                id="growth-referrals"
                title={facts.referrals.title}
                hint={null}
                span={4}
                rows={[
