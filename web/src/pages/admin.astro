                      <div id="blog-image-preview" class="blog-image__preview">
                        <Icon name="image" size={28} class="blog-image__placeholder" />
                      </div>
                      <div class="blog-image__fields">
                        <div class="field">
                          <span class="blog-image__label" aria-hidden="true">{blogText.image.file}</span>
                          {/* Tarayıcının kendi dosya düğmesi sistem dilinde yazar: gizlenir, etiketi düğme gibi görünür. */}
                          <div class="blog-image__picker">
                            <input
                              id="blog-image-file"
                              class="visually-hidden"
                              type="file"
                              accept="image/png,image/jpeg,image/webp"
                              aria-describedby="blog-image-info"
                            />
                            <label for="blog-image-file" class="button button--secondary button--small blog-image__choose">{blogText.image.choose}</label>
                            <span id="blog-image-file-name" class="small muted blog-image__file-name"></span>
                          </div>
                          <p id="blog-image-info" class="blog-hint">{blogText.image.fileHint}</p>
                        </div>
                        <div class="field">
                          <label for="blog-image-alt">{blogText.image.alt}</label>
                          <input id="blog-image-alt" class="input input--small" type="text" autocomplete="off" aria-describedby="blog-image-alt-hint" />
                          <p id="blog-image-alt-hint" class="blog-hint">{blogText.image.altHint}</p>
                        </div>
                        <div class="field">
                          <label for="blog-image-name">{blogText.image.name}</label>
                          <input id="blog-image-name" class="input input--small mono" type="text" autocomplete="off" spellcheck="false" aria-describedby="blog-image-path" />
                          <p id="blog-image-path" class="blog-hint mono"></p>
                        </div>
                        <p id="blog-image-notice" class="notice hidden" role="status"></p>
                        <div class="blog-image__actions">
                          <button id="blog-image-upload" class="button button--primary button--small" type="button" disabled>{blogText.image.upload}</button>
                          <button id="blog-image-cancel" class="button button--secondary button--small" type="button">{blogText.image.cancel}</button>
                        </div>
                      </div>
                    </div>
                  </section>
                  <label class="visually-hidden" for="blog-body">{blogText.fields.body}</label>
                  <textarea id="blog-body" class="input blog-body" spellcheck="true"></textarea>
                  <div id="blog-preview" class="prose blog-preview hidden" aria-live="polite"></div>
                </div>

                <div class="blog-editor__actions">
                  <button id="blog-save" class="button button--primary button--small" type="submit">{blogText.save}</button>
                  <button id="blog-delete" class="button button--danger button--small blog-editor__delete hidden" type="button">{blogText.delete}</button>
                  <div id="blog-delete-confirm" class="blog-confirm hidden" role="group" aria-labelledby="blog-delete-question">
                    <p id="blog-delete-question">{blogText.deleteConfirm}</p>
                    <button id="blog-delete-yes" class="button button--danger-solid button--small" type="button">{blogText.deleteYes}</button>
                    <button id="blog-delete-no" class="button button--secondary button--small" type="button">{blogText.deleteNo}</button>
                  </div>
                </div>
              </form>
            </section>
          </div>
        </div>
      </div>
    </div>
  </template>
</Base>

