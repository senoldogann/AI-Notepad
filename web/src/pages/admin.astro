              </div>
              <div class="span-12">
                <Stats
                  label={layout.views.operations.label}
                  stats={[
                    { id: "ops-deepgram", label: text.operations.kpis.deepgram, hint: null, meter: false, spark: false },
                    { id: "ops-webhook", label: text.operations.kpis.webhook, hint: null, meter: false, spark: false },
                    { id: "ops-reports", label: text.operations.kpis.reports, hint: null, meter: false, spark: false },
                  ]}
                />
              </div>
            </Section>
            <Section id="operations-live" title={sections.live.title} description={sections.live.description}>
              <TablePanel
                id="ops-open"
                title={text.operations.openTitle}
