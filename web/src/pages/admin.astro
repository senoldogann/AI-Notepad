/**
 * Tablo sütunu: başlık ve sayısal mı. Sayısal sütunun başlığı da hücreleri de sağa yaslanır; betik hücreleri başlığa
 * göre hizalar (`fillTable`), sütun hizasının tek kaynağı burasıdır.
 */
interface Column {
  readonly label: string;
  readonly numeric: boolean;
}

/** Metin sütunu. Saf fonksiyondur. */
function textColumn(label: string): Column {
  return { label, numeric: false };
}

/** Sayı sütunu. Saf fonksiyondur. */
function numberColumn(label: string): Column {
  return { label, numeric: true };
}

