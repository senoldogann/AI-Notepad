---
// Yönetim paneli (menüde ve site haritasında yok, arama motorlarına kapalı, önbelleğe alınmaz): özet kutuları, son 30
// günün grafikleri ve bildirim kutusu. Değerler tarayıcıda `/v1/admin/*` uçlarından doldurulur (src/client/admin.ts).
// Panelin varlığı belli olmaz: sayfa başlığı nötrdür, panel `<template>` içinde durur ve yalnızca sunucu yönetici
// erişimini doğrulayınca (`/v1/admin/stats` başarılı) sayfaya eklenir. O zamana dek yalnızca nötr bir yükleme satırı
// görünür; oturum yoksa ya da sunucu 403 (veya yenilemesi başarısız 401) dönerse standart "sayfa bulunamadı" görünümü.
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import NotFound from "../components/NotFound.astro";
import { type AdminCopy, copy } from "../copy";
import type { IconName } from "../lib/icons";

const text: AdminCopy = copy.admin;

/** Özet kutusu: kimlik (betik `kpi-<id>`, `kpi-<id>-sub` ve varsa `kpi-<id>-meter` doldurur), etiket, simge, ölçer var mı. */
interface KpiSpec {
  readonly id: string;
  readonly label: string;
  readonly icon: IconName;
  readonly meter: boolean;
}

/** Özet kutusu grubu: başlık ve kutular. */
interface KpiGroup {
  readonly id: "growth" | "revenue" | "costs";
  readonly title: string;
  readonly kpis: readonly KpiSpec[];
}

/**
 * Özet kutuları üç grupta: büyüme, gelir, maliyet ve kapasite. Maliyet grubunun ızgarası yeni kutulara (ör. Deepgram
 * bütçesi) kendiliğinden yer açar.
 */
const groups: readonly KpiGroup[] = [
  {
    id: "growth",
    title: text.groups.growth,
    kpis: [
      { id: "downloads", label: text.kpis.downloads, icon: "download", meter: false },
      { id: "users", label: text.kpis.users, icon: "users", meter: false },
      { id: "trials", label: text.kpis.trials, icon: "gift", meter: false },
      { id: "subscribers", label: text.kpis.subscribers, icon: "card", meter: false },
    ],
  },
  { id: "revenue", title: text.groups.revenue, kpis: [{ id: "mrr", label: text.kpis.mrr, icon: "chart", meter: false }] },
  {
    id: "costs",
    title: text.groups.costs,
    kpis: [
      { id: "spend", label: text.kpis.spend, icon: "wallet", meter: true },
      { id: "elevenlabs", label: text.kpis.elevenLabs, icon: "waveform", meter: true },
      { id: "deepgram", label: text.kpis.deepgram, icon: "translate", meter: true },
      { id: "hours", label: text.kpis.hours, icon: "clock", meter: false },
      { id: "tokens", label: text.kpis.tokens, icon: "tokens", meter: false },
    ],
  },
];

/** Grafikler: kimlik (betik `chart-<id>` çizer) ve başlık. */
const charts: readonly { readonly id: string; readonly title: string; readonly legend: boolean }[] = [
  { id: "downloads", title: text.charts.downloads, legend: false },
  { id: "users", title: text.charts.users, legend: false },
  { id: "meetings", title: text.charts.meetings, legend: true },
  { id: "spend", title: text.charts.spend, legend: false },
];

/** Bildirim kutusu sekmeleri. */
const tabs: readonly { readonly kind: string; readonly label: string; readonly icon: IconName }[] = [
  { kind: "feedback", label: text.tabs.feedback, icon: "message" },
  { kind: "crash", label: text.tabs.crash, icon: "sparkle" },
  { kind: "contact", label: text.tabs.contact, icon: "mail" },
];
---

<Base page="admin" meta={text.meta} indexed={false}>
  <div id="admin-not-found" hidden data-title={copy.notFound.meta.title}>
    <NotFound />
  </div>

  <section class="page admin" id="admin" data-title={text.documentTitle}>
    <p id="admin-loading" class="muted admin__loading" role="status">{text.loading}</p>
    <p id="admin-error" class="notice notice--error hidden" role="alert"></p>
    <div id="admin-mount" class="admin__mount"></div>
  </section>

  {/* Panel: yönetici erişimi doğrulanınca `#admin-mount` içine kopyalanır (admin.ts). */}
  <template id="admin-template">
    <div class="admin__head">
      <div>
        <h1 class="title-l">{text.title}</h1>
        <p id="admin-updated" class="small muted" aria-live="polite"></p>
      </div>
      <button id="admin-refresh" class="button button--secondary button--small" type="button">
        <Icon name="refresh" size={16} class="" />
        {text.refresh}
      </button>
    </div>

    <div id="admin-content" class="admin__content">
      <div class="kpi-groups">
        {
          groups.map((group: KpiGroup) => (
            <section class:list={["kpi-group", `kpi-group--${group.id}`]} aria-labelledby={`group-${group.id}`}>
              <h2 class="eyebrow kpi-group__title" id={`group-${group.id}`}>
                {group.title}
              </h2>
              <div class="kpi-group__grid">
                {group.kpis.map((kpi: KpiSpec) => (
                  <div class:list={["card", "kpi", { "kpi--meter": kpi.meter }]} id={`kpi-${kpi.id}-card`}>
                    <p class="kpi__label">
                      <Icon name={kpi.icon} size={16} class="kpi__icon" />
                      {kpi.label}
                    </p>
                    <p id={`kpi-${kpi.id}`} class="kpi__value tabular" />
                    {kpi.meter ? <progress id={`kpi-${kpi.id}-meter`} class="meter kpi__meter" aria-label={kpi.label} max="1" value="0" /> : null}
                    <p id={`kpi-${kpi.id}-sub`} class="kpi__sub small" />
                  </div>
                ))}
              </div>
            </section>
          ))
        }
      </div>

      <section aria-labelledby="charts-title">
        <h2 class="title-m section-title" id="charts-title">{text.chartsTitle}</h2>
        <div class="charts">
          {
            charts.map((chart) => (
              <figure class="card chart">
                <div class="chart__head">
                  <h3 class="chart__title">{chart.title}</h3>
                  {chart.legend ? (
                    <p class="chart__legend small muted" aria-hidden="true">
                      <span class="legend legend--main">{text.legendSubscription}</span>
                      <span class="legend legend--accent">{text.legendTrial}</span>
                    </p>
                  ) : null}
                </div>
                <div id={`chart-${chart.id}`} class="chart__plot" />
                <figcaption id={`chart-${chart.id}-summary`} class="small muted" />
              </figure>
            ))
          }
        </div>
      </section>

      <section class="inbox" aria-labelledby="inbox-title">
        <div class="inbox__toolbar">
          <h2 class="title-m" id="inbox-title">{text.inboxTitle}</h2>
          <div class="segmented" role="group" aria-label={text.inboxTitle}>
            {
              tabs.map((tab, index: number) => (
                <button id={`tab-${tab.kind}`} class="segmented__button" type="button" aria-pressed={index === 0 ? "true" : "false"}>
                  <Icon name={tab.icon} size={16} class="" />
                  {tab.label}
                  <span id={`count-${tab.kind}`} class="segmented__count tabular" />
                </button>
              ))
            }
          </div>
          <div class="segmented segmented--quiet" role="group" aria-label={`${text.statusOpen} / ${text.statusDone}`}>
            <button id="status-open" class="segmented__button" type="button" aria-pressed="true">{text.statusOpen}</button>
            <button id="status-done" class="segmented__button" type="button" aria-pressed="false">{text.statusDone}</button>
          </div>
        </div>

        <div class="inbox__body">
          <div class="card inbox__list-card">
            <ul id="inbox-list" class="inbox__list"></ul>
            <p id="inbox-empty" class="muted inbox__empty hidden">{text.empty}</p>
            <button id="inbox-more" class="button button--secondary button--small hidden" type="button">{text.loadMore}</button>
          </div>

          <div id="inbox-detail" class="card inbox__detail">
            <p id="detail-empty" class="muted inbox__empty">{text.detailEmpty}</p>
            <div id="detail-body" class="detail hidden">
              <div class="detail__head">
                <span id="detail-status" class="pill"></span>
                <button
                  id="detail-toggle"
                  class="button button--secondary button--small"
                  type="button"
                  data-label-done={text.markDone}
                  data-label-reopen={text.reopen}>{text.markDone}</button
                >
              </div>
              <dl class="detail__fields">
                <div><dt>{text.fields.received}</dt><dd id="detail-received"></dd></div>
                <div><dt>{text.fields.email}</dt><dd id="detail-email"></dd></div>
                <div><dt>{text.fields.user}</dt><dd id="detail-user" class="mono"></dd></div>
                <div><dt>{text.fields.app}</dt><dd id="detail-app"></dd></div>
                <div><dt>{text.fields.os}</dt><dd id="detail-os"></dd></div>
              </dl>
              <h3 class="detail__label">{text.messageTitle}</h3>
              <p id="detail-message" class="detail__message"></p>
              <div id="detail-payload-block" class="hidden">
                <h3 class="detail__label">{text.payloadTitle}</h3>
                <pre id="detail-payload" class="detail__payload" tabindex="0"></pre>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </template>
</Base>

<script>
  import "../client/admin";
</script>

<style>
  .admin {
    display: grid;
    gap: 20px;
    padding-top: clamp(28px, 5vw, 56px);
  }

  .admin__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }

  .admin__content {
    display: grid;
    gap: clamp(32px, 4vw, 48px);
  }

  /* Panel eklenince yükleme satırı gizlenir; panel kendi aralıklarıyla akar. */
  .admin__mount {
    display: grid;
    gap: 20px;
  }

  .admin__mount:empty {
    display: none;
  }

  .admin__loading {
    min-height: 40vh;
  }

  .section-title {
    margin-bottom: 16px;
  }

  /* ---------- Özet kutuları ---------- */

  /* Büyüme tam genişlikte; altında gelir (1 pay) ve maliyet ve kapasite (2 pay, ikişerli) yan yana. */
  .kpi-groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 28px 16px;
  }

  .kpi-group {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 12px;
    min-width: 0;
  }

  .kpi-group--growth {
    grid-column: 1 / -1;
  }

  .kpi-group__grid {
    display: grid;
    grid-auto-rows: 1fr;
    gap: 16px;
  }

  .kpi-group--growth .kpi-group__grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .kpi-group--revenue .kpi-group__grid {
    grid-template-columns: minmax(0, 1fr);
  }

  /* İkişerli; yeni maliyet kutuları (ör. Deepgram bütçesi) ızgaraya kendiliğinden yeni satır olarak eklenir. */
  .kpi-group--costs .kpi-group__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .kpi {
    display: grid;
    grid-template-rows: auto auto 1fr;
    align-content: start;
    gap: 10px;
    min-height: 148px;
    padding: 20px 22px;
  }

  .kpi--meter {
    grid-template-rows: auto auto auto 1fr;
  }

  .kpi__label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted);
  }

  .kpi__label :global(.kpi__icon) {
    flex: none;
  }

  .kpi__value {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: clamp(1.75rem, 2.6vw, 2.125rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .kpi__meter {
    height: 6px;
  }

  .kpi__sub {
    align-self: end;
    color: var(--muted);
    line-height: 1.45;
  }

  /* Gelir kutusu: üstte ince, durgun film şeridi (bulanıklık ya da hareket yok). */
  /* Gelir kutusu uzun: değer ve alt satır üstte, altı hafif, durgun bir pastel tonla dolar. */
  .kpi-group--revenue .kpi {
    position: relative;
    overflow: hidden;
    grid-template-rows: auto auto auto;
    padding-top: 30px;
    background: linear-gradient(180deg, var(--card) 40%, color-mix(in srgb, #dac6ee 16%, var(--card)) 100%);
  }

  .kpi-group--revenue .kpi__sub {
    align-self: start;
  }

  .kpi-group--revenue .kpi::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 6px;
    background: linear-gradient(90deg, #f7c9b2, #f4bcc6 35%, #dac6ee 70%, #bfd4f4);
  }

  .kpi-group--revenue .kpi__value {
    font-size: clamp(2.125rem, 3.4vw, 2.75rem);
  }

  /* Uyarı: ölçer eşiği aştı (harcama tavana, kapasite sınıra yakın). */
  .kpi--warn {
    border-color: color-mix(in srgb, var(--warn) 40%, var(--line));
  }

  .kpi--warn .kpi__sub {
    color: var(--warn);
  }

  /* ---------- Grafikler ---------- */

  .charts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .chart {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 20px 22px;
  }

  .chart__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
  }

  .chart__title {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .chart__legend {
    display: flex;
    gap: 14px;
  }

  .legend {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .legend::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 2px;
  }

  .legend--main::before {
    background: color-mix(in srgb, var(--ink) 72%, var(--card));
  }

  .legend--accent::before {
    background: var(--accent);
  }

  .chart__plot {
    display: grid;
    gap: 6px;
  }

  .chart__plot :global(.chart__svg) {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .chart__plot :global(.chart__base) {
    fill: var(--line);
  }

  .chart__plot :global(.chart__bar--main) {
    fill: color-mix(in srgb, var(--ink) 72%, var(--card));
  }

  .chart__plot :global(.chart__bar--accent) {
    fill: var(--accent);
  }

  .chart__plot :global(g:hover .chart__bar--main) {
    fill: var(--ink);
  }

  .chart__plot :global(.chart__axis) {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* ---------- Bildirim kutusu ---------- */

  .inbox {
    display: grid;
    gap: 16px;
  }

  .inbox__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }

  .inbox__toolbar h2 {
    margin-right: auto;
  }

  .segmented {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--card);
  }

  .segmented__button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 0 14px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }

  .segmented__button :global(.icon) {
    flex: none;
  }

  .segmented__button:hover {
    color: var(--ink);
  }

  .segmented__button[aria-pressed="true"] {
    background: var(--primary);
    color: var(--on-primary);
  }

  .segmented__count {
    min-width: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--soft);
    color: var(--ink);
    font-size: 0.75rem;
    line-height: 20px;
    text-align: center;
  }

  .segmented__count:empty {
    display: none;
  }

  .segmented__button[aria-pressed="true"] .segmented__count {
    background: color-mix(in srgb, var(--on-primary) 18%, transparent);
    color: var(--on-primary);
  }

  .inbox__body {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 16px;
    align-items: start;
  }

  .inbox__list-card,
  .inbox__detail {
    display: grid;
    gap: 12px;
    padding: 12px;
  }

  .inbox__detail {
    padding: 20px 22px;
  }

  .inbox__list {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .inbox__list :global(.inbox__item) {
    display: grid;
    gap: 2px;
    width: 100%;
    padding: 10px 12px;
    border: 0;
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .inbox__list :global(.inbox__item:hover) {
    background: var(--soft);
  }

  .inbox__list :global(.inbox__item[aria-current="true"]) {
    background: var(--selected);
  }

  .inbox__list :global(.inbox__summary) {
    font-size: 0.9375rem;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .inbox__list :global(.inbox__meta) {
    font-size: 0.8125rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .inbox__empty {
    padding: 12px;
  }

  #inbox-more {
    justify-self: center;
  }

  .detail {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .detail__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .detail__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 16px;
    margin: 0;
  }

  .detail__fields dt {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
  }

  .detail__fields dd {
    margin: 0;
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }

  .mono {
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  .detail__label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0;
  }

  .detail__message {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .detail__payload {
    max-height: 420px;
    margin: 8px 0 0;
    padding: 14px 16px;
    overflow: auto;
    border-radius: var(--radius-s);
    border: 1px solid var(--line);
    background: var(--soft);
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    white-space: pre;
  }

  @media (max-width: 1040px) {
    .kpi-groups {
      grid-template-columns: minmax(0, 1fr);
    }

    .kpi-group--growth .kpi-group__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .charts,
    .inbox__body {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Dar ekranda süzgeçler tek satırda, tam genişlikte. */
  @media (max-width: 560px) {
    .segmented {
      flex-wrap: nowrap;
      width: 100%;
    }

    .segmented__button {
      flex: 1 1 auto;
      justify-content: center;
      padding: 0 8px;
    }

    .segmented__button :global(.icon) {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .detail__fields {
      grid-template-columns: minmax(0, 1fr);
    }

    .kpi {
      min-height: 0;
    }

    .kpi-group__grid {
      grid-auto-rows: auto;
    }

    .kpi-group--costs .kpi-group__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
