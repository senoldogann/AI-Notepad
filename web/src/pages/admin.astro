                columns={[
                  textColumn(text.operations.openColumns.user),
                  textColumn(text.operations.openColumns.kind),
                  textColumn(text.operations.openColumns.started),
                  textColumn(text.operations.openColumns.endsBy),
                  textColumn(text.operations.openColumns.notes),
                ]}
                span={12}
                empty={text.operations.noOpen}
                note={null}
                scroll={false}
              />
              <TablePanel
                id="ops-stripe"
                title={text.operations.stripeTitle}
                hint={null}
                columns={[textColumn(text.operations.stripeColumns.type), numberColumn(text.operations.stripeColumns.count)]}
