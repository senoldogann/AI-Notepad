                <a id="blog-share-linkedin" class="button button--secondary button--small" href="#blog" target="_blank" rel="noopener noreferrer"
                  >{blogText.share.linkedin}</a
                >
                <a id="blog-share-bluesky" class="button button--secondary button--small" href="#blog" target="_blank" rel="noopener noreferrer"
                  >{blogText.share.bluesky}</a
                >
              </div>

              <form id="blog-form" class="blog-editor__grid" novalidate>
                <div class="card blog-editor__meta">
                  <div class="field">
                    <div class="blog-field__row">
                      <label for="blog-title">{blogText.fields.title}</label>
                      <span id="blog-title-counter" class="small muted tabular"></span>
                    </div>
                    <input id="blog-title" class="input input--small" type="text" autocomplete="off" aria-describedby="blog-title-counter" />
                  </div>
                  <div class="field">
                    <label for="blog-slug">{blogText.fields.slug}</label>
                    <input id="blog-slug" class="input input--small mono" type="text" autocomplete="off" spellcheck="false" aria-describedby="blog-slug-url" />
                    <p class="blog-hint">
                      <span id="blog-slug-url" class="mono"></span>
                      <span id="blog-slug-locked" class="hidden"> · {blogText.slugLocked}</span>
                    </p>
                  </div>
                  <div class="field">
                    <div class="blog-field__row">
                      <label for="blog-description">{blogText.fields.description}</label>
                      <span id="blog-description-counter" class="small muted tabular"></span>
                    </div>
                    <textarea id="blog-description" class="input blog-textarea" rows="3" aria-describedby="blog-description-counter"></textarea>
                  </div>
                  <div class="field">
                    <label for="blog-author">{blogText.fields.author}</label>
                    <input id="blog-author" class="input input--small" type="text" autocomplete="off" />
                  </div>
                  <div class="field">
                    <label for="blog-published">{blogText.fields.published}</label>
                    <input id="blog-published" class="input input--small" type="date" aria-describedby="blog-published-hint" />
                    <p id="blog-published-hint" class="blog-hint">{blogText.publishedHint}</p>
                  </div>
                  <div class="field">
                    <label for="blog-updated">{blogText.fields.updated}</label>
                    <input id="blog-updated" class="input input--small" type="date" aria-describedby="blog-updated-hint" />
                    <p id="blog-updated-hint" class="blog-hint">{blogText.updatedHint}</p>
                  </div>
                  <div class="field">
                    <label for="blog-cover">{blogText.fields.cover}</label>
                    <div class="blog-cover-picker">
                      {/* Kapağın küçük önizlemesi: betik aile ve yerleşim sınıflarını yazar (src/lib/film.ts `coverFilm`). */}
                      <div id="blog-cover-swatch" class="film film--sunset film--clouds-left blog-cover-swatch" aria-hidden="true"></div>
                      <select id="blog-cover" class="input input--small select" aria-describedby="blog-cover-hint">
                        <option value="">{blogText.coverAuto}</option>
                        {filmPalettes.map((palette: FilmPalette) => <option value={palette}>{blogText.paletteNames[palette]}</option>)}
                      </select>
                    </div>
                    <p id="blog-cover-hint" class="blog-hint"></p>
                  </div>
                  <div class="field">
                    <label class="blog-toggle" for="blog-draft">
                      <input id="blog-draft" type="checkbox" aria-describedby="blog-draft-hint" />
                      {blogText.fields.draft}
                    </label>
                    <p id="blog-draft-hint" class="blog-hint">{blogText.draftHint}</p>
                  </div>
                </div>

                <div class="card blog-editor__body">
