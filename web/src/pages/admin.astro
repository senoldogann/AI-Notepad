                  {/* Görsel ekleme: tarayıcıda WebP'ye çevrilir, sunucu yazının klasörüne yükler (admin-blog.ts, admin-blog-image.ts). */}
                  <section id="blog-image" class="blog-image hidden" aria-labelledby="blog-image-title">
                    <h3 id="blog-image-title" class="detail__label">{blogText.image.title}</h3>
                    <p id="blog-image-save-first" class="blog-hint hidden"></p>
