---
// Tüm dilli sayfalar ve dile özgü olmayan dönüş adresleri tek tablodan (src/i18n/routes.ts) üretilir.
import type { GetStaticPaths } from "astro";
import Account from "../views/Account.astro";
import Download from "../views/Download.astro";
import EmailLink from "../views/EmailLink.astro";
import Home from "../views/Home.astro";
import LangRedirect from "../views/LangRedirect.astro";
import Legal from "../views/Legal.astro";
import Pricing from "../views/Pricing.astro";
import SignIn from "../views/SignIn.astro";
import PrivacyEn from "../legal/PrivacyEn.astro";
import PrivacyTr from "../legal/PrivacyTr.astro";
import TermsEn from "../legal/TermsEn.astro";
import TermsTr from "../legal/TermsTr.astro";
import { copy } from "../i18n/copy";
import { type Lang, type NeutralRoute, type PageKey, langs, neutralRoutes, routes } from "../i18n/routes";

/** Sayfanın türü: dilli sayfa ya da dil yönlendirmesi. */
type RouteProps = { readonly kind: "page"; readonly lang: Lang; readonly page: PageKey } | { readonly kind: "neutral"; readonly page: PageKey };

export const getStaticPaths = ((): { params: { slug: string }; props: RouteProps }[] => {
  const pageKeys: PageKey[] = Object.keys(routes) as PageKey[];
  const pages = langs.flatMap((lang: Lang) =>
    pageKeys.map((page: PageKey) => ({ params: { slug: routes[page][lang].slice(1) }, props: { kind: "page", lang, page } as RouteProps })),
  );
  const neutral = neutralRoutes.map((route: NeutralRoute) => ({ params: { slug: route.path.slice(1) }, props: { kind: "neutral", page: route.page } as RouteProps }));
  return [...pages, ...neutral];
}) satisfies GetStaticPaths;

const props: RouteProps = Astro.props;
---

{props.kind === "neutral" && <LangRedirect page={props.page} indexed={false} />}
{props.kind === "page" && props.page === "home" && <Home lang={props.lang} />}
{props.kind === "page" && props.page === "pricing" && <Pricing lang={props.lang} />}
{props.kind === "page" && props.page === "download" && <Download lang={props.lang} />}
{props.kind === "page" && props.page === "signIn" && <SignIn lang={props.lang} />}
{props.kind === "page" && props.page === "emailLink" && <EmailLink lang={props.lang} />}
{props.kind === "page" && props.page === "account" && <Account lang={props.lang} />}
{
  props.kind === "page" && props.page === "privacy" && (
    <Legal lang={props.lang} page="privacy" meta={copy[props.lang].privacyMeta} title={copy[props.lang].common.nav.privacy}>
      {props.lang === "tr" ? <PrivacyTr /> : <PrivacyEn />}
    </Legal>
  )
}
{
  props.kind === "page" && props.page === "terms" && (
    <Legal lang={props.lang} page="terms" meta={copy[props.lang].termsMeta} title={copy[props.lang].common.nav.terms}>
      {props.lang === "tr" ? <TermsTr /> : <TermsEn />}
    </Legal>
  )
}
