---
// İndirme sayfası: indirme düğmesi (sunucu indirmeyi sayıp DMG'ye yönlendirir), sistem gereksinimleri, Mac'e kurulum
// adımları, güncellemeler ve yardım.
import Base from "../layouts/Base.astro";
import Film from "../components/Film.astro";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import Waveform from "../components/Waveform.astro";
import { latestVersion, macDownloadUrl, productName } from "../config";
import { copy, type DownloadCopy, type IconText, type TitledText } from "../copy";
import { routes } from "../routes";
import { siteConfig } from "../site";

const text: DownloadCopy = copy.download;
---

<Base page="download" meta={text.meta} indexed={true}>
  <section class="page download-hero">
    <div class="download-hero__text">
      <h1 class="title-xl">{text.title}</h1>
      <p class="lead">{text.lead}</p>
      <div class="download-hero__actions">
        <a class="button button--primary download-button" href={macDownloadUrl(siteConfig)}>
          <Icon name="apple" size={18} class="button__apple" />
          {copy.common.downloadCta}
        </a>
        <p class="small muted"><span class="pill">{text.versionLabel} {latestVersion}</span> {copy.common.requirementsShort}</p>
      </div>
      <p class="small muted note">{text.buttonNote}</p>
    </div>
    <Film palette="mint" layout="clouds-left" class="download-hero__cover">
      <div class="app-tile">
        <Logo size={96} />
        <span class="app-tile__name">{productName}</span>
      </div>
      <Waveform seed={productName} width={200} height={44} class="download-hero__wave" />
    </Film>
  </section>

  <section class="section page" aria-labelledby="requirements-title">
    <h2 class="title-l reveal" id="requirements-title">{text.requirementsTitle}</h2>
    <dl class="requirements">
      {
        text.requirements.map((requirement: IconText) => (
          <div class="card requirement reveal">
            <span class="icon-chip">
              <Icon name={requirement.icon} size={20} class="" />
            </span>
            <dt class="title-m">{requirement.title}</dt>
            <dd class="muted">{requirement.text}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="page install" aria-labelledby="install-title">
    <h2 class="title-l reveal" id="install-title">{text.installTitle}</h2>
    <ol class="install__steps">
      {
        text.installSteps.map((step: TitledText, index: number) => (
          <li class="install__step reveal">
            <span class="install__number tabular" aria-hidden="true">{index + 1}</span>
            <div>
              <h3 class="title-m">{step.title}</h3>
              <p class="muted">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section page more" aria-label={text.updatesTitle}>
    <div class="card reveal">
      <span class="icon-chip"><Icon name="refresh" size={20} class="" /></span>
      <h2 class="title-m">{text.updatesTitle}</h2>
      <p class="muted">{text.updatesText}</p>
    </div>
    <div class="card reveal">
      <span class="icon-chip"><Icon name="message" size={20} class="" /></span>
      <h2 class="title-m">{text.helpTitle}</h2>
      <p class="muted">{text.helpText}</p>
      <a class="text-link" href={routes.contact}>{text.helpCta} <Icon name="arrow-right" size={16} class="" /></a>
    </div>
  </section>
</Base>

<style>
  .download-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    padding-top: clamp(48px, 8vw, 96px);
  }

  .download-hero__text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  .download-hero__actions {
    display: grid;
    gap: 12px;
    justify-items: start;
    margin-top: 6px;
  }

  .download-button {
    min-height: 54px;
    padding: 0 28px;
    font-size: 1rem;
  }

  .download-hero__actions .pill {
    margin-right: 6px;
  }

  .note {
    max-width: 30rem;
  }

  .download-hero :global(.download-hero__cover) {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 28px;
    aspect-ratio: 5 / 4;
  }

  .app-tile {
    display: grid;
    justify-items: center;
    gap: 14px;
  }

  .app-tile :global(.logo-mark) {
    filter: drop-shadow(0 18px 30px rgb(30 60 45 / 0.25));
  }

  .app-tile__name {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .requirements {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: clamp(28px, 4vw, 44px) 0 0;
  }

  .requirement {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 6px;
  }

  .requirement .icon-chip {
    margin-bottom: 10px;
  }

  .requirement dd {
    margin: 0;
  }

  .install {
    display: grid;
    gap: clamp(28px, 4vw, 44px);
  }

  .install__steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 52rem;
  }

  .install__step {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 18px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }

  .install__step h3 {
    margin-bottom: 6px;
  }

  .install__number {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--primary);
    color: var(--on-primary);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .more {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .more .card {
    display: grid;
    gap: 10px;
    align-content: start;
    justify-items: start;
  }

  .more .icon-chip {
    margin-bottom: 6px;
  }

  @media (max-width: 960px) {
    .requirements {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .download-hero,
    .more {
      grid-template-columns: minmax(0, 1fr);
    }

    .download-button {
      width: 100%;
    }

    .download-hero__actions {
      justify-items: stretch;
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .requirements {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
