---
// Fiyat sayfası: iki plan (aylık 5,99 $, yıllık 49 $; vergiler dahil; yıllık önerilen), davet sayfasına bağlantı, neler
// dahil (yalnızca özellikler), sınırlar (deneme, aylık saat, toplantı süresi, iptal), ödeme ve vergiler (satıcı Link) ve
// SSS. Her bilgi sayfada bir kez geçer. Plan düğmeleri hesap sayfasına seçilen planla gider (`/account?plan=…`); hesap
// sayfası oturum yoksa önce girişe yönlendirir.
import Base from "../layouts/Base.astro";
import Faq from "../components/Faq.astro";
import Film from "../components/Film.astro";
import Icon from "../components/Icon.astro";
import Waveform from "../components/Waveform.astro";
import { copy, type CommonCopy, type IconItem, type IconText, type PlanOptionCopy, type PricingCopy } from "../copy";
import { faqStructuredData, structuredDataJson } from "../lib/structured-data";
import { recommendedPlan } from "../lib/plans";
import { pageUrl, routes } from "../routes";
import { siteConfig } from "../site";

const text: PricingCopy = copy.pricing;
const common: CommonCopy = copy.common;
/** Arama motorları için sayfanın sık sorulan soruları (JSON-LD; aşağıdaki `Faq` ile aynı girdiler). */
const structuredData: string = structuredDataJson(faqStructuredData(text.faq, pageUrl("pricing", siteConfig.siteOrigin)));
/** Plan notunun davet bağlantısından önceki ve sonraki parçası; metinde tam bir `{invite}` yoksa derleme durur. */
const [noteBefore, noteAfter]: readonly [string, string] = ((): readonly [string, string] => {
  const [before, after, ...rest]: readonly string[] = text.plansNote.split("{invite}");
  if (before === undefined || after === undefined || rest.length > 0) {
    throw new Error(`copy.pricing.plansNote tam bir "{invite}" yer tutucusu içermeli; gelen: ${JSON.stringify(text.plansNote)}`);
  }
  return [before, after];
})();
---

<Base page="pricing" meta={text.meta} indexed={true}>
  {/* Veri bloğu: Astro işlemez ve paketlemez (`is:inline`), tarayıcı çalıştırmaz; CSP'ye takılmaz. */}
  <script is:inline type="application/ld+json" set:html={structuredData} />
  <section class="page intro">
    <p class="eyebrow">{common.nav.pricing}</p>
    <h1 class="title-xl">{text.title}</h1>
    <p class="lead">{text.lead}</p>
  </section>

  <section class="page" aria-labelledby="plans-title">
    <h2 class="visually-hidden" id="plans-title">{text.plansTitle}</h2>
    <div class="plans">
      {
        text.plans.map((option: PlanOptionCopy) => {
          const featured: boolean = option.plan === recommendedPlan;
          return (
            <article class:list={["plan-option", { "plan-option--featured": featured }]} aria-labelledby={`plan-${option.plan}`}>
              <Film palette={featured ? "rose" : "ocean"} layout={featured ? "clouds-left" : "streaks"} class="plan-option__cover">
                <Waveform seed={option.name} width={160} height={40} class="plan-option__wave" />
              </Film>
              <div class="plan-option__body">
                <div class="plan-option__head">
                  <h3 class="title-m" id={`plan-${option.plan}`}>{option.name}</h3>
                  {option.badge === null ? null : <span class="pill pill--ok">{option.badge}</span>}
                </div>
                <p class="plan-option__price">
                  <span class="tabular">{option.price}</span>
                  <span class="plan-option__per">{option.per}</span>
                </p>
                <p class="small muted">{option.detail}</p>
                <a
                  class:list={["button", "button--block", featured ? "button--primary" : "button--secondary"]}
                  href={`${routes.account}?plan=${option.plan}`}
                >
                  {option.cta}
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
    <div class="plans__foot">
      <p class="muted">
        {noteBefore}<a class="text-link" href={routes.invite}>{text.plansInviteLink}</a>{noteAfter}
      </p>
      <p class="small muted">{common.renewalNote}</p>
      <a class="button button--secondary" href={routes.download}>{text.startFree}</a>
    </div>
  </section>

  <section class="page included-section" aria-labelledby="included-title">
    <article class="plan">
      <div class="plan__body">
        <div class="plan__summary">
          <h2 class="title-l" id="included-title">{text.includedTitle}</h2>
          <p class="muted">{text.planTagline}</p>
        </div>
        <ul class="included">
          {
            text.included.map((item: IconItem) => (
              <li class="included__item">
                <span class="icon-chip">
                  <Icon name={item.icon} size={18} class="" />
                </span>
                <span>{item.text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </article>
  </section>

  <section class="section page" aria-labelledby="limits-title">
    <h2 class="title-l reveal" id="limits-title">{text.limitsTitle}</h2>
    <div class="limits">
      {
        text.limits.map((limit: IconText) => (
          <div class="card limit reveal">
            <span class="icon-chip">
              <Icon name={limit.icon} size={20} class="" />
            </span>
            <h3 class="title-m">{limit.title}</h3>
            <p class="muted">{limit.text}</p>
          </div>
        ))
      }
    </div>
    <div class="tax reveal">
      <h2 class="title-m">{text.taxTitle}</h2>
      <p class="muted">{text.taxText}</p>
    </div>
  </section>

  <section class="page faq-section" aria-labelledby="pricing-faq-title">
    <h2 class="title-l reveal" id="pricing-faq-title">{text.faqTitle}</h2>
    <Faq items={text.faq} />
  </section>
</Base>

<style>
  .intro {
    display: grid;
    gap: 18px;
    padding-block: clamp(48px, 8vw, 96px) clamp(32px, 5vw, 56px);
  }

  /* ---------- Plan kartları ---------- */

  .plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    max-width: 880px;
  }

  .plan-option {
    display: grid;
    grid-template-rows: auto 1fr;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--card);
    overflow: hidden;
  }

  /* Önerilen plan (yıllık): vurgulu kenar. */
  .plan-option--featured {
    border-color: color-mix(in srgb, var(--ink) 55%, var(--line));
    box-shadow: var(--elevation);
  }

  .plan-option :global(.plan-option__cover) {
    display: grid;
    place-items: center;
    height: clamp(88px, 10vw, 112px);
    border-radius: 0;
  }

  .plan-option__body {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: clamp(22px, 3vw, 32px);
  }

  .plan-option__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
  }

  .plan-option__price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 8px;
    font-size: clamp(2.5rem, 5vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .plan-option__per {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
  }

  .plan-option .button {
    margin-top: 14px;
  }

  .plans__foot {
    display: grid;
    justify-items: start;
    gap: 10px;
    max-width: 46rem;
    margin-top: 24px;
  }

  /* ---------- Neler dahil ---------- */

  .included-section {
    margin-top: clamp(48px, 7vw, 88px);
  }

  .plan {
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--card);
    overflow: hidden;
  }

  .plan__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(24px, 5vw, 64px);
    padding: clamp(24px, 4vw, 48px);
  }

  .plan__summary {
    display: grid;
    align-content: start;
    gap: 12px;
  }

  .included {
    display: grid;
    align-content: start;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .included__item {
    display: flex;
    align-items: center;
    gap: 14px;
    line-height: 1.45;
  }

  .limits {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(28px, 4vw, 44px);
  }

  .limit {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 10px;
  }

  .limit .icon-chip {
    margin-bottom: 6px;
  }

  .tax {
    display: grid;
    gap: 8px;
    max-width: 46rem;
    margin-top: clamp(40px, 5vw, 64px);
  }

  /* SSS ana sayfadaki gibi: başlık solda, sorular sağda; sayfanın sol kenarıyla hizalı. */
  .faq-section {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: start;
  }

  @media (max-width: 960px) {
    .faq-section {
      grid-template-columns: minmax(0, 1fr);
    }

    .limits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .plans,
    .plan__body,
    .limits {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Tek sütunda önerilen plan önce gelir. */
    .plan-option--featured {
      order: -1;
    }
  }
</style>
