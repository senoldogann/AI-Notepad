---
// Hesap sayfası: başlıkta plan durumu (etiket), plan kartı (plan, deneme ya da abonelik satırı, abonede aylık kullanım,
// Abone ol / Aboneliği yönet ve fiyat, yenileme notu), uygulamayı indirme kartı, yardım bağlantıları, çıkış ve ayrı
// duran hesap silme alanı (onay penceresiyle). Değerler tarayıcıda `/v1/me`'den doldurulur (src/client/account.ts).
import Base from "../layouts/Base.astro";
import Film from "../components/Film.astro";
import Icon from "../components/Icon.astro";
import Waveform from "../components/Waveform.astro";
import { macDownloadUrl } from "../config";
import { type AccountCopy, type CommonCopy, copy } from "../copy";
import { routes } from "../routes";
import { siteConfig } from "../site";

const text: AccountCopy = copy.account;
const common: CommonCopy = copy.common;
const helpLinks: readonly { readonly href: string; readonly label: string }[] = [
  { href: routes.contact, label: text.helpContact },
  { href: routes.privacy, label: common.nav.privacy },
  { href: routes.terms, label: common.nav.terms },
];
---

<Base page="account" meta={text.meta} indexed={false}>
  <section class="page account" id="account" data-sign-in-path={routes.signIn} data-home-path={routes.home}>
    <header class="account__head">
      <div class="account__title">
        <p class="eyebrow">{common.nav.account}</p>
        <h1 class="title-xl">{text.title}</h1>
      </div>
      <div class="account__head-actions">
        <span id="plan-pill" class="pill hidden"></span>
        <button id="signout-button" class="button button--secondary button--small" type="button">{text.signOut}</button>
      </div>
    </header>

    <noscript><p class="notice notice--error">{text.noScript}</p></noscript>
    <p id="payment-done" class="notice notice--ok hidden" role="status">{text.paymentDone}</p>
    <p id="account-error" class="notice notice--error hidden" role="alert"></p>
    <p id="account-loading" class="muted" role="status">{text.loading}</p>

    <div id="account-content" class="account__content hidden">
      <div class="account__grid">
        <article class="plan-card" aria-labelledby="plan-title">
          <Film palette="coral" layout="streaks" class="plan-card__cover">
            <Waveform seed={text.title} width={200} height={44} class="plan-card__wave" />
          </Film>
          <div class="plan-card__body">
            <p class="plan-card__label">{text.planLabel}</p>
            <h2 class="plan-card__name" id="plan-title"><span id="plan-value"></span></h2>

            <dl class="plan-card__rows">
              <div id="trial-row" class="plan-row hidden">
                <dt class="plan-row__label"><Icon name="gift" size={16} class="" />{text.trialLabel}</dt>
                <dd class="plan-row__value">
                  <span id="trial-value" class="tabular"></span>
                  <progress id="trial-meter" class="meter hidden" aria-label={text.trialLabel} max="3" value="0"></progress>
                </dd>
              </div>
              <div id="subscription-row" class="plan-row hidden">
                <dt class="plan-row__label"><Icon name="card" size={16} class="" />{text.renewalLabel}</dt>
                <dd class="plan-row__value"><span id="subscription-value"></span></dd>
              </div>
              <div id="hours-card" class="plan-row hidden">
                <dt class="plan-row__label" id="hours-label"><Icon name="clock" size={16} class="" />{text.hoursLabel}</dt>
                <dd class="plan-row__value">
                  <span id="hours-value" class="tabular"></span>
                  <progress id="hours-meter" class="meter" aria-labelledby="hours-label" max="10" value="0"></progress>
                  <span class="small muted">{text.hoursNote}</span>
                </dd>
              </div>
            </dl>

            <div class="plan-card__actions">
              <button id="subscribe-button" class="button button--primary hidden" type="button">{text.subscribe}</button>
              <button id="manage-button" class="button button--secondary hidden" type="button">{text.manage}</button>
            </div>
            <p id="subscribe-note" class="small muted hidden">{text.subscribeNote}</p>
            <p id="manage-note" class="small muted hidden">{text.manageNote}</p>
          </div>
        </article>

        <div class="account__side">
          <article class="card side-card" aria-labelledby="app-title">
            <span class="icon-chip"><Icon name="laptop" size={20} class="" /></span>
            <h2 class="title-m" id="app-title">{text.appTitle}</h2>
            <p class="muted">{text.appText}</p>
            <p class="small muted">{common.requirementsShort}</p>
            <a class="button button--primary button--small" href={macDownloadUrl(siteConfig)}>
              <Icon name="apple" size={15} class="button__apple" />
              {common.downloadCta}
            </a>
          </article>

          <nav class="card side-card" aria-labelledby="help-title">
            <h2 class="title-m" id="help-title">{text.helpTitle}</h2>
            <ul class="help-links">
              {
                helpLinks.map((link) => (
                  <li>
                    <a class="help-links__link" href={link.href}>
                      {link.label}
                      <Icon name="arrow-right" size={16} class="" />
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>

      <section class="danger" aria-labelledby="danger-title">
        <div class="danger__text">
          <h2 class="title-m" id="danger-title">{text.dangerTitle}</h2>
          <p class="muted">{text.dangerText}</p>
        </div>
        <button id="delete-button" class="button button--danger" type="button">{text.deleteButton}</button>
      </section>
    </div>

    <div id="account-deleted" class="card deleted hidden" tabindex="-1" role="status">
      <h2 class="title-l">{text.deletedTitle}</h2>
      <p class="muted">{text.deletedText}</p>
      <p class="small muted">{text.deletedRedirect}</p>
      <a class="button button--primary" href={routes.home}>{text.backHome}</a>
    </div>
  </section>

  <dialog id="delete-dialog" class="dialog" aria-labelledby="dialog-title" data-confirm-word={text.confirmWord}>
    <form method="dialog" class="dialog__form">
      <h2 class="title-m" id="dialog-title">{text.dialogTitle}</h2>
      <p class="muted">{text.dialogText}</p>
      <div class="field">
        <label for="confirm-input">{text.confirmLabel}</label>
        <input id="confirm-input" class="input" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" />
      </div>
      <p id="delete-error" class="notice notice--error hidden" role="alert"></p>
      <div class="dialog__actions">
        <button id="cancel-delete" class="button button--secondary" type="button">{text.cancel}</button>
        <button id="confirm-delete" class="button button--danger-solid" type="button" disabled>{text.confirmDelete}</button>
      </div>
    </form>
  </dialog>
</Base>

<script>
  import "../client/account";
</script>

<style>
  .account {
    display: grid;
    gap: 20px;
    padding-top: clamp(40px, 6vw, 72px);
    max-width: 1040px;
  }

  .account__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 24px;
    margin-bottom: 8px;
  }

  .account__title {
    display: grid;
    gap: 14px;
  }

  .account__head-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .account__content {
    display: grid;
    gap: 20px;
  }

  .account__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }

  /* ---------- Plan kartı ---------- */

  .plan-card {
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--card);
    overflow: hidden;
  }

  .plan-card :global(.plan-card__cover) {
    display: grid;
    place-items: center;
    height: clamp(96px, 12vw, 128px);
    border-radius: 0;
  }

  .plan-card__body {
    display: grid;
    gap: 6px;
    padding: clamp(22px, 3.4vw, 36px);
  }

  .plan-card__label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  .plan-card__name {
    font-size: clamp(1.625rem, 3vw, 2.125rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .plan-card__rows {
    display: grid;
    margin: 18px 0 0;
    border-top: 1px solid var(--line);
  }

  .plan-row {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
    gap: 6px 20px;
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
  }

  .plan-row__label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
  }

  .plan-row__value {
    display: grid;
    gap: 10px;
    margin: 0;
    font-weight: 500;
  }

  .plan-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }

  .plan-card__actions:has(> .hidden + .hidden) {
    display: none;
  }

  .plan-card__body > .small {
    max-width: 34rem;
    margin-top: 6px;
  }

  /* ---------- Yan kartlar ---------- */

  .account__side {
    display: grid;
    gap: 20px;
  }

  .side-card {
    display: grid;
    justify-items: start;
    gap: 10px;
  }

  .side-card .icon-chip {
    margin-bottom: 4px;
  }

  .side-card .button {
    margin-top: 6px;
  }

  .help-links {
    display: grid;
    width: 100%;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .help-links li + li {
    border-top: 1px solid var(--line);
  }

  .help-links__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 12px;
    font-weight: 500;
    text-decoration: none;
  }

  .help-links__link :global(.icon) {
    color: var(--muted);
    transition: transform 160ms ease;
  }

  .help-links__link:hover :global(.icon) {
    transform: translateX(3px);
  }

  /* ---------- Hesap silme ---------- */

  .danger {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    margin-top: 28px;
    padding: clamp(20px, 3vw, 28px);
    border: 1px solid color-mix(in srgb, var(--danger) 28%, var(--line));
    border-radius: var(--radius-m);
    background: color-mix(in srgb, var(--danger) 4%, var(--card));
  }

  .danger__text {
    display: grid;
    gap: 8px;
    flex: 1 1 28rem;
    max-width: 44rem;
  }

  .danger__text p {
    font-size: 0.9375rem;
  }

  .deleted {
    display: grid;
    gap: 14px;
    justify-items: start;
  }

  .dialog {
    width: min(460px, 100% - 32px);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--card);
    color: var(--ink);
    box-shadow: var(--elevation);
  }

  .dialog::backdrop {
    background: light-dark(rgb(10 10 10 / 0.4), rgb(0 0 0 / 0.6));
  }

  .dialog__form {
    display: grid;
    gap: 16px;
    padding: 28px;
  }

  .dialog__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
  }

  @media (max-width: 860px) {
    .account__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .plan-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .dialog__actions .button {
      flex: 1 1 auto;
    }
  }
</style>
