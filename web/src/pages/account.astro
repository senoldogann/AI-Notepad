---
// Hesap sayfası, yukarıdan aşağı tek sütun: başlık ve çıkış; tek plan kartı (durgun film kapak, altında plan adı ve
// durum etiketi, tek durum satırı, denemede kalan toplantı ya da abonede aylık kullanım ölçeri ve duruma uyan eylem:
// abone olmayanda plan seçimi (yıllık seçili), davet kodu alanı ve Abone ol; abonede Aboneliği yönet; ücretsiz erişimde
// eylem yok); abonede davet kartı (kod, davet bağlantısını kopyalama, sayılar, ödülün tahmini tarihi); uygulamayı indirme
// ve yardım kartları yan yana; en altta varsayılan kapalı hesap silme alanı (<details>; onay penceresiyle). Değerler
// tarayıcıda `/v1/me` ve `/v1/referral`'dan doldurulur (src/client/account.ts); kimlikler scripts/e2e.ts ve
// scripts/screenshots.ts ile aynı tutulur.
import Base from "../layouts/Base.astro";
import { websiteCard } from "../lib/social";
import Film from "../components/Film.astro";
import Icon from "../components/Icon.astro";
import Waveform from "../components/Waveform.astro";
import { macDownloadUrl } from "../config";
import { type AccountCopy, type CommonCopy, type PlanOptionCopy, copy } from "../copy";
import { recommendedPlan } from "../lib/plans";
import { routes } from "../routes";
import { siteConfig } from "../site";

const text: AccountCopy = copy.account;
const common: CommonCopy = copy.common;
const helpLinks: readonly { readonly href: string; readonly label: string }[] = [
  { href: routes.contact, label: text.helpContact },
  { href: routes.privacy, label: common.nav.privacy },
  { href: routes.terms, label: common.nav.terms },
];
---

<Base page="account" meta={text.meta} indexed={false} social={websiteCard}>
  <section class="page account" id="account" data-sign-in-path={routes.signIn} data-home-path={routes.home}>
    <header class="account__head">
      <div class="account__title">
        <p class="eyebrow">{common.nav.account}</p>
        <h1 class="title-xl">{text.title}</h1>
      </div>
      <button id="signout-button" class="button button--secondary button--small" type="button">{text.signOut}</button>
    </header>

    <noscript><p class="notice notice--error">{text.noScript}</p></noscript>
    <p id="payment-done" class="notice notice--ok hidden" role="status">{text.paymentDone}</p>
    <div id="payment-done-signed-out" class="card paid hidden" role="status">
      <h2 class="title-m">{text.paymentDoneSignedOut.title}</h2>
      <p class="muted">{text.paymentDoneSignedOut.text}</p>
      <a class="text-link" href={routes.signIn}>{text.paymentDoneSignedOut.signIn}</a>
    </div>
    <p id="account-error" class="notice notice--error hidden" role="alert"></p>
    <p id="account-loading" class="muted" role="status">{text.loading}</p>

    <div id="account-content" class="account__content hidden">
      <article class="plan-card" aria-labelledby="plan-title">
        <Film palette="coral" layout="streaks" class="plan-card__cover">
          <Waveform seed={text.title} width={200} height={40} class="plan-card__wave" />
        </Film>
        <div class="plan-card__body">
          <div class="plan-card__head">
            <div class="plan-card__heading">
              <p class="plan-card__label">{text.planLabel}</p>
              <h2 class="plan-card__name" id="plan-title"><span id="plan-value"></span></h2>
            </div>
            <span id="plan-pill" class="pill hidden"></span>
          </div>
          <p id="plan-status" class="plan-card__status"></p>
          <progress id="trial-meter" class="meter hidden" aria-label={text.trialLabel} max="3" value="0"></progress>

          <div id="hours-card" class="usage hidden">
            <div class="usage__head">
              <span class="usage__label" id="hours-label"><Icon name="clock" size={16} class="" />{text.hoursLabel}</span>
              <span id="hours-value" class="usage__value tabular"></span>
            </div>
            <progress id="hours-meter" class="meter" aria-labelledby="hours-label" max="10" value="0"></progress>
            <p class="small muted">{text.hoursNote}</p>
          </div>

          <fieldset id="plan-choice" class="plan-choice hidden">
            <legend class="plan-choice__legend">{text.planChoiceLegend}</legend>
            <div class="plan-choice__options">
              {
                copy.pricing.plans.map((option: PlanOptionCopy) => (
                  <label class="plan-choice__option">
                    <input type="radio" name="plan" value={option.plan} checked={option.plan === recommendedPlan} />
                    <span class="plan-choice__text">
                      <span class="plan-choice__name">
                        {option.name}
                        {option.badge === null ? null : <span class="pill pill--ok">{option.badge}</span>}
                      </span>
                      <span class="plan-choice__price tabular">
                        {option.price} <span class="muted">{option.per}</span>
                      </span>
                      <span class="small muted">{option.detail}</span>
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <details id="invite" class="invite hidden">
            <summary class="invite__summary">
              {text.invite.summary}
              <Icon name="chevron-down" size={16} class="invite__chevron" />
            </summary>
            <div class="invite__body">
              <label class="invite__label" for="invite-input">{text.invite.label}</label>
              <div class="invite__row">
                <input
                  id="invite-input"
                  class="input invite__input"
                  type="text"
                  autocomplete="off"
                  autocapitalize="characters"
                  spellcheck="false"
                  maxlength="24"
                  placeholder={text.invite.placeholder}
                />
                <button id="invite-apply" class="button button--secondary button--small" type="button">{text.invite.apply}</button>
                <button id="invite-remove" class="button button--secondary button--small hidden" type="button">{text.invite.remove}</button>
              </div>
              <p id="invite-status" class="small hidden" role="status"></p>
            </div>
          </details>

          <div class="plan-card__actions">
            <button id="subscribe-button" class="button button--primary hidden" type="button">{text.subscribe}</button>
            <button id="manage-button" class="button button--secondary hidden" type="button">{text.manage}</button>
          </div>
          <p id="subscribe-note" class="plan-card__note small muted hidden">{text.subscribeNote}</p>
          <p id="manage-note" class="plan-card__note small muted hidden">{text.manageNote}</p>
        </div>
      </article>

      <article id="referral-card" class="card referral hidden" aria-labelledby="referral-title">
        <div class="referral__text">
          <h2 class="title-m" id="referral-title">{text.referral.title}</h2>
          <p class="muted">{text.referral.text}</p>
          <p id="referral-stats" class="small muted"></p>
          <a class="text-link" href={routes.invite}>{text.referral.howItWorks} <Icon name="arrow-right" size={16} class="" /></a>
        </div>
        <Film palette="rose" layout="clouds-right" class="referral__cover">
          <div id="referral-share" class="glass referral__share">
            <span class="referral__code-label">{text.referral.codeLabel}</span>
            <span id="referral-code" class="referral__code tabular"></span>
            <button id="referral-copy" class="button button--primary button--small referral__copy" type="button">{text.referral.copyLink}</button>
            <p id="referral-copied" class="referral__copied hidden" role="status">{text.referral.copied}</p>
          </div>
        </Film>
      </article>

      <div class="account__cards">
        <article class="card side-card" aria-labelledby="app-title">
          <span class="icon-chip"><Icon name="laptop" size={20} class="" /></span>
          <h2 class="title-m" id="app-title">{text.appTitle}</h2>
          <p class="muted">{text.appText}</p>
          <p class="small muted">{common.requirementsShort}</p>
          <a class="button button--primary button--small" href={macDownloadUrl(siteConfig, "account")}>
            <Icon name="apple" size={15} class="button__apple" />
            {common.downloadCta}
          </a>
        </article>

        <nav class="card side-card" aria-labelledby="help-title">
          <span class="icon-chip"><Icon name="message" size={20} class="" /></span>
          <h2 class="title-m" id="help-title">{text.helpTitle}</h2>
          <ul class="help-links">
            {
              helpLinks.map((link) => (
                <li>
                  <a class="help-links__link" href={link.href}>
                    {link.label}
                    <Icon name="arrow-right" size={16} class="" />
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      {/* Hesap silme: varsayılan kapalı, sakin bir satır; açılınca açıklama ve silme düğmesi görünür. */}
      <details class="danger">
        <summary class="danger__summary">
          <h2 class="danger__title" id="danger-title">{text.dangerTitle}</h2>
          <Icon name="chevron-down" size={18} class="danger__chevron" />
        </summary>
        <div class="danger__body">
          <p class="muted">{text.dangerText}</p>
          <button id="delete-button" class="button button--danger" type="button">{text.deleteButton}</button>
        </div>
      </details>
    </div>

    <div id="account-deleted" class="card deleted hidden" tabindex="-1" role="status">
      <h2 class="title-l">{text.deletedTitle}</h2>
      <p class="muted">{text.deletedText}</p>
      <p class="small muted">{text.deletedRedirect}</p>
      <a class="button button--primary" href={routes.home}>{text.backHome}</a>
    </div>
  </section>

  <dialog id="delete-dialog" class="dialog" aria-labelledby="dialog-title" data-confirm-word={text.confirmWord}>
    <form method="dialog" class="dialog__form">
      <h2 class="title-m" id="dialog-title">{text.dialogTitle}</h2>
      <p class="muted">{text.dialogText}</p>
      <div class="field">
        <label for="confirm-input">{text.confirmLabel}</label>
        <input id="confirm-input" class="input" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" />
      </div>
      <p id="delete-error" class="notice notice--error hidden" role="alert"></p>
      <div class="dialog__actions">
        <button id="cancel-delete" class="button button--secondary" type="button">{text.cancel}</button>
        <button id="confirm-delete" class="button button--danger-solid" type="button" disabled>{text.confirmDelete}</button>
      </div>
    </form>
  </dialog>
</Base>

<script>
  import "../client/account";
</script>

<style>
  .account {
    display: grid;
    gap: 20px;
    padding-top: clamp(40px, 6vw, 72px);
    max-width: 880px;
  }

  .account__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 24px;
    margin-bottom: 8px;
  }

  .account__title {
    display: grid;
    gap: 14px;
  }

  .account__content {
    display: grid;
    gap: 20px;
  }

  /* ---------- Plan kartı ---------- */

  .plan-card {
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--card);
    box-shadow: var(--elevation);
    overflow: hidden;
  }

  .plan-card :global(.plan-card__cover) {
    display: grid;
    place-items: center;
    height: clamp(88px, 11vw, 112px);
    border-radius: 0;
  }

  .plan-card :global(.plan-card__wave) {
    color: rgb(10 10 10 / 0.55);
  }

  .plan-card__body {
    display: grid;
    gap: 16px;
    padding: clamp(22px, 3.4vw, 36px);
  }

  .plan-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px 16px;
  }

  .plan-card__heading {
    display: grid;
    gap: 4px;
  }

  .plan-card__label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  .plan-card__name {
    font-size: clamp(1.625rem, 3vw, 2.125rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .plan-card__status {
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.5;
  }

  /* Abonenin aylık kullanımı: etiket ve değer bir satırda, altında ölçer ve sıfırlanma notu. */
  .usage {
    display: grid;
    gap: 10px;
    padding: 16px 18px;
    border-radius: var(--radius-m);
    background: var(--soft);
  }

  .usage__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 16px;
  }

  .usage__label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
  }

  .usage__value {
    font-weight: 600;
  }

  .plan-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
  }

  /* Eylem yoksa (ücretsiz erişim) boş satır yer kaplamaz. */
  .plan-card__actions:has(> .hidden + .hidden) {
    display: none;
  }

  .plan-card__note {
    max-width: 36rem;
    margin-top: -6px;
  }

  /* ---------- Plan seçimi ve davet kodu ---------- */

  .plan-choice {
    display: grid;
    gap: 12px;
    min-width: 0;
    margin: 6px 0 0;
    padding: 0;
    border: 0;
  }

  .plan-choice__legend {
    margin-bottom: 12px;
    padding: 0;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .plan-choice__options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .plan-choice__option {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    cursor: pointer;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .plan-choice__option:has(input:checked) {
    border-color: color-mix(in srgb, var(--ink) 60%, var(--line));
    background: color-mix(in srgb, var(--ink) 4%, var(--card));
  }

  .plan-choice__option:has(input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .plan-choice__option input {
    flex: none;
    margin: 3px 0 0;
    accent-color: var(--ink);
  }

  .plan-choice__text {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .plan-choice__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-weight: 600;
  }

  .plan-choice__price {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .plan-choice__price .muted {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .invite__summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .invite__summary::-webkit-details-marker {
    display: none;
  }

  .invite :global(.invite__chevron) {
    color: var(--muted);
    transition: transform 200ms ease;
  }

  .invite[open] :global(.invite__chevron) {
    transform: rotate(180deg);
  }

  .invite__body {
    display: grid;
    gap: 8px;
    margin-top: 12px;
  }

  .invite__label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
  }

  .invite__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .invite__input {
    flex: 1 1 12rem;
    max-width: 18rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .invite__input::placeholder {
    text-transform: none;
    letter-spacing: 0;
  }

  .invite__ok {
    color: var(--ok);
  }

  .invite__error {
    color: var(--danger);
  }

  /* ---------- Davet kartı: solda metin, sağda film üstünde kod ---------- */

  .referral {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 32px);
    align-items: center;
  }

  .referral__text {
    display: grid;
    justify-items: start;
    gap: 10px;
  }

  .referral :global(.referral__cover) {
    display: grid;
    place-items: center;
    min-height: 200px;
    padding: 24px;
    border-radius: var(--radius-m);
  }

  .referral__share {
    display: grid;
    justify-items: start;
    gap: 6px;
    width: min(100%, 18rem);
    padding: 18px 20px;
  }

  .referral__code-label {
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .referral__code {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.2;
  }

  .referral__share .button {
    margin-top: 6px;
  }

  /* Cam yüzey her temada açık kaldığından düğme hep koyu. */
  .referral__copy {
    background: #0a0a0a;
    color: #fafafa;
  }

  .referral__copy:hover {
    background: #262626;
  }

  /* Cam yüzey her temada açık: "kopyalandı" yazısı koyu yeşil kalır. */
  .referral__copied {
    font-size: 0.875rem;
    color: #2f7a55;
  }

  /* ---------- Uygulama ve yardım kartları ---------- */

  .account__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .side-card {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 10px;
  }

  .side-card .icon-chip {
    margin-bottom: 4px;
  }

  .side-card .button {
    margin-top: 6px;
  }

  .help-links {
    display: grid;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .help-links li + li {
    border-top: 1px solid var(--line);
  }

  .help-links__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 12px;
    font-weight: 500;
    text-decoration: none;
  }

  .help-links__link :global(.icon) {
    color: var(--muted);
    transition: transform 160ms ease;
  }

  .help-links__link:hover :global(.icon) {
    transform: translateX(3px);
  }

  /* ---------- Hesap silme ---------- */

  .danger {
    margin-top: 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--card);
    transition: border-color 200ms ease, background-color 200ms ease;
  }

  .danger[open] {
    border-color: color-mix(in srgb, var(--danger) 28%, var(--line));
    background: color-mix(in srgb, var(--danger) 4%, var(--card));
  }

  .danger__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px clamp(20px, 3vw, 28px);
    border-radius: inherit;
    cursor: pointer;
    list-style: none;
  }

  .danger__summary::-webkit-details-marker {
    display: none;
  }

  .danger__title {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }

  .danger :global(.danger__chevron) {
    flex: none;
    color: var(--muted);
    transition: transform 220ms ease;
  }

  .danger[open] :global(.danger__chevron) {
    transform: rotate(180deg);
  }

  .danger__body {
    display: grid;
    gap: 16px;
    justify-items: start;
    max-width: 44rem;
    padding: 0 clamp(20px, 3vw, 28px) clamp(20px, 3vw, 28px);
  }

  .danger__body p {
    font-size: 0.9375rem;
  }

  /* Açılış yüksekliği yumuşak (destekleyen tarayıcılarda yalnızca CSS; hareket azaltılmışsa anında). */
  @media (prefers-reduced-motion: no-preference) {
    .danger {
      interpolate-size: allow-keywords;
    }

    .danger::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 260ms ease,
        content-visibility 260ms allow-discrete;
    }

    .danger[open]::details-content {
      block-size: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .danger,
    .danger :global(.danger__chevron) {
      transition: none;
    }
  }

  .deleted,
  .paid {
    display: grid;
    gap: 14px;
    justify-items: start;
  }

  .dialog {
    width: min(460px, 100% - 32px);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--card);
    color: var(--ink);
    box-shadow: var(--elevation);
  }

  .dialog::backdrop {
    background: light-dark(rgb(10 10 10 / 0.4), rgb(0 0 0 / 0.6));
  }

  .dialog__form {
    display: grid;
    gap: 16px;
    padding: 28px;
  }

  .dialog__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
  }

  @media (max-width: 760px) {
    .referral,
    .account__cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .plan-choice__options {
      grid-template-columns: minmax(0, 1fr);
    }

    .dialog__actions .button {
      flex: 1 1 auto;
    }
  }
</style>
