---
// Hesap sayfası: plan, deneme, aylık kullanım, abonelik; Abone ol, Aboneliği yönet, çıkış ve hesap silme.
// Değerler tarayıcıda `/v1/me`'den doldurulur (src/client/account.ts).
import Base from "../layouts/Base.astro";
import Film from "../components/Film.astro";
import Icon from "../components/Icon.astro";
import Waveform from "../components/Waveform.astro";
import { type AccountCopy, copy } from "../copy";
import { routes } from "../routes";

const text: AccountCopy = copy.account;
---

<Base page="account" meta={text.meta} indexed={false}>
  <section class="page account" id="account" data-sign-in-path={routes.signIn} data-home-path={routes.home}>
    <Film palette="coral" layout="streaks" class="account__cover">
      <Waveform seed={text.title} width={240} height={52} class="account__wave" />
    </Film>
    <div class="account__head">
      <h1 class="title-l">{text.title}</h1>
      <button id="signout-button" class="button button--secondary button--small" type="button">{text.signOut}</button>
    </div>

    <noscript><p class="notice notice--error">{text.noScript}</p></noscript>
    <p id="payment-done" class="notice notice--ok hidden" role="status">{text.paymentDone}</p>
    <p id="account-error" class="notice notice--error hidden" role="alert"></p>
    <p id="account-loading" class="muted" role="status">{text.loading}</p>

    <div id="account-content" class="account__content hidden">
      <div class="stats">
        <div class="card stat">
          <p class="stat__label"><span class="icon-chip icon-chip--small"><Icon name="user" size={17} class="" /></span>{text.planLabel}</p>
          <p class="stat__value"><span id="plan-value"></span> <span id="plan-pill" class="pill"></span></p>
        </div>
        <div class="card stat">
          <p class="stat__label"><span class="icon-chip icon-chip--small"><Icon name="gift" size={17} class="" /></span>{text.trialLabel}</p>
          <p id="trial-value" class="stat__value tabular"></p>
        </div>
        <div class="card stat">
          <p class="stat__label"><span class="icon-chip icon-chip--small"><Icon name="clock" size={17} class="" /></span><span id="hours-label">{text.hoursLabel}</span></p>
          <p id="hours-value" class="stat__value tabular"></p>
          <progress id="hours-meter" class="meter" aria-labelledby="hours-label" max="10" value="0"></progress>
          <p class="small muted">{text.hoursNote}</p>
        </div>
        <div class="card stat">
          <p class="stat__label"><span class="icon-chip icon-chip--small"><Icon name="card" size={17} class="" /></span>{text.renewalLabel}</p>
          <p class="stat__value stat__value--text"><span id="subscription-pill" class="pill hidden"></span> <span id="subscription-value"></span></p>
        </div>
      </div>

      <div class="actions">
        <button id="subscribe-button" class="button button--primary hidden" type="button">{text.subscribe}</button>
        <button id="manage-button" class="button button--secondary hidden" type="button">{text.manage}</button>
        <p id="subscribe-note" class="small muted hidden">{text.subscribeNote}</p>
      </div>

      <section class="danger" aria-labelledby="danger-title">
        <h2 class="title-m" id="danger-title">{text.dangerTitle}</h2>
        <p class="muted">{text.dangerText}</p>
        <button id="delete-button" class="button button--danger" type="button">{text.deleteButton}</button>
      </section>
    </div>

    <div id="account-deleted" class="card deleted hidden" tabindex="-1" role="status">
      <h2 class="title-l">{text.deletedTitle}</h2>
      <p class="muted">{text.deletedText}</p>
      <p class="small muted">{text.deletedRedirect}</p>
      <a class="button button--primary" href={routes.home}>{text.backHome}</a>
    </div>
  </section>

  <dialog id="delete-dialog" class="dialog" aria-labelledby="dialog-title" data-confirm-word={text.confirmWord}>
    <form method="dialog" class="dialog__form">
      <h2 class="title-m" id="dialog-title">{text.dialogTitle}</h2>
      <p class="muted">{text.dialogText}</p>
      <div class="field">
        <label for="confirm-input">{text.confirmLabel}</label>
        <input id="confirm-input" class="input" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" />
      </div>
      <p id="delete-error" class="notice notice--error hidden" role="alert"></p>
      <div class="dialog__actions">
        <button id="cancel-delete" class="button button--secondary" type="button">{text.cancel}</button>
        <button id="confirm-delete" class="button button--danger-solid" type="button" disabled>{text.confirmDelete}</button>
      </div>
    </form>
  </dialog>
</Base>

<script>
  import "../client/account";
</script>

<style>
  .account {
    display: grid;
    gap: 20px;
    padding-top: clamp(28px, 5vw, 56px);
    max-width: 960px;
  }

  .account :global(.account__cover) {
    display: grid;
    place-items: center;
    height: clamp(120px, 16vw, 180px);
  }

  .account__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 12px;
  }

  .account__content {
    display: grid;
    gap: 28px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .stat {
    display: grid;
    align-content: start;
    gap: 8px;
  }

  .stat__label {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
  }

  .stat__value {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .stat__value--text {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .stat__value .pill {
    vertical-align: middle;
    letter-spacing: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }

  .danger {
    display: grid;
    gap: 10px;
    justify-items: start;
    margin-top: 24px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    max-width: 44rem;
  }

  .deleted {
    display: grid;
    gap: 14px;
    justify-items: start;
  }

  .dialog {
    width: min(460px, 100% - 32px);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--card);
    color: var(--ink);
    box-shadow: var(--elevation);
  }

  .dialog::backdrop {
    background: light-dark(rgb(10 10 10 / 0.4), rgb(0 0 0 / 0.6));
  }

  .dialog__form {
    display: grid;
    gap: 16px;
    padding: 28px;
  }

  .dialog__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
  }

  @media (max-width: 640px) {
    .stats {
      grid-template-columns: minmax(0, 1fr);
    }

    .dialog__actions .button {
      flex: 1 1 auto;
    }
  }
</style>
