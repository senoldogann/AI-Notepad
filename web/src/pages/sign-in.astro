---
// Giriş sayfası: Apple ile giriş ve Google ile giriş (resmî Google düğmesi). `?app=1&nonce=…` ile Mac uygulaması adına
// giriş yapılır (açılır pencere yok: Apple ve Google'a yönlendirilir, dönüş bu sayfaya `#` parçasıyla gelir) ve jeton
// uygulamaya iletilir. Betik: src/client/sign-in.ts.
import Base from "../layouts/Base.astro";
import { websiteCard } from "../lib/social";
import Film from "../components/Film.astro";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import Waveform from "../components/Waveform.astro";
import { copy, type CommonCopy, type SignInCopy } from "../copy";
import { pageUrl, routes } from "../routes";
import { siteConfig } from "../site";

const text: SignInCopy = copy.signIn;
const common: CommonCopy = copy.common;
---

<Base page="signIn" meta={text.meta} indexed={true} social={websiteCard}>
  <section class="page auth" id="signin" data-account-path={routes.account} data-redirect-uri={pageUrl("signIn", siteConfig.siteOrigin)}>
    <Film palette="violet" layout="clouds-right" class="auth__cover">
      <div class="glass auth__badge">
        <Logo size={44} />
        <p class="auth__tagline">{common.footer.tagline}</p>
        <Waveform seed={common.footer.tagline} width={150} height={32} class="auth__wave" />
      </div>
    </Film>

    <div class="auth__panel">
      <div id="signin-intro" class="auth__intro">
        <h1 class="title-l">{text.title}</h1>
        <p class="muted">{text.lead}</p>
      </div>
      <div id="signin-app-intro" class="auth__intro hidden">
        <h1 class="title-l">{text.appTitle}</h1>
        <p class="muted">{text.appLead}</p>
      </div>

      <noscript><p class="notice notice--error">{text.noScript}</p></noscript>
      <p id="signin-error" class="notice notice--error hidden" role="alert"></p>

      <div id="signin-panel" class="auth__forms">
        <div class="auth__apple">
          <button id="apple-button" class="button button--apple button--block" type="button" disabled>
            <Icon name="apple" size={17} class="button__apple" />
            {text.apple}
          </button>
        </div>
        <!-- Google'a yönlendiren düğme (site girişi ve uygulama adına giriş); renkli "G" Google'ın marka işaretidir. -->
        <button id="google-redirect-button" class="button button--google button--block" type="button" disabled>
          <svg class="button__google" viewBox="0 0 48 48" width="18" height="18" aria-hidden="true" focusable="false">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path>
          </svg>
          {text.google}
        </button>
      </div>

      <div id="signin-app-return" class="card app-return hidden" tabindex="-1" role="status">
        <span class="spinner" aria-hidden="true"></span>
        <h2 class="title-m">{text.appReturning}</h2>
        <p class="muted">{text.appReturningHelp}</p>
        <a id="signin-app-open" class="button button--primary" href={routes.signIn}>{text.appOpen}</a>
      </div>

      <p class="small muted legal">
        {text.legalBefore} <a href={routes.terms}>{common.nav.terms}</a>{" "}
        {text.legalBetween} <a href={routes.privacy}>{common.nav.privacy}</a>.
      </p>
    </div>
  </section>
</Base>

<script>
  import "../client/sign-in";
</script>

<style>
  .auth {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: stretch;
    padding-top: clamp(32px, 6vw, 72px);
  }

  .auth :global(.auth__cover) {
    display: grid;
    place-items: center;
    min-height: 480px;
    padding: 32px;
  }

  .auth__badge {
    display: grid;
    justify-items: center;
    gap: 14px;
    padding: 28px 32px;
    text-align: center;
  }

  .auth__tagline {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    max-width: 16ch;
  }

  .auth__badge :global(.auth__wave) {
    color: #4b3a6b;
    mix-blend-mode: normal;
    opacity: 0.6;
  }

  /* Google düğmesi en çok 400 px: Apple düğmesi ve panel aynı genişlikte. */
  .auth__panel {
    display: grid;
    align-content: center;
    gap: 18px;
    max-width: 400px;
    width: 100%;
    justify-self: center;
  }

  .auth__intro {
    display: grid;
    gap: 12px;
  }

  .auth__forms {
    display: grid;
    gap: 12px;
    margin-top: 8px;
  }

  /* Apple ve Google düğmeleri aynı yükseklikte (Google'ın büyük düğmesi 40 px) ve aynı hap biçiminde. */
  .button--apple {
    min-height: 40px;
    background: light-dark(#000, #fff);
    color: light-dark(#fff, #000);
    font-weight: 500;
  }

  .button--apple:hover {
    background: light-dark(#1f1f1f, #e8e8e8);
  }

  /* Google'ın düğme görünümü (açık: beyaz zemin, ince çerçeve; koyu: Google'ın koyu düğmesi), renkli "G". */
  .button--google {
    min-height: 40px;
    background: light-dark(#fff, #131314);
    color: light-dark(#1f1f1f, #e3e3e3);
    border: 1px solid light-dark(#747775, #8e918f);
    font-weight: 500;
    gap: 10px;
  }

  .button--google:hover {
    background: light-dark(#f8f9fa, #1f1f20);
  }

  .app-return {
    display: grid;
    gap: 12px;
    justify-items: start;
  }

  .legal a {
    color: var(--ink);
  }

  /* Döner gösterge yalnızca hareket azaltılmamışsa döner. */
  .spinner {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2.5px solid var(--line);
    border-top-color: var(--ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .spinner {
      animation: spin 900ms linear infinite;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 860px) {
    .auth {
      grid-template-columns: minmax(0, 1fr);
    }

    .auth :global(.auth__cover) {
      min-height: 200px;
      order: 2;
    }
  }
</style>
