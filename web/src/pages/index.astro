---
// Ana sayfa: metinler copy.ts'ten, gösterim src/components/Landing.astro'dadır (Fince sayfa `/fi` aynı gösterimi
// kendi metinleriyle kullanır).
import Base from "../layouts/Base.astro";
import Landing from "../components/Landing.astro";
import { websiteCard } from "../lib/social";
import { copy, type HomeCopy } from "../copy";

const text: HomeCopy = copy.home;
---

<Base page="home" meta={text.meta} indexed={true} social={websiteCard}>
  <Landing text={text} common={copy.common} page="home" />
</Base>
