---
// Ana sayfa: kahraman alanı (film kapak üstünde dönen ürün gösterimi), son toplantılar, ürün gerçekleri, kayan
// entegrasyon şeridi, uygulamanın gerçek ekranları, özellikler, entegrasyonlar (MCP dahil), gizlilik, fiyat, SSS.
import Base from "../layouts/Base.astro";
import AppShot, { type ShotCallout } from "../components/AppShot.astro";
import BrandTile from "../components/BrandTile.astro";
import Faq from "../components/Faq.astro";
import Film from "../components/Film.astro";
import HeroDemo from "../components/HeroDemo.astro";
import Icon from "../components/Icon.astro";
import MeetingCard from "../components/MeetingCard.astro";
import Waveform from "../components/Waveform.astro";
import { macDownloadUrl } from "../config";
import { copy, type CommonCopy, type HomeCopy } from "../copy";
import { type Brand, brands, marqueeBrands } from "../lib/brands";
import type { FilmLayout, FilmPalette } from "../lib/film";
import type { IconName } from "../lib/icons";
import { cyclic } from "../lib/list";
import { routes } from "../routes";
import { siteConfig } from "../site";
import askShot from "../assets/screenshots/ask.webp";
import homeShot from "../assets/screenshots/home.webp";
import liveShot from "../assets/screenshots/live.webp";
import noteShot from "../assets/screenshots/note.webp";

const text: HomeCopy = copy.home;
const common: CommonCopy = copy.common;
const downloadUrl: string = macDownloadUrl(siteConfig);
const covers: readonly { readonly palette: FilmPalette; readonly layout: FilmLayout }[] = [
  { palette: "coral", layout: "clouds-right" },
  { palette: "ocean", layout: "clouds-left" },
  { palette: "mint", layout: "streaks" },
  { palette: "violet", layout: "clouds-right" },
];
/** Gizlilik ızgarasının simgeleri (metinlerle aynı sırada). */
const trustIcons: readonly IconName[] = ["users", "laptop", "waveform", "sparkle", "globe", "check-circle"];
/** Özellik kartlarının başlık simgeleri. */
const featureIcons: Readonly<Record<keyof HomeCopy["features"], IconName>> = {
  live: "translate",
  tasks: "check-circle",
  missed: "rewind",
  ask: "search",
  followUp: "mail",
  templates: "note",
};
/** Not ekranındaki açıklama balonları (konumları stilde, note.webp'deki öğelere göre). */
const noteCallouts: readonly ShotCallout[] = [
  { text: text.noteCallouts.transcript, class: "note-callout--transcript", side: "right" },
  { text: text.noteCallouts.dueDate, class: "note-callout--due", side: "right" },
];
/** Entegrasyon gruplarının simgeleri (yapay zekâ grubu ayrı, geniş kartta; logolar kayan şeritte). */
const integrationGroups: readonly { readonly key: "notes" | "tasks" | "files"; readonly icon: IconName; readonly palette: FilmPalette }[] = [
  { key: "notes", icon: "message", palette: "rose" },
  { key: "tasks", icon: "check-circle", palette: "violet" },
  { key: "files", icon: "disk", palette: "mint" },
];
---

<Base page="home" meta={text.meta} indexed={true}>
  <section class="hero page">
    <div class="hero__text">
      <p class="eyebrow">{text.eyebrow}</p>
      <h1 class="display">{text.title}</h1>
      <p class="lead">{text.lead}</p>
      <div class="hero__actions">
        <a class="button button--primary" href={downloadUrl}>
          <Icon name="apple" size={16} class="button__apple" />
          {common.downloadCta}
        </a>
        <a class="button button--secondary" href={routes.pricing}>{text.secondaryCta}</a>
      </div>
      <ul class="hero__assurances small">
        {
          text.assurances.map((item: string) => (
            <li>
              <Icon name="check" size={15} class="hero__check" />
              {item}
            </li>
          ))
        }
        <li class="muted">{common.requirementsShort}</li>
      </ul>
    </div>

    <Film palette="sunset" layout="clouds-left" class="hero__cover">
      <HeroDemo demo={text.demo} />
    </Film>

    <section class="library" aria-label={text.library.label}>
      <h2 class="library__label">{text.library.label}</h2>
      <div class="library__grid">
        {
          text.library.meetings.map((meeting, index: number) => (
            <MeetingCard title={meeting.title} meta={meeting.meta} palette={cyclic(covers, index).palette} layout={cyclic(covers, index).layout} />
          ))
        }
      </div>
    </section>
  </section>

  <section class="page facts" aria-label={text.facts.label}>
    <ul class="facts__grid">
      <li class="fact reveal">
        <Film palette="mint" layout="clouds-right" class="fact__cover">
          <div class="glass fact__roster">
            <span class="fact__avatars">{text.facts.noBot.people.map((initial: string) => <span class="fact__avatar">{initial}</span>)}</span>
            <span class="fact__roster-note">{text.facts.noBot.note}</span>
          </div>
        </Film>
        <p class="fact__value">{text.facts.noBot.value}</p>
        <p class="fact__label muted">{text.facts.noBot.label}</p>
      </li>
      <li class="fact reveal">
        <Film palette="ocean" layout="clouds-left" class="fact__cover">
          <div class="glass fact__live">
            <span class="fact__status"><span class="fact__rec" aria-hidden="true" />{text.facts.live.status}</span>
            <Waveform seed={text.facts.live.line} width={112} height={22} class="fact__wave" />
            <span class="fact__line">{text.facts.live.line}</span>
          </div>
        </Film>
        <p class="fact__value">{text.facts.live.value}</p>
        <p class="fact__label muted">{text.facts.live.label}</p>
      </li>
      <li class="fact reveal">
        <Film palette="violet" layout="streaks" class="fact__cover">
          <ul class="fact__languages">{text.facts.languages.sample.map((language: string) => <li class="glass fact__language">{language}</li>)}</ul>
        </Film>
        <p class="fact__value tabular">{text.facts.languages.value}</p>
        <p class="fact__label muted">{text.facts.languages.label}</p>
      </li>
      <li class="fact reveal">
        <Film palette="coral" layout="clouds-left" class="fact__cover">
          <ul class="glass fact__tasks">
            {
              text.facts.tasks.sample.map((task: string) => (
                <li class="fact__task">
                  <span class="sample-tasks__box" aria-hidden="true" />
                  {task}
                </li>
              ))
            }
          </ul>
        </Film>
        <p class="fact__value">{text.facts.tasks.value}</p>
        <p class="fact__label muted">{text.facts.tasks.label}</p>
      </li>
    </ul>
  </section>

  <section class="marquee" aria-labelledby="marquee-label">
    <p class="marquee__label" id="marquee-label">{text.marqueeLabel}</p>
    <div class="marquee__viewport">
      <ul class="marquee__track">
        {
          [...marqueeBrands, ...marqueeBrands].map((brand: Brand, index: number) => (
            <li class="marquee__item" aria-hidden={index >= marqueeBrands.length ? "true" : undefined}>
              <BrandTile brand={brand} size="medium" />
              <span class="marquee__name">{brands[brand].name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section page showcase" aria-labelledby="showcase-title">
    <div class="section-head reveal">
      <p class="eyebrow">{text.showcase.eyebrow}</p>
      <h2 class="title-xl" id="showcase-title">{text.showcase.title}</h2>
      <p class="lead">{text.showcase.lead}</p>
    </div>

    <div class="showcase__grid">
      <AppShot
        image={noteShot}
        shot={text.showcase.note}
        palette="violet"
        layout="clouds-right"
        variant="window"
        widths={[720, 1200, 1680, 2160]}
        sizes="(max-width: 640px) 160vw, min(1040px, 86vw)"
        class="showcase__note reveal"
        callouts={noteCallouts}
      />
      <AppShot
        image={askShot}
        shot={text.showcase.ask}
        palette="coral"
        layout="clouds-left"
        variant="window"
        widths={[640, 960, 1360]}
        sizes="(max-width: 640px) 130vw, (max-width: 960px) 86vw, 680px"
        class="showcase__ask reveal"
        callouts={[]}
      />
      <AppShot
        image={liveShot}
        shot={text.showcase.live}
        palette="ocean"
        layout="clouds-right"
        variant="panel"
        widths={[360, 560, 840]}
        sizes="(max-width: 640px) 76vw, (max-width: 960px) 72vw, 320px"
        class="showcase__live reveal"
        callouts={[]}
      />
      <AppShot
        image={homeShot}
        shot={text.showcase.home}
        palette="mint"
        layout="streaks"
        variant="window"
        widths={[720, 1200, 1680, 2160]}
        sizes="(max-width: 640px) 120vw, min(1040px, 86vw)"
        class="showcase__home reveal"
        callouts={[]}
      />
    </div>
  </section>

  <section class="section page" id="features" aria-labelledby="features-title">
    <div class="section-head reveal">
      <p class="eyebrow">{text.featuresEyebrow}</p>
      <h2 class="title-xl" id="features-title">{text.featuresTitle}</h2>
      <p class="lead">{text.featuresLead}</p>
    </div>

    <div class="features">
      <article class="feature feature--wide reveal">
        <Film palette="ocean" layout="clouds-right" class="feature__cover">
          <div class="glass bubble-stack">
            <p class="bubble-stack__original">{text.features.live.original}</p>
            <p class="bubble-stack__translation">{text.features.live.translation}</p>
          </div>
        </Film>
        <h3 class="feature__title title-m"><span class="icon-chip icon-chip--small"><Icon name={featureIcons.live} size={18} class="" /></span>{text.features.live.title}</h3>
        <p class="muted">{text.features.live.text}</p>
      </article>

      <article class="feature feature--wide reveal">
        <Film palette="coral" layout="clouds-left" class="feature__cover">
          <ul class="glass sample-tasks">
            {
              text.features.tasks.sample.map((task: string) => (
                <li class="sample-tasks__item">
                  <span class="sample-tasks__box" aria-hidden="true" />
                  {task}
                </li>
              ))
            }
          </ul>
        </Film>
        <h3 class="feature__title title-m"><span class="icon-chip icon-chip--small"><Icon name={featureIcons.tasks} size={18} class="" /></span>{text.features.tasks.title}</h3>
        <p class="muted">{text.features.tasks.text}</p>
      </article>

      <article class="feature reveal">
        <Film palette="rose" layout="streaks" class="feature__cover">
          <div class="missed">
            <span class="glass missed__button">{text.features.missed.button}</span>
            <p class="glass missed__answer">{text.features.missed.answer}</p>
          </div>
        </Film>
        <h3 class="feature__title title-m"><span class="icon-chip icon-chip--small"><Icon name={featureIcons.missed} size={18} class="" /></span>{text.features.missed.title}</h3>
        <p class="muted">{text.features.missed.text}</p>
      </article>

      <article class="feature reveal">
        <Film palette="violet" layout="clouds-left" class="feature__cover">
          <div class="ask">
            <p class="glass ask__question">{text.features.ask.question}</p>
            <p class="ask__source">{text.features.ask.source}</p>
          </div>
        </Film>
        <h3 class="feature__title title-m"><span class="icon-chip icon-chip--small"><Icon name={featureIcons.ask} size={18} class="" /></span>{text.features.ask.title}</h3>
        <p class="muted">{text.features.ask.text}</p>
      </article>

      <article class="feature reveal">
        <Film palette="mint" layout="clouds-right" class="feature__cover">
          <div class="follow-up">
            <span class="glass follow-up__recipe"><Icon name="sparkle" size={14} class="" />{text.features.followUp.recipe}</span>
            <div class="glass follow-up__mail">
              <p class="follow-up__subject">{text.features.followUp.subject}</p>
              {text.features.followUp.lines.map((line: string) => <p class="follow-up__line">{line}</p>)}
            </div>
          </div>
        </Film>
        <h3 class="feature__title title-m"><span class="icon-chip icon-chip--small"><Icon name={featureIcons.followUp} size={18} class="" /></span>{text.features.followUp.title}</h3>
        <p class="muted">{text.features.followUp.text}</p>
      </article>

      <article class="feature reveal">
        <Film palette="sunset" layout="streaks" class="feature__cover">
          <ul class="templates">
            {
              text.features.templates.sample.map((template: string) => (
                <li class="glass templates__item">{template}</li>
              ))
            }
          </ul>
        </Film>
        <h3 class="feature__title title-m"><span class="icon-chip icon-chip--small"><Icon name={featureIcons.templates} size={18} class="" /></span>{text.features.templates.title}</h3>
        <p class="muted">{text.features.templates.text}</p>
      </article>
    </div>
  </section>

  <section class="section page" id="integrations" aria-labelledby="integrations-title">
    <div class="section-head reveal">
      <p class="eyebrow">{text.integrations.eyebrow}</p>
      <h2 class="title-xl" id="integrations-title">{text.integrations.title}</h2>
      <p class="lead">{text.integrations.lead}</p>
    </div>

    <div class="integrations">
      <article class="card integration integration--ai reveal">
        <div class="integration__text">
          <h3 class="integration__title"><Film palette="sunset" layout="clouds-left" class="integration__badge"><Icon name="sparkle" size={20} class="" /></Film>{text.integrations.ai.title}</h3>
          <p class="muted">{text.integrations.ai.text}</p>
        </div>
        <Film palette="sunset" layout="clouds-right" class="integration__cover">
          <div class="glass mcp-chat">
            <div class="mcp-chat__label"><BrandTile brand="claude" size="small" />{text.integrations.mcpDemo.label}</div>
            <p class="mcp-chat__question">{text.integrations.mcpDemo.question}</p>
            <p class="mcp-chat__tool"><Icon name="search" size={13} class="" />{text.integrations.mcpDemo.tool}</p>
            <p class="mcp-chat__answer">{text.integrations.mcpDemo.answerLead}</p>
            <ul class="mcp-chat__list">{text.integrations.mcpDemo.answer.map((item: string) => <li>{item}</li>)}</ul>
            <p class="mcp-chat__source">{text.integrations.mcpDemo.source}</p>
          </div>
        </Film>
      </article>

      {
        integrationGroups.map((group) => (
          <article class:list={["card integration reveal", `integration--${group.palette}`]}>
            <h3 class="integration__title">
              <Film palette={group.palette} layout="clouds-right" class="integration__badge">
                <Icon name={group.icon} size={20} class="" />
              </Film>
              {text.integrations[group.key].title}
            </h3>
            <p class="muted">{text.integrations[group.key].text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section page" aria-labelledby="trust-title">
    <div class="section-head reveal">
      <p class="eyebrow">{text.trust.eyebrow}</p>
      <h2 class="title-xl" id="trust-title">{text.trust.title}</h2>
      <p class="lead">{text.trust.lead}</p>
    </div>
    <ul class="trust">
      {
        text.trust.items.map((item, index: number) => (
          <li class="trust__item reveal">
            <span class="icon-chip icon-chip--small"><Icon name={trustIcons[index] ?? "lock"} size={18} class="" /></span>
            <h3 class="trust__title">{item.title}</h3>
            <p class="muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
    <a class="text-link trust__link reveal" href={routes.privacy}>{text.trust.link} <Icon name="arrow-right" size={16} class="" /></a>
  </section>

  <section class="section page" aria-labelledby="pricing-title">
    <div class="pricing-band reveal">
      <div class="pricing-band__text">
        <h2 class="title-xl" id="pricing-title">{text.pricingTitle}</h2>
        <p class="lead">{text.pricingLead}</p>
        <a class="text-link" href={routes.pricing}>{text.pricingCta} <Icon name="arrow-right" size={16} class="" /></a>
      </div>
      <Film palette="violet" layout="streaks" class="pricing-band__cover">
        <div class="glass price-tag">
          <p class="price-tag__amount"><span class="tabular">{common.price}</span><span class="price-tag__per">{common.perMonth}</span></p>
          <p class="price-tag__offer">{common.offer}</p>
          <p class="price-tag__tax">{common.renewalNote}</p>
        </div>
      </Film>
    </div>
  </section>

  <section class="section page" aria-labelledby="faq-title">
    <div class="faq-layout">
      <h2 class="title-l reveal" id="faq-title">{text.faqTitle}</h2>
      <Faq items={text.faq} />
    </div>
  </section>

  <section class="page final reveal" aria-labelledby="final-title">
    <Film palette="ocean" layout="clouds-left" class="final__cover">
      <div class="final__content">
        <Waveform seed={text.finalTitle} width={180} height={48} class="final__wave" />
        <h2 class="title-xl" id="final-title">{text.finalTitle}</h2>
        <p class="final__lead">{text.finalLead}</p>
        <div class="hero__actions final__actions">
          <a class="button button--primary button--on-film" href={downloadUrl}>
            <Icon name="apple" size={16} class="button__apple" />
            {common.downloadCta}
          </a>
          <a class="button button--glass" href={routes.download}>{common.requirementsShort}</a>
        </div>
      </div>
    </Film>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(48px, 8vw, 104px);
  }

  .hero__text {
    display: grid;
    gap: 22px;
    max-width: 52rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  /* Düğmelerin altındaki güvenceler: küçük onay işaretli, tek satırda akan liste. */
  .hero__assurances {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__assurances li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
  }

  .hero__assurances :global(.hero__check) {
    color: var(--accent);
  }

  /* Ürün gerçekleri: dört sütun, büyük değer ve kısa açıklama; ince ayraçlarla sakin bir şerit. */
  /* Ürün gerçekleri: dört kart, her birinde durgun film kapak üstünde küçük bir örnek ve altında büyük değer. */
  .facts {
    margin-top: clamp(40px, 6vw, 72px);
  }

  .facts__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 1.6vw, 20px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fact {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 8px 8px 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--card);
    box-shadow: var(--elevation);
  }

  .fact :global(.fact__cover) {
    display: grid;
    place-items: center;
    aspect-ratio: 5 / 3.4;
    padding: 14px;
    margin-bottom: 12px;
    border-radius: calc(var(--radius-m) - 6px);
  }

  .fact__value {
    margin: 0;
    padding: 0 14px;
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .fact__label {
    margin: 0;
    padding: 0 14px;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .fact__roster,
  .fact__live,
  .fact__tasks {
    display: grid;
    gap: 8px;
    padding: 12px 14px;
    border-radius: 16px;
    font-size: 0.8125rem;
  }

  .fact__roster {
    justify-items: center;
  }

  .fact__avatars {
    display: flex;
  }

  .fact__avatar {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin-left: -6px;
    border-radius: 50%;
    border: 2px solid #ffffff;
    background: #e7efe9;
    color: #1d2a23;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .fact__avatar:first-child {
    margin-left: 0;
  }

  .fact__avatar:nth-child(2) {
    background: #e6ecf6;
  }

  .fact__avatar:nth-child(3) {
    background: #f6e9e1;
  }

  .fact__avatar:nth-child(4) {
    background: #eee7f5;
  }

  .fact__roster-note {
    font-weight: 600;
  }

  .fact__live {
    max-width: 220px;
  }

  .fact__status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }

  .fact__rec {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #e5484d;
  }

  .fact__live :global(.fact__wave) {
    color: #4f7cb8;
  }

  .fact__line {
    line-height: 1.35;
  }

  .fact__languages {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    max-width: 230px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fact__language {
    padding: 5px 11px;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .fact__tasks {
    margin: 0;
    list-style: none;
  }

  .fact__task {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .fact__task .sample-tasks__box {
    width: 14px;
    height: 14px;
    border-radius: 4px;
  }

  /* Kayan entegrasyon şeridi: liste iki kez yazılır, iz yarısı kadar kayar ve dikiş görünmez. Yalnızca `transform`
     hareket eder (karolar bir kez çizilir); üstüne gelince durur, hareket azaltılmışsa kaymaz ve tek liste ortalanır. */
  .marquee {
    display: grid;
    gap: 18px;
    margin-top: clamp(48px, 7vw, 88px);
  }

  .marquee__label {
    margin: 0;
    text-align: center;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
  }

  .marquee__viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: marquee 90s linear infinite;
  }

  .marquee__viewport:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-right: clamp(28px, 4vw, 48px);
  }

  .marquee__name {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

