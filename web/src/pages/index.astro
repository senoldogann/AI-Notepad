---
// Ana sayfa: kahraman alanı (film kapak üstünde dönen ürün gösterimi), son toplantılar, uygulamanın gerçek ekranları,
// özellikler, üç adım, fiyat, SSS.
import Base from "../layouts/Base.astro";
import AppShot from "../components/AppShot.astro";
import BrandLogo from "../components/BrandLogo.astro";
import Faq from "../components/Faq.astro";
import Film from "../components/Film.astro";
import HeroDemo from "../components/HeroDemo.astro";
import Icon from "../components/Icon.astro";
import MeetingCard from "../components/MeetingCard.astro";
import Waveform from "../components/Waveform.astro";
import { macDownloadUrl } from "../config";
import { copy, type CommonCopy, type HomeCopy } from "../copy";
import { type Brand, integrationBrands } from "../lib/brands";
import type { FilmLayout, FilmPalette } from "../lib/film";
import type { IconName } from "../lib/icons";
import { cyclic } from "../lib/list";
import { routes } from "../routes";
import { siteConfig } from "../site";
import askShot from "../assets/screenshots/ask.webp";
import homeShot from "../assets/screenshots/home.webp";
import liveShot from "../assets/screenshots/live.webp";
import noteShot from "../assets/screenshots/note.webp";

const text: HomeCopy = copy.home;
const common: CommonCopy = copy.common;
const downloadUrl: string = macDownloadUrl(siteConfig);
const covers: readonly { readonly palette: FilmPalette; readonly layout: FilmLayout }[] = [
  { palette: "coral", layout: "clouds-right" },
  { palette: "ocean", layout: "clouds-left" },
  { palette: "mint", layout: "streaks" },
  { palette: "violet", layout: "clouds-right" },
];
/** Gizlilik ızgarasının simgeleri (metinlerle aynı sırada). */
const trustIcons: readonly IconName[] = ["users", "laptop", "waveform", "sparkle", "globe", "check-circle"];
/** Özellik kartlarının başlık simgeleri. */
const featureIcons: Readonly<Record<keyof HomeCopy["features"], IconName>> = {
  live: "translate",
  tasks: "check-circle",
  missed: "rewind",
  ask: "search",
  integrations: "plug",
  privacy: "lock",
};
---

<Base page="home" meta={text.meta} indexed={true}>
  <section class="hero page">
    <div class="hero__text">
      <p class="eyebrow">{text.eyebrow}</p>
      <h1 class="display">{text.title}</h1>
      <p class="lead">{text.lead}</p>
      <div class="hero__actions">
        <a class="button button--primary" href={downloadUrl}>
          <Icon name="apple" size={16} class="button__apple" />
          {common.downloadCta}
        </a>
        <a class="button button--secondary" href={routes.pricing}>{text.secondaryCta}</a>
      </div>
      <ul class="hero__assurances small">
        {
          text.assurances.map((item: string) => (
            <li>
              <Icon name="check" size={15} class="hero__check" />
              {item}
            </li>
          ))
        }
        <li class="muted">{common.requirementsShort}</li>
      </ul>
    </div>

    <Film palette="sunset" layout="clouds-left" class="hero__cover">
      <HeroDemo demo={text.demo} />
    </Film>

    <section class="library" aria-label={text.library.label}>
      <h2 class="library__label">{text.library.label}</h2>
      <div class="library__grid">
        {
          text.library.meetings.map((meeting, index: number) => (
            <MeetingCard title={meeting.title} meta={meeting.meta} palette={cyclic(covers, index).palette} layout={cyclic(covers, index).layout} />
          ))
        }
      </div>
    </section>
  </section>

  <section class="page facts reveal" aria-label={text.featuresEyebrow}>
    <dl class="facts__grid">
      {
        text.facts.map((fact) => (
          <div class="facts__item">
            <dt class="facts__value">{fact.value}</dt>
            <dd class="facts__label muted">{fact.label}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section page showcase" aria-labelledby="showcase-title">
    <div class="section-head reveal">
      <p class="eyebrow">{text.showcase.eyebrow}</p>
      <h2 class="title-xl" id="showcase-title">{text.showcase.title}</h2>
      <p class="lead">{text.showcase.lead}</p>
    </div>

    <div class="showcase__grid">
      <AppShot
        image={noteShot}
        shot={text.showcase.note}
        palette="violet"
        layout="clouds-right"
        variant="window"
        widths={[720, 1200, 1680, 2160]}
        sizes="(max-width: 640px) 160vw, min(1040px, 86vw)"
        class="showcase__note reveal"
      />
      <AppShot
        image={askShot}
        shot={text.showcase.ask}
        palette="coral"
        layout="clouds-left"
        variant="window"
        widths={[640, 960, 1360]}
        sizes="(max-width: 640px) 130vw, (max-width: 960px) 86vw, 680px"
        class="showcase__ask reveal"
      />
      <AppShot
        image={liveShot}
        shot={text.showcase.live}
        palette="ocean"
        layout="clouds-right"
        variant="panel"
        widths={[360, 560, 840]}
        sizes="(max-width: 640px) 76vw, (max-width: 960px) 72vw, 320px"
        class="showcase__live reveal"
      />
      <AppShot
        image={homeShot}
        shot={text.showcase.home}
        palette="mint"
        layout="streaks"
        variant="window"
        widths={[720, 1200, 1680, 2160]}
        sizes="(max-width: 640px) 120vw, min(1040px, 86vw)"
        class="showcase__home reveal"
      />
    </div>
  </section>

  <section class="section page" id="features" aria-labelledby="features-title">
    <div class="section-head reveal">
      <p class="eyebrow">{text.featuresEyebrow}</p>
      <h2 class="title-xl" id="features-title">{text.featuresTitle}</h2>
      <p class="lead">{text.featuresLead}</p>
    </div>

    <div class="features">
      <article class="feature feature--wide reveal">
        <Film palette="ocean" layout="clouds-right" class="feature__cover">
          <div class="glass bubble-stack">
            <p class="bubble-stack__original">{text.features.live.original}</p>
            <p class="bubble-stack__translation">{text.features.live.translation}</p>
          </div>
        </Film>
        <h3 class="feature__title title-m"><span class="icon-chip icon-chip--small"><Icon name={featureIcons.live} size={18} class="" /></span>{text.features.live.title}</h3>
        <p class="muted">{text.features.live.text}</p>
      </article>

      <article class="feature feature--wide reveal">
        <Film palette="coral" layout="clouds-left" class="feature__cover">
          <ul class="glass sample-tasks">
            {
              text.features.tasks.sample.map((task: string) => (
                <li class="sample-tasks__item">
                  <span class="sample-tasks__box" aria-hidden="true" />
                  {task}
                </li>
              ))
            }
          </ul>
        </Film>
        <h3 class="feature__title title-m"><span class="icon-chip icon-chip--small"><Icon name={featureIcons.tasks} size={18} class="" /></span>{text.features.tasks.title}</h3>
        <p class="muted">{text.features.tasks.text}</p>
      </article>

      <article class="feature reveal">
        <Film palette="rose" layout="streaks" class="feature__cover">
          <div class="missed">
            <span class="glass missed__button">{text.features.missed.button}</span>
            <p class="glass missed__answer">{text.features.missed.answer}</p>
          </div>
        </Film>
        <h3 class="feature__title title-m"><span class="icon-chip icon-chip--small"><Icon name={featureIcons.missed} size={18} class="" /></span>{text.features.missed.title}</h3>
        <p class="muted">{text.features.missed.text}</p>
      </article>

      <article class="feature reveal">
        <Film palette="violet" layout="clouds-left" class="feature__cover">
          <div class="ask">
            <p class="glass ask__question">{text.features.ask.question}</p>
            <p class="ask__source">{text.features.ask.source}</p>
          </div>
        </Film>
        <h3 class="feature__title title-m"><span class="icon-chip icon-chip--small"><Icon name={featureIcons.ask} size={18} class="" /></span>{text.features.ask.title}</h3>
        <p class="muted">{text.features.ask.text}</p>
      </article>

      <article class="feature reveal">
        <Film palette="mint" layout="clouds-right" class="feature__cover">
          <ul class="logos">
            {
              integrationBrands.map((brand: Brand) => (
                <li class="glass logos__tile">
                  <BrandLogo brand={brand} size={22} />
                </li>
              ))
            }
          </ul>
        </Film>
        <h3 class="feature__title title-m"><span class="icon-chip icon-chip--small"><Icon name={featureIcons.integrations} size={18} class="" /></span>{text.features.integrations.title}</h3>
        <p class="muted">{text.features.integrations.text}</p>
      </article>

      <article class="feature reveal">
        <Film palette="sunset" layout="streaks" class="feature__cover">
          <p class="glass privacy-badge">
            <Icon name="lock" size={18} class="" />
            {text.features.privacy.badge}
          </p>
        </Film>
        <h3 class="feature__title title-m"><span class="icon-chip icon-chip--small"><Icon name={featureIcons.privacy} size={18} class="" /></span>{text.features.privacy.title}</h3>
        <p class="muted">{text.features.privacy.text}</p>
      </article>
    </div>
  </section>

  <section class="section page" aria-labelledby="trust-title">
    <div class="section-head reveal">
      <p class="eyebrow">{text.trust.eyebrow}</p>
      <h2 class="title-xl" id="trust-title">{text.trust.title}</h2>
      <p class="lead">{text.trust.lead}</p>
    </div>
    <ul class="trust">
      {
        text.trust.items.map((item, index: number) => (
          <li class="trust__item reveal">
            <span class="icon-chip icon-chip--small"><Icon name={trustIcons[index] ?? "lock"} size={18} class="" /></span>
            <h3 class="trust__title">{item.title}</h3>
            <p class="muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
    <a class="text-link trust__link reveal" href={routes.privacy}>{text.trust.link} <Icon name="arrow-right" size={16} class="" /></a>
  </section>

  <section class="section section--tinted" aria-labelledby="steps-title">
    <div class="page">
      <h2 class="title-l reveal" id="steps-title">{text.stepsTitle}</h2>
      <ol class="steps">
        {
          text.steps.map((step, index: number) => (
            <li class="step reveal">
              <span class="step__number tabular" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="title-m">{step.title}</h3>
              <p class="muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section page" aria-labelledby="pricing-title">
    <div class="pricing-band reveal">
      <div class="pricing-band__text">
        <h2 class="title-xl" id="pricing-title">{text.pricingTitle}</h2>
        <p class="lead">{text.pricingLead}</p>
        <a class="text-link" href={routes.pricing}>{text.pricingCta} <Icon name="arrow-right" size={16} class="" /></a>
      </div>
      <Film palette="violet" layout="streaks" class="pricing-band__cover">
        <div class="glass price-tag">
          <p class="price-tag__amount"><span class="tabular">{common.price}</span><span class="price-tag__per">{common.perMonth}</span></p>
          <p class="price-tag__offer">{common.offer}</p>
          <p class="price-tag__tax">{common.renewalNote}</p>
        </div>
      </Film>
    </div>
  </section>

  <section class="section page" aria-labelledby="faq-title">
    <div class="faq-layout">
      <h2 class="title-l reveal" id="faq-title">{text.faqTitle}</h2>
      <Faq items={text.faq} />
    </div>
  </section>

  <section class="page final reveal" aria-labelledby="final-title">
    <Film palette="ocean" layout="clouds-left" class="final__cover">
      <div class="final__content">
        <Waveform seed={text.finalTitle} width={180} height={48} class="final__wave" />
        <h2 class="title-xl" id="final-title">{text.finalTitle}</h2>
        <p class="final__lead">{text.finalLead}</p>
        <div class="hero__actions final__actions">
          <a class="button button--primary button--on-film" href={downloadUrl}>
            <Icon name="apple" size={16} class="button__apple" />
            {common.downloadCta}
          </a>
          <a class="button button--glass" href={routes.download}>{common.requirementsShort}</a>
        </div>
      </div>
    </Film>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(48px, 8vw, 104px);
  }

  .hero__text {
    display: grid;
    gap: 22px;
    max-width: 52rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  /* Düğmelerin altındaki güvenceler: küçük onay işaretli, tek satırda akan liste. */
  .hero__assurances {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__assurances li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
  }

  .hero__assurances :global(.hero__check) {
    color: var(--accent);
  }

  /* Ürün gerçekleri: dört sütun, büyük değer ve kısa açıklama; ince ayraçlarla sakin bir şerit. */
  .facts {
    margin-top: clamp(40px, 6vw, 72px);
  }

  .facts__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .facts__item {
    display: grid;
    gap: 6px;
    padding: 24px 24px 26px;
  }

  .facts__item + .facts__item {
    border-left: 1px solid var(--line);
  }

  .facts__value {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .facts__label {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  /* Gizlilik ızgarası: üç sütun, kartsız sakin hücreler. */
  .trust {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px 40px;
    margin: clamp(32px, 4vw, 48px) 0 0;
    padding: 0;
    list-style: none;
  }

  .trust__item {
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .trust__title {
    margin: 4px 0 0;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .trust__item p {
    margin: 0;
  }

  .trust__link {
    display: inline-flex;
    margin-top: 32px;
  }

  @media (max-width: 860px) {
    .facts__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .facts__item:nth-child(3) {
      border-left: 0;
    }

    .facts__item:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }

    .trust {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }

  /* Gösterim kapağı: gradyan durgun; doygunluk filtresi kaldırılır ki animasyonlu içerik her karede filtrelenmesin. */
  .hero :global(.hero__cover) {
    margin-top: clamp(40px, 6vw, 72px);
    min-height: clamp(380px, 46vw, 560px);
    display: grid;
    align-items: center;
    filter: none;
  }

  .library {
    margin-top: clamp(28px, 4vw, 44px);
  }

  .library__label {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--muted);
    margin-bottom: 16px;
  }

  .library__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 24px);
  }

  /* Gerçek ekranlar: üstte geniş not, ortada Sor ve canlı panel yan yana (aynı yükseklik), altta ana sayfa. */
  .showcase {
    padding-bottom: 0;
  }

  .showcase__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(28px, 3.4vw, 44px) clamp(16px, 2.2vw, 28px);
  }

  .showcase__grid > :global(*) {
    grid-column: 1 / -1;
  }

  /* Sor penceresi kartın içinde eşit boşlukla süzülür; satırın yüksekliğini o belirler. */
  .showcase__grid > :global(.showcase__ask) {
    grid-column: span 8;
    --shot-ratio: 3 / 2;
  }

  /* Panel Sor kartının yüksekliğine uyar ve alttan kesilir. */
  .showcase__grid > :global(.showcase__live) {
    grid-column: span 4;
    grid-template-rows: minmax(0, 1fr) auto;
  }

  .showcase__grid > :global(.showcase__live .shot__cover) {
    aspect-ratio: auto;
    height: 100%;
  }

  /* Geniş pencereler alt kenarda kesilir. */
  .showcase__grid > :global(.showcase__note) {
    --shot-ratio: 16 / 9;
  }

  .showcase__grid > :global(.showcase__home) {
    --shot-ratio: 16 / 8.5;
  }

  /* Özellikler: üstte iki geniş, altta dört kart; başlıklar kapakların altında, başlığın önünde simge. */
  .features {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(28px, 3.4vw, 44px) clamp(16px, 2.2vw, 28px);
  }

  .feature {
    grid-column: span 3;
    display: grid;
    align-content: start;
    gap: 10px;
    min-width: 0;
  }

  .feature--wide {
    grid-column: span 6;
  }

  .feature :global(.feature__cover) {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    padding: 20px;
    margin-bottom: 8px;
    border-radius: var(--radius-m);
  }

  .feature--wide :global(.feature__cover) {
    aspect-ratio: 16 / 9;
    padding: 28px;
  }

  .feature__title {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .bubble-stack {
    display: grid;
    gap: 10px;
    padding: 18px 22px;
    max-width: 380px;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .bubble-stack__translation {
    padding-top: 10px;
    border-top: 1px solid rgb(10 10 10 / 0.1);
    color: #3a3a3a;
  }

  .bubble-stack__translation::before {
    content: "↳ ";
    color: #8ea3e6;
    font-weight: 600;
  }

  .sample-tasks {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 18px 22px;
    min-width: min(100%, 280px);
    list-style: none;
    font-size: 0.9375rem;
  }

  .sample-tasks__item {
    display: flex;
    gap: 10px;
    align-items: center;
    line-height: 1.4;
  }

  .sample-tasks__box {
    flex: none;
    width: 16px;
    height: 16px;
    border-radius: 5px;
    border: 1.5px solid rgb(10 10 10 / 0.35);
  }

  .missed,
  .ask {
    display: grid;
    gap: 10px;
    justify-items: center;
    text-align: center;
  }

  .missed__button {
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .missed__answer,
  .ask__question {
    padding: 12px 16px;
    border-radius: 16px;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .ask__source {
    font-size: 0.75rem;
    font-weight: 500;
    color: #2a2238;
  }

  /* Entegrasyon logoları: tek renk, cam karolar, 4 × 2. */
  .logos {
    display: grid;
    grid-template-columns: repeat(4, 48px);
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .logos__tile {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    color: #1d2a23;
  }

  .privacy-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    /* Dar kartlarda iki satıra iner; köşe yarıçapı iki durumda da yumuşak kalır. */
    border-radius: 22px;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.35;
    text-wrap: balance;
  }

  .section--tinted {
    background: var(--soft);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
    margin: clamp(32px, 4vw, 52px) 0 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    align-content: start;
    gap: 10px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .step__number {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
  }

  .pricing-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }

  .pricing-band__text {
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  .pricing-band :global(.pricing-band__cover) {
    display: grid;
    place-items: center;
    min-height: 340px;
    padding: 28px;
  }

  .price-tag {
    display: grid;
    gap: 6px;
    padding: 26px 30px;
    width: min(100%, 340px);
  }

  .price-tag__amount {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: 2.75rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .price-tag__per {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
    color: #5f5f5f;
  }

  .price-tag__offer {
    font-weight: 500;
  }

  .price-tag__tax {
    font-size: 0.8125rem;
    color: #5f5f5f;
  }

  .faq-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: start;
  }

  .final {
    padding-bottom: clamp(24px, 4vw, 48px);
  }

  .final :global(.final__cover) {
    padding: clamp(48px, 8vw, 112px) clamp(24px, 6vw, 80px);
  }

  .final__content {
    display: grid;
