---
// Blog kartı (dizin ve yazı sonundaki "blogdan daha fazlası"): kapak, altında başlık bağlantısı, özet, tarih ve okuma
// süresi. Kapaktaki başlık süstür (`aria-hidden`): ekran okuyucu başlığı bağlantıdan bir kez okur; tüm kart tıklanır.
import BlogCover from "./BlogCover.astro";
import { copy } from "../copy";
import { type BlogPost, publishedIso, publishedText } from "../lib/blog";
import { blogPostPath } from "../routes";

interface Props {
  readonly post: BlogPost;
}
const { post } = Astro.props;
---

<article class="blog-card">
  <BlogCover post={post} class="blog-card__cover">
    <p class="blog-cover__title" aria-hidden="true">{post.title}</p>
  </BlogCover>
  <h3 class="blog-card__title">
    <a href={blogPostPath(post.slug)}>{post.title}</a>
  </h3>
  <p class="blog-card__description">{post.description}</p>
  <p class="small muted blog-card__meta">
    <time datetime={publishedIso(post.published)}>{publishedText(post.published)}</time>
    <span aria-hidden="true">·</span>
    <span>{post.minutes} {copy.blog.minutesRead}</span>
  </p>
</article>

<style>
  .blog-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 8px;
    min-width: 0;
  }

  .blog-card :global(.blog-card__cover) {
    margin-bottom: 10px;
    transition: transform 0.2s ease;
  }

  /* Kapağın küçük bir kalkışı yalnızca dönüşümdür: gradyan çizimi yeniden yapılmaz. */
  .blog-card:hover :global(.blog-card__cover) {
    transform: translateY(-2px);
  }

  .blog-card__title {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .blog-card__title a {
    text-decoration: none;
  }

  /* Bağlantının tıklama alanı tüm kartı kaplar. */
  .blog-card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-m);
  }

  .blog-card__title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .blog-card__title a:focus-visible {
    outline: none;
  }

  .blog-card__title a:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .blog-card__description {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .blog-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card :global(.blog-card__cover) {
      transition: none;
    }
  }
</style>
