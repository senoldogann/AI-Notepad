---
// Uygulamanın "son toplantılar" kartı: gradyan kapak, ortasında ses dalgası, başlık ve bilgi kapağın altında.
import Film from "./Film.astro";
import Waveform from "./Waveform.astro";
import type { FilmLayout, FilmPalette } from "../lib/film";

interface Props {
  readonly title: string;
  readonly meta: string;
  readonly palette: FilmPalette;
  readonly layout: FilmLayout;
}
const { title, meta, palette, layout } = Astro.props;
---

<article class="meeting">
  <Film palette={palette} layout={layout} class="meeting__cover">
    <Waveform seed={title} width={112} height={44} class="meeting__wave" />
  </Film>
  <h3 class="meeting__title">{title}</h3>
  <p class="meeting__meta">{meta}</p>
</article>

<style>
  .meeting {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .meeting :global(.meeting__cover) {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-m);
    margin-bottom: 10px;
  }

  .meeting__title {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .meeting__meta {
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
