---
// Dil seçimi: iki dildeki hedef sayfa. Betik (src/client/lang-redirect.ts) okuyanın diline kendiliğinden geçer; betik
// yoksa bu bağlantılar görünür kalır.
import { copy } from "../i18n/copy";
import { type Lang, type PageKey, langMeta, langs, pagePath } from "../i18n/routes";

interface Props {
  readonly page: PageKey;
}
const { page } = Astro.props;
---

<nav class="lang-choice" aria-label={langs.map((lang: Lang): string => copy[lang].common.chooseLanguage).join(" / ")}>
  {
    langs.map((lang: Lang) => (
      <a id={`lang-target-${lang}`} class="button button--secondary" href={pagePath(page, lang)} hreflang={lang} lang={lang}>
        {langMeta[lang].name}
      </a>
    ))
  }
</nav>

<style>
  .lang-choice {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
</style>
