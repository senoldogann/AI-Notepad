---
// Alt bilgi: kısa tanım, ürün, öğren (karşılaştırma, blog, MCP), hesap ve şirket (iletişim, yasal) bağlantıları; en
// altta telif satırı. İşletmenin kimliği ve adresi gizlilik, şartlar ve iletişim sayfalarındadır (tek kaynak:
// legal/operator.ts).
import Logo from "./Logo.astro";
import { productName } from "../config";
import { copy, type CommonCopy } from "../copy";
import { routes } from "../routes";

const text: CommonCopy = copy.common;
const columns: readonly { readonly title: string; readonly links: readonly { readonly href: string; readonly label: string }[] }[] = [
  {
    title: text.footer.product,
    links: [
      { href: `${routes.home}#features`, label: text.nav.features },
      { href: routes.pricing, label: text.nav.pricing },
      { href: routes.download, label: text.nav.download },
    ],
  },
  {
    title: text.footer.learn,
    links: [
      { href: routes.compare, label: text.nav.compare },
      { href: routes.vsGranola, label: copy.compare.competitors.granola.title },
      { href: routes.vsOtter, label: copy.compare.competitors.otter.title },
      { href: routes.blog, label: text.nav.blog },
      { href: routes.mcp, label: text.nav.mcp },
    ],
  },
  {
    title: text.footer.account,
    links: [
      { href: routes.signIn, label: text.nav.signIn },
      { href: routes.account, label: text.nav.account },
    ],
  },
  {
    title: text.footer.company,
    links: [
      { href: routes.contact, label: text.nav.contact },
      { href: routes.privacy, label: text.nav.privacy },
      { href: routes.terms, label: text.nav.terms },
      { href: `${routes.privacy}#website`, label: text.footer.cookies },
      { href: "/fonts/Inter-OFL.txt", label: text.footer.fontLicense },
    ],
  },
];
---

<footer class="site-footer">
  <div class="page site-footer__grid">
    <div class="site-footer__about">
      <a class="site-footer__brand" href={routes.home} aria-label={text.homeLabel}>
        <Logo size={28} />
        <span>{productName}</span>
      </a>
      <p class="muted">{text.footer.tagline}</p>
    </div>
    {
      columns.map((column) => (
        <nav aria-label={column.title}>
          <h2 class="site-footer__title">{column.title}</h2>
          <ul class="site-footer__links">
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="page site-footer__bottom">
    <p>{text.footer.copyright}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(48px, 8vw, 96px);
    border-top: 1px solid var(--line);
    padding-top: 56px;
    font-size: 0.9375rem;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(4, 1fr);
    gap: 32px;
  }

  .site-footer__about {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    width: fit-content;
  }

  .site-footer__title {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .site-footer__links {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer__links a:hover {
    text-decoration: underline;
  }

  .site-footer__bottom {
    margin-top: 48px;
    padding-block: 24px 32px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.8125rem;
  }

  @media (max-width: 760px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .site-footer__about {
      grid-column: 1 / -1;
    }
  }
</style>
