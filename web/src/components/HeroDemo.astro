---
// Ana sayfanın kısa, dönen ürün gösterimi (18 sn): kayıt sürerken sayaç ilerler, ses dalgası oynar, canlı metin satırları
// birer birer gelir; kayıt bitince not kendiliğinden yazılır (başlık, bilgi, görevler, bir görev işaretlenir, karar),
// bir süre durur ve yumuşakça baştan başlar. Üç turdan sonra bitmiş notta durur (WCAG 2.2.2); köşedeki küçük düğme
// gösterimi duraklatır, sürdürür ya da baştan oynatır (client/hero-demo.ts; betik yoksa düğme gizli kalır).
// Maliyet: yalnızca küçük öğelerin saydamlığı ve dönüşümü (birleştirici) ile sayaç (tek öğede tamsayı özelliği) oynar;
// arkadaki film gradyanı hiç hareket etmez, bulanıklık filtresi yoktur. Gösterim ekranda değilken ya da sekme gizliyken
// durur (client/hero-demo.ts). "Hareketi azalt" açıksa animasyon hiç uygulanmaz: notun bitmiş hâli durgun görünür.
import Icon from "./Icon.astro";
import type { DemoCopy } from "../copy";
import { coverWaveHeights } from "../lib/film";

interface Props {
  readonly demo: DemoCopy;
}
const { demo } = Astro.props;

/** Dalga çubukları: yükseklik dokuz basamağa, hız beş gruba ayrılır (satır içi stil yok: CSP). */
const bars: readonly { readonly height: number; readonly tempo: number }[] = coverWaveHeights(demo.meetingTitle, 23).map((value: number, index: number) => ({
  height: Math.min(9, Math.max(1, Math.round(value * 9))),
  tempo: index % 5,
}));
---

<div class="demo-frame">
<div class="demo" id="hero-demo" role="img" aria-label={demo.label}>
  <div class="demo__left" aria-hidden="true">
    <div class="glass recorder">
      <div class="orb"></div>
      <div class="recorder__body">
        <p class="recorder__state">
          <span class="state-mark">
            <span class="state-mark__dot"></span>
            <Icon name="sparkle" size={14} class="state-mark__sparkle" />
            <Icon name="check" size={14} class="state-mark__check" />
          </span>
          <span class="state-labels">
            <span class="state-label state-label--listening">{demo.listening}</span>
            <span class="state-label state-label--writing">{demo.writing}</span>
            <span class="state-label state-label--done">{demo.done}</span>
          </span>
          <span class="recorder__timer tabular">{demo.timerMinutes}:<span class="timer-seconds"></span></span>
        </p>
        <div class="live-wave">
          {bars.map((bar) => <span class:list={["live-wave__bar", `live-wave__bar--h${bar.height}`, `live-wave__bar--t${bar.tempo}`]} />)}
        </div>
      </div>
    </div>

    <div class="glass transcript">
      <p class="demo-label">{demo.transcriptTitle}</p>
      <ol class="transcript__lines">
        {
          demo.transcript.map((line, index: number) => (
            <li class:list={["transcript__line", `appear-${index + 1}`]}>
              <span class="transcript__speaker">{line.speaker}</span>
              <span class="transcript__text">{line.text}</span>
              {line.translation === null ? null : <span class="transcript__translation appear-4">{line.translation}</span>}
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <article class="glass note" aria-hidden="true">
    <p class="note__pending">{demo.notePending}</p>
    <header class="note__head">
      <h2 class="note__title write-1">{demo.meetingTitle}</h2>
      <p class="note__meta write-2">{demo.meetingMeta}</p>
    </header>
    <h3 class="note__label write-3">{demo.tasksTitle}</h3>
    <ul class="checklist">
      {
        demo.tasks.map((task: string, index: number) => (
          <li class:list={["checklist__item", `write-${index + 4}`, { "checklist__item--ticks": index === 1 }]}>
            <span class="checkbox">
              <Icon name="check" size={12} class="checkbox__mark" />
            </span>
            <span class="checklist__text">{task}</span>
          </li>
        ))
      }
    </ul>
    <h3 class="note__label write-7">{demo.decisionsTitle}</h3>
    <p class="note__decision write-8">{demo.decision}</p>
  </article>
</div>
<button
  id="hero-demo-toggle"
  class="demo-toggle"
  type="button"
  hidden
  aria-controls="hero-demo"
  aria-label={demo.pause}
  title={demo.pause}
  data-label-pause={demo.pause}
  data-label-play={demo.play}
  data-label-replay={demo.replay}
>
  <Icon name="pause" size={16} class="demo-toggle__pause" />
  <Icon name="play" size={15} class="demo-toggle__play" />
</button>
</div>

<script>
  import "../client/hero-demo";
</script>

<style>
  /* Sayaç saniyesi: tamsayı özelliği CSS sayacına yazılır (betik yok). Durgun hâlde son değer. */
  @property --demo-seconds {
    syntax: "<integer>";
    inherits: false;
    initial-value: 16;
  }

  .demo-frame {
    min-width: 0;
  }

  .demo {
    --loop: 18s;
    /* Üç tur: ikisi tam, üçüncüsü notun bittiği ana (%88) dek; sonra o karede kalır (animation-fill-mode). */
    --loops: 2.88;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(20px, 4vw, 56px);
    padding: clamp(20px, 5vw, 64px);
  }

  .demo__left {
    display: grid;
    gap: 16px;
    align-content: center;
    min-width: 0;
  }

  /* Gösterimdeki cam yüzeyler bulanıklık filtresi kullanmaz: arkadaki gradyan zaten yumuşak, filtre her karede
     yeniden hesaplanmasın. */
  .demo :global(.glass) {
    background: rgb(255 255 255 / 0.82);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .demo-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #5f5f5f;
  }

  /* ---------- Kayıt kartı ---------- */

  .recorder {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 16px 22px 16px 16px;
    justify-self: start;
    width: min(100%, 360px);
  }

  .recorder .orb {
    flex: none;
    width: 56px;
    height: 56px;
  }

  .recorder__body {
    display: grid;
    gap: 10px;
    flex: 1;
    min-width: 0;
  }

  .recorder__state {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .state-mark,
  .state-labels {
    display: grid;
  }

  /* İşaretler (nokta, Icon bileşenleri) ve etiketler aynı hücrede üst üste: yalnızca saydamlıkları değişir. */
  .state-mark > :global(*),
  .state-labels > * {
    grid-area: 1 / 1;
  }

  .state-mark {
    place-items: center;
    width: 14px;
    height: 14px;
  }

  .state-mark__dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #e9896a;
  }

  .state-mark__dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #e9896a;
    opacity: 0;
  }

  .recorder__timer {
    margin-left: auto;
    font-weight: 500;
    color: #5f5f5f;
  }

  .timer-seconds {
    counter-reset: demo-seconds var(--demo-seconds);
  }

  .timer-seconds::after {
    content: counter(demo-seconds, decimal-leading-zero);
  }

  /* Durgun (son) hâl: "Not hazır" ve işaret görünür. */
  .state-mark__dot,
  .demo :global(.state-mark__sparkle),
  .state-label--listening,
  .state-label--writing {
    opacity: 0;
  }

  .live-wave {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 30px;
    color: #3a2a25;
  }

  .live-wave__bar {
    width: 3px;
    border-radius: 2px;
    background: currentColor;
    opacity: 0.68;
    transform-origin: center;
  }

  .live-wave__bar--h1 { height: 11%; }
  .live-wave__bar--h2 { height: 22%; }
  .live-wave__bar--h3 { height: 33%; }
  .live-wave__bar--h4 { height: 44%; }
  .live-wave__bar--h5 { height: 55%; }
  .live-wave__bar--h6 { height: 66%; }
  .live-wave__bar--h7 { height: 77%; }
  .live-wave__bar--h8 { height: 88%; }
  .live-wave__bar--h9 { height: 100%; }

  /* ---------- Canlı metin ---------- */

  .transcript {
    display: grid;
    gap: 10px;
    padding: 16px 20px 18px;
    width: min(100%, 400px);
  }

  .transcript__lines {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .transcript__line {
    display: grid;
    gap: 2px;
  }

  .transcript__speaker {
    font-size: 0.75rem;
    font-weight: 600;
    color: #5f5f5f;
  }

  .transcript__translation {
    color: #3a3a3a;
  }

  .transcript__translation::before {
    content: "↳ ";
    color: #8ea3e6;
    font-weight: 600;
  }

  /* ---------- Not ---------- */

  .note {
    display: grid;
    position: relative;
    gap: 6px;
    padding: clamp(18px, 2.4vw, 28px);
    justify-self: end;
    width: min(100%, 440px);
  }

  .note__head {
    margin-bottom: 8px;
  }

  /* Kayıt sürerken boş not kartının ortasındaki satır; durgun (son) hâlde gizli. */
  .note__pending {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 24px;
    text-align: center;
    font-size: 0.9375rem;
    color: #5f5f5f;
    opacity: 0;
  }

  .note__title {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .note__meta,
  .note__label {
    font-size: 0.8125rem;
    color: #5f5f5f;
  }

  .note__label {
    margin-top: 8px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .note__decision {
    font-size: 0.9375rem;
  }

  .checklist {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .checklist__item {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    line-height: 1.4;
  }

  .checkbox {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    margin-top: 2px;
    border-radius: 5px;
    border: 1.5px solid rgb(10 10 10 / 0.35);
  }

  /* İşaretli kutunun dolgusu ayrı katmanda: işaretlenirken yalnızca saydamlık değişir. */
  .checkbox::before {
    content: "";
    position: absolute;
    inset: -1.5px;
    border-radius: 5px;
    background: #0a0a0a;
    opacity: 0;
  }

  .checkbox :global(.checkbox__mark) {
    position: relative;
    color: #fafafa;
    stroke-width: 2.4;
    opacity: 0;
  }

  .checklist__item--ticks .checkbox::before,
  .checklist__item--ticks .checkbox :global(.checkbox__mark) {
    opacity: 1;
  }

  .checklist__item--ticks .checklist__text {
    color: #5f5f5f;
    text-decoration: line-through;
    text-decoration-color: rgb(10 10 10 / 0.3);
  }

  /* ---------- Hareket ----------
     Döngü 18 sn: 0–50 % kayıt (sayaç 42:07 → 42:16, satırlar %8, %20, %32, çeviri %40), 50 % kayıt biter, not %54'ten
     %75'e yazılır, %80'de bir görev işaretlenir, %92'ye dek durur, %92–96 her şey söner ve başa döner. */
  @media (prefers-reduced-motion: no-preference) {
    .demo[data-paused] *,
    .demo[data-paused] *::before,
    .demo[data-paused] *::after,
    .demo[data-user-paused] *,
    .demo[data-user-paused] *::before,
    .demo[data-user-paused] *::after {
      animation-play-state: paused !important;
    }

    /* Baştan oynatmak için animasyonlar bir kare kaldırılır (hero-demo.ts). */
    .demo[data-restart] *,
    .demo[data-restart] *::before,
    .demo[data-restart] *::after {
      animation: none !important;
    }

    /* Gösterim bitti: sürekli dönen küçük hareketler de durur. */
    .demo[data-finished] .live-wave__bar,
    .demo[data-finished] .state-mark__dot::after {
      animation: none;
    }

    .timer-seconds {
      animation: demo-timer var(--loop) linear var(--loops) forwards;
    }

    .state-mark__dot {
      animation: demo-phase-record var(--loop) ease var(--loops) forwards;
    }

    .state-mark__dot::after {
      animation: demo-pulse 1.6s ease-out infinite;
    }

    .state-label--listening {
      animation: demo-phase-record var(--loop) ease var(--loops) forwards;
    }

    .state-label--writing,
    .demo :global(.state-mark__sparkle) {
      animation: demo-phase-write var(--loop) ease var(--loops) forwards;
    }

    .state-label--done,
    .demo :global(.state-mark__check) {
      animation: demo-phase-done var(--loop) ease var(--loops) forwards;
    }

    .recorder .orb {
      animation: demo-breathe var(--loop) ease-in-out var(--loops) forwards;
    }

    .live-wave {
      animation: demo-wave-rest var(--loop) ease var(--loops) forwards;
    }

    .live-wave__bar {
      animation: demo-bar 1.2s ease-in-out infinite alternate;
    }

    .live-wave__bar--t1 { animation-duration: 0.9s; animation-delay: -0.3s; }
    .live-wave__bar--t2 { animation-duration: 1.4s; animation-delay: -0.8s; }
    .live-wave__bar--t3 { animation-duration: 1.05s; animation-delay: -0.5s; }
    .live-wave__bar--t4 { animation-duration: 1.3s; animation-delay: -1.1s; }

    .note__pending {
      animation: demo-phase-record var(--loop) ease var(--loops) forwards;
    }

    .appear-1 { animation: demo-in-08 var(--loop) ease var(--loops) forwards; }
    .appear-2 { animation: demo-in-20 var(--loop) ease var(--loops) forwards; }
    .appear-3 { animation: demo-in-32 var(--loop) ease var(--loops) forwards; }
    .appear-4 { animation: demo-in-40 var(--loop) ease var(--loops) forwards; }
    .write-1 { animation: demo-in-54 var(--loop) ease var(--loops) forwards; }
    .write-2 { animation: demo-in-57 var(--loop) ease var(--loops) forwards; }
    .write-3 { animation: demo-in-60 var(--loop) ease var(--loops) forwards; }
    .write-4 { animation: demo-in-63 var(--loop) ease var(--loops) forwards; }
    .write-5 { animation: demo-in-66 var(--loop) ease var(--loops) forwards; }
    .write-6 { animation: demo-in-69 var(--loop) ease var(--loops) forwards; }
    .write-7 { animation: demo-in-72 var(--loop) ease var(--loops) forwards; }
    .write-8 { animation: demo-in-75 var(--loop) ease var(--loops) forwards; }

    .checklist__item--ticks .checkbox::before,
    .checklist__item--ticks .checkbox :global(.checkbox__mark) {
      animation: demo-tick var(--loop) ease var(--loops) forwards;
    }

    .checklist__item--ticks .checklist__text {
      animation: demo-strike var(--loop) ease var(--loops) forwards;
    }
  }

  @keyframes demo-timer {
    0% { --demo-seconds: 7; }
    50%, 95.9% { --demo-seconds: 16; }
    96%, 100% { --demo-seconds: 7; }
  }

  @keyframes demo-phase-record {
    0%, 48% { opacity: 1; }
    52%, 96% { opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes demo-phase-write {
    0%, 49% { opacity: 0; }
    53%, 76% { opacity: 1; }
    80%, 100% { opacity: 0; }
  }

  @keyframes demo-phase-done {
    0%, 77% { opacity: 0; }
    81%, 93% { opacity: 1; }
    97%, 100% { opacity: 0; }
  }

  @keyframes demo-pulse {
    0% { opacity: 0.5; transform: scale(1); }
    100% { opacity: 0; transform: scale(2.6); }
  }

  @keyframes demo-breathe {
    0%, 50%, 100% { transform: scale(1); }
    12%, 37% { transform: scale(1.035); }
    25% { transform: scale(0.99); }
  }

  @keyframes demo-wave-rest {
    0%, 48% { transform: none; opacity: 1; }
    54%, 94% { transform: scaleY(0.18); opacity: 0.55; }
    100% { transform: none; opacity: 1; }
  }

  @keyframes demo-bar {
    from { transform: scaleY(0.38); }
    to { transform: scaleY(1); }
  }

  @keyframes demo-tick {
    0%, 79% { opacity: 0; }
    82%, 92% { opacity: 1; }
    96%, 100% { opacity: 0; }
  }

  @keyframes demo-strike {
    0%, 79% { color: #0a0a0a; text-decoration-color: transparent; }
    83%, 92% { color: #5f5f5f; text-decoration-color: rgb(10 10 10 / 0.3); }
    96%, 100% { color: #0a0a0a; text-decoration-color: transparent; }
  }

  /* Belirme anahtarları: adı belirdiği yüzde; hepsi %92–96 arasında söner. */
  @keyframes demo-in-08 { 0%, 7% { opacity: 0; transform: translateY(6px); } 10%, 92% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @keyframes demo-in-20 { 0%, 19% { opacity: 0; transform: translateY(6px); } 22%, 92% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @keyframes demo-in-32 { 0%, 31% { opacity: 0; transform: translateY(6px); } 34%, 92% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @keyframes demo-in-40 { 0%, 39% { opacity: 0; transform: translateY(4px); } 42%, 92% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @keyframes demo-in-54 { 0%, 53% { opacity: 0; transform: translateY(6px); } 56%, 92% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @keyframes demo-in-57 { 0%, 56% { opacity: 0; transform: translateY(6px); } 59%, 92% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @keyframes demo-in-60 { 0%, 59% { opacity: 0; transform: translateY(6px); } 62%, 92% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @keyframes demo-in-63 { 0%, 62% { opacity: 0; transform: translateY(6px); } 65%, 92% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @keyframes demo-in-66 { 0%, 65% { opacity: 0; transform: translateY(6px); } 68%, 92% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @keyframes demo-in-69 { 0%, 68% { opacity: 0; transform: translateY(6px); } 71%, 92% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @keyframes demo-in-72 { 0%, 71% { opacity: 0; transform: translateY(6px); } 74%, 92% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @keyframes demo-in-75 { 0%, 74% { opacity: 0; transform: translateY(6px); } 77%, 92% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }

  /* Duraklat/oynat: köşede küçük, yarı saydam yuvarlak düğme (cam yüzey, bulanıklık yok). */
  .demo-toggle {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid rgb(10 10 10 / 0.1);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.72);
    color: #0a0a0a;
    cursor: pointer;
    opacity: 0.75;
    transition: opacity 160ms ease, background-color 160ms ease;
  }

  .demo-toggle[hidden] {
    display: none;
  }

  .demo-toggle:hover,
  .demo-toggle:focus-visible {
    opacity: 1;
    background: rgb(255 255 255 / 0.92);
  }

  .demo-toggle :global(.icon) {
    grid-area: 1 / 1;
  }

  .demo-toggle :global(.demo-toggle__play),
  .demo-toggle[data-state="paused"] :global(.demo-toggle__pause),
  .demo-toggle[data-state="finished"] :global(.demo-toggle__pause) {
    display: none;
  }

  .demo-toggle[data-state="paused"] :global(.demo-toggle__play),
  .demo-toggle[data-state="finished"] :global(.demo-toggle__play) {
    display: block;
  }

  /* Hareket azaltılmışsa gösterim zaten durgundur; düğme gerekmez. */
  @media (prefers-reduced-motion: reduce) {
    .demo-toggle {
      display: none;
    }
  }

  @media (max-width: 960px) {
    .demo {
      grid-template-columns: minmax(0, 1fr);
    }

    .recorder,
    .transcript {
      width: 100%;
    }

    .note {
      justify-self: stretch;
      width: 100%;
    }
  }
</style>
