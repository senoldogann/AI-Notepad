---
// Üst çubuk: logo, menü, tema düğmesi ve indirme sayfası düğmesi. Dar ekranda menü <details> ile açılır.
// Tema düğmesini public/theme.js bağlar; betik yoksa düğme gizlidir (tema sistemi izler). Sekmede oturum varsa
// "Giriş yap" bağlantıları "Hesap"a döner (src/client/header.ts). Metinler sayfadan gelir (`/fi` Fince); sayfanın
// öbür dildeki sürümü varsa menünün sonunda dil bağlantısı durur (routes.ts `pageAlternates`).
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { productName } from "../config";
import { copy, type CommonCopy } from "../copy";
import { type PageAlternate, type PageKey, pageAlternates, routes } from "../routes";

interface Props {
  readonly page: PageKey;
  /** Arayüz metinleri; varsayılan İngilizce. */
  readonly text?: CommonCopy;
  /** "Ominaisuudet" bağlantısının hedefi; varsayılan ana sayfanın özellikler bölümü. */
  readonly featuresHref?: string | undefined;
}
const { page, text = copy.common, featuresHref = `${routes.home}#features` } = Astro.props;
const links: readonly { readonly href: string; readonly label: string; readonly sessionLink: boolean; readonly lang: string | null }[] = [
  { href: featuresHref, label: text.nav.features, sessionLink: false, lang: null },
  { href: routes.pricing, label: text.nav.pricing, sessionLink: false, lang: null },
  { href: routes.download, label: text.nav.download, sessionLink: false, lang: null },
  { href: routes.signIn, label: text.nav.signIn, sessionLink: true, lang: null },
];
/** Sayfanın öbür dildeki sürümü: dil bağlantısı. */
const alternate: PageAlternate | undefined = pageAlternates[page];
const menu: readonly { readonly href: string; readonly label: string; readonly sessionLink: boolean; readonly lang: string | null }[] =
  alternate === undefined ? links : [...links, { href: routes[alternate.page], label: alternate.label, sessionLink: false, lang: alternate.lang }];
const currentPath: string = routes[page];
---

<header id="site-header" class="site-header" data-account-href={routes.account} data-account-label={text.nav.account}>
  <div class="page site-header__inner">
    <a class="brand" href={routes.home} aria-label={text.homeLabel}>
      <Logo size={28} />
      <span class="brand__name">{productName}</span>
    </a>

    <nav class="nav" aria-label={text.navLabel}>
      <ul class="nav__list">
        {
          menu.map((link) => (
            <li>
              <a
                class="nav__link"
                href={link.href}
                aria-current={link.href === currentPath ? "page" : undefined}
                data-session-link={link.sessionLink ? "" : undefined}
                hreflang={link.lang ?? undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label={text.darkMode} title={text.darkMode}>
        <Icon name="moon" size={18} class="theme-toggle__icon theme-toggle__moon" />
        <Icon name="sun" size={18} class="theme-toggle__icon theme-toggle__sun" />
      </button>
      <a class="button button--primary button--small header-cta" href={routes.download}>
        <Icon name="apple" size={15} class="button__apple" />
        {text.headerDownload}
      </a>
      <details class="menu">
        <summary class="menu__button">
          <span class="visually-hidden">{text.navLabel}</span>
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </summary>
        <ul class="menu__list">
          {
            menu.map((link) => (
              <li>
                <a href={link.href} data-session-link={link.sessionLink ? "" : undefined} hreflang={link.lang ?? undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </div>
</header>

<script>
  import "../client/header";
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    /* Önce önekli, sonra standart: CSS sıkıştırıcı ikisini birleştirirken sonuncuyu tutar (Chrome yalnızca standardı tanır). */
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 68px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 1.0625rem;
    border-radius: 8px;
  }

  .nav {
    margin-left: 12px;
  }

  .nav__list {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 12px;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color 160ms ease, background-color 160ms ease;
  }

  .nav__link:hover,
  .nav__link[aria-current="page"] {
    color: var(--ink);
    background: var(--soft);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  /* Tema düğmesi: ay (açık tema) ve güneş (koyu tema) üst üste; geçişte yalnızca dönme, ölçek ve saydamlık. */
  .theme-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    color: var(--ink);
    cursor: pointer;
    transition: background-color 160ms ease;
  }

  .theme-toggle:hover {
    background: var(--soft);
  }

  :global(:root:not([data-theme])) .theme-toggle {
    display: none;
  }

  .theme-toggle :global(.theme-toggle__icon) {
    grid-area: 1 / 1;
    transition:
      transform 360ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 240ms ease;
  }

  .theme-toggle :global(.theme-toggle__sun) {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  :global(:root[data-theme="dark"]) .theme-toggle :global(.theme-toggle__moon) {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  :global(:root[data-theme="dark"]) .theme-toggle :global(.theme-toggle__sun) {
    opacity: 1;
    transform: none;
  }

  .header-cta :global(.button__apple) {
    margin-top: -2px;
  }

  .menu {
    display: none;
    position: relative;
  }

  .menu__button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--card);
    cursor: pointer;
    list-style: none;
  }

  .menu__button::-webkit-details-marker {
    display: none;
  }

  .menu__list {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 200px;
    margin: 0;
    padding: 8px;
    list-style: none;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    box-shadow: var(--elevation);
  }

  .menu__list a {
    display: block;
    padding: 10px 12px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
  }

  .menu__list a:hover {
    background: var(--soft);
  }

  @media (max-width: 860px) {
    .nav {
      display: none;
    }

    .menu {
      display: block;
    }
  }

  @media (max-width: 420px) {
    .header-cta {
      display: none;
    }
  }
</style>
