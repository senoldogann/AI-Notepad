---
// Uygulama simgesinin çizimi: koyu yuvarlak kare içinde ses dalgası çubukları ve çizgi.
interface Props {
  readonly size: number;
}
const { size } = Astro.props;
---

<svg class="logo-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect class="logo-mark__tile" x="0.5" y="0.5" width="31" height="31" rx="8.5"></rect>
  <g class="logo-mark__bars">
    <rect x="7.4" y="12" width="2.6" height="8" rx="1.3"></rect>
    <rect x="11.4" y="8.2" width="2.6" height="15.6" rx="1.3"></rect>
    <rect x="15.4" y="10.6" width="2.6" height="10.8" rx="1.3"></rect>
    <rect x="19.6" y="14.7" width="5.6" height="2.6" rx="1.3"></rect>
  </g>
</svg>

<style>
  .logo-mark__tile {
    fill: #0a0a0a;
    stroke: transparent;
  }

  .logo-mark__bars {
    fill: #fafafa;
  }

  @media (prefers-color-scheme: dark) {
    .logo-mark__tile {
      stroke: #3a3a3a;
    }
  }
</style>
