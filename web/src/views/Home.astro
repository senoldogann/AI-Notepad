---
// Ana sayfa: kahraman alanı (canlı not kartı film kapak üstünde), son toplantılar, özellikler, üç adım, fiyat, SSS.
import Base from "../layouts/Base.astro";
import Faq from "../components/Faq.astro";
import Film from "../components/Film.astro";
import MeetingCard from "../components/MeetingCard.astro";
import Waveform from "../components/Waveform.astro";
import { copy, type CommonCopy, type HomeCopy } from "../i18n/copy";
import { type Lang, pagePath } from "../i18n/routes";
import type { FilmLayout, FilmPalette } from "../lib/film";
import { cyclic } from "../lib/list";
import { siteConfig } from "../site";

interface Props {
  readonly lang: Lang;
}
const { lang } = Astro.props;
const text: HomeCopy = copy[lang].home;
const common: CommonCopy = copy[lang].common;
const covers: readonly { readonly palette: FilmPalette; readonly layout: FilmLayout }[] = [
  { palette: "coral", layout: "clouds-right" },
  { palette: "ocean", layout: "clouds-left" },
  { palette: "mint", layout: "streaks" },
  { palette: "violet", layout: "clouds-right" },
];
const integrations: readonly string[] = ["Notion", "Slack", "Linear", "Jira", "Microsoft Teams", "Discord", "Zoom", lang === "tr" ? "Anımsatıcılar" : "Reminders"];
---

<Base lang={lang} page="home" meta={text.meta} indexed={true}>
  <section class="hero page">
    <div class="hero__text">
      <p class="eyebrow">{text.eyebrow}</p>
      <h1 class="display">{text.title}</h1>
      <p class="lead">{text.lead}</p>
      <div class="hero__actions">
        <a class="button button--primary" href={siteConfig.dmgUrl}>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 2v8m0 0 3.5-3.5M8 10 4.5 6.5M3 13h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          {common.downloadCta}
        </a>
        <a class="button button--secondary" href={pagePath("pricing", lang)}>{text.secondaryCta}</a>
      </div>
      <p class="hero__offer small"><strong>{common.offer}</strong><span class="muted"> · {common.requirementsShort}</span></p>
    </div>

    <Film palette="sunset" layout="clouds-left" class="hero__cover">
      <div class="hero__stage">
        <div class="glass recorder">
          <div class="orb" aria-hidden="true"></div>
          <div class="recorder__body">
            <p class="recorder__state"><span class="live-dot" aria-hidden="true"></span>{text.mock.listening} · 18:42</p>
            <Waveform seed={text.mock.meetingTitle} width={168} height={36} class="recorder__wave" />
          </div>
        </div>
        <article class="glass note" aria-label={text.mock.meetingTitle}>
          <header class="note__head">
            <h2 class="note__title">{text.mock.meetingTitle}</h2>
            <p class="note__meta">{text.mock.meetingMeta}</p>
          </header>
          <h3 class="note__label">{text.mock.tasksTitle}</h3>
          <ul class="checklist">
            {text.mock.tasks.map((task: string, index: number) => <li class:list={["checklist__item", { "checklist__item--done": index === 1 }]}>{task}</li>)}
          </ul>
          <h3 class="note__label">{text.mock.decisionsTitle}</h3>
          <p class="note__decision">{text.mock.decision}</p>
        </article>
      </div>
    </Film>

    <section class="library" aria-label={text.library.label}>
      <h2 class="library__label">{text.library.label}</h2>
      <div class="library__grid">
        {
          text.library.meetings.map((meeting, index: number) => (
            <MeetingCard title={meeting.title} meta={meeting.meta} palette={cyclic(covers, index).palette} layout={cyclic(covers, index).layout} />
          ))
        }
      </div>
    </section>
  </section>

  <section class="section page" id="features" aria-labelledby="features-title">
    <div class="section-head reveal">
      <p class="eyebrow">{text.featuresEyebrow}</p>
      <h2 class="title-xl" id="features-title">{text.featuresTitle}</h2>
      <p class="lead">{text.featuresLead}</p>
    </div>

    <div class="features">
      <article class="feature feature--wide reveal">
        <Film palette="ocean" layout="clouds-right" class="feature__cover">
          <div class="glass bubble-stack">
            <p class="bubble-stack__original">{text.features.live.original}</p>
            <p class="bubble-stack__translation">{text.features.live.translation}</p>
          </div>
        </Film>
        <h3 class="title-m">{text.features.live.title}</h3>
        <p class="muted">{text.features.live.text}</p>
      </article>

      <article class="feature feature--wide reveal">
        <Film palette="coral" layout="clouds-left" class="feature__cover">
          <ul class="glass checklist checklist--card">
            {text.features.tasks.sample.map((task: string) => <li class="checklist__item">{task}</li>)}
          </ul>
        </Film>
        <h3 class="title-m">{text.features.tasks.title}</h3>
        <p class="muted">{text.features.tasks.text}</p>
      </article>

      <article class="feature reveal">
        <Film palette="rose" layout="streaks" class="feature__cover">
          <div class="missed">
            <span class="glass missed__button">{text.features.missed.button}</span>
            <p class="glass missed__answer">{text.features.missed.answer}</p>
          </div>
        </Film>
        <h3 class="title-m">{text.features.missed.title}</h3>
        <p class="muted">{text.features.missed.text}</p>
      </article>

      <article class="feature reveal">
        <Film palette="violet" layout="clouds-left" class="feature__cover">
          <div class="ask">
            <p class="glass ask__question">{text.features.ask.question}</p>
            <p class="ask__source">{text.features.ask.source}</p>
          </div>
        </Film>
        <h3 class="title-m">{text.features.ask.title}</h3>
        <p class="muted">{text.features.ask.text}</p>
      </article>

      <article class="feature reveal">
        <Film palette="mint" layout="clouds-right" class="feature__cover">
          <ul class="chips">
            {integrations.map((name: string) => <li class="glass chip">{name}</li>)}
          </ul>
        </Film>
        <h3 class="title-m">{text.features.integrations.title}</h3>
        <p class="muted">{text.features.integrations.text}</p>
      </article>

      <article class="feature reveal">
        <Film palette="sunset" layout="streaks" class="feature__cover">
          <p class="glass privacy-badge">
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false"><rect x="3.5" y="8" width="11" height="7.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"></rect><path d="M6 8V6a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
            {text.features.privacy.badge}
          </p>
        </Film>
        <h3 class="title-m">{text.features.privacy.title}</h3>
        <p class="muted">{text.features.privacy.text}</p>
      </article>
    </div>
  </section>

  <section class="section section--tinted" aria-labelledby="steps-title">
    <div class="page">
      <h2 class="title-l reveal" id="steps-title">{text.stepsTitle}</h2>
      <ol class="steps">
        {
          text.steps.map((step, index: number) => (
            <li class="step reveal">
              <span class="step__number tabular" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="title-m">{step.title}</h3>
              <p class="muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section page" aria-labelledby="pricing-title">
    <div class="pricing-band reveal">
      <div class="pricing-band__text">
        <h2 class="title-xl" id="pricing-title">{text.pricingTitle}</h2>
        <p class="lead">{text.pricingLead}</p>
        <a class="text-link" href={pagePath("pricing", lang)}>{text.pricingCta} <span aria-hidden="true">→</span></a>
      </div>
      <Film palette="violet" layout="streaks" class="pricing-band__cover">
        <div class="glass price-tag">
          <p class="price-tag__amount"><span class="tabular">{common.price}</span><span class="price-tag__per">{common.perMonth}</span></p>
          <p class="price-tag__offer">{common.offer}</p>
          <p class="price-tag__tax">{common.taxNote}</p>
        </div>
      </Film>
    </div>
  </section>

  <section class="section page" aria-labelledby="faq-title">
    <div class="faq-layout">
      <h2 class="title-l reveal" id="faq-title">{text.faqTitle}</h2>
      <Faq items={text.faq} />
    </div>
  </section>

  <section class="page final reveal" aria-labelledby="final-title">
    <Film palette="ocean" layout="clouds-left" class="final__cover">
      <div class="final__content">
        <Waveform seed={text.finalTitle} width={180} height={48} class="final__wave" />
        <h2 class="title-xl" id="final-title">{text.finalTitle}</h2>
        <p class="final__lead">{text.finalLead}</p>
        <div class="hero__actions final__actions">
          <a class="button button--primary button--on-film" href={siteConfig.dmgUrl}>{common.downloadCta}</a>
          <a class="button button--glass" href={pagePath("download", lang)}>{common.requirementsShort}</a>
        </div>
      </div>
    </Film>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(48px, 8vw, 104px);
  }

  .hero__text {
    display: grid;
    gap: 22px;
    max-width: 52rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  .hero__offer {
    display: flex;
    flex-wrap: wrap;
    gap: 0 6px;
  }

  .hero__offer strong {
    font-weight: 600;
  }

  .hero :global(.hero__cover) {
    margin-top: clamp(40px, 6vw, 72px);
    min-height: clamp(380px, 46vw, 560px);
    display: grid;
    align-items: center;
  }

  .hero__stage {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(20px, 4vw, 56px);
    padding: clamp(20px, 5vw, 64px);
  }

  .recorder {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 22px;
    justify-self: start;
    max-width: 100%;
  }

  .recorder__body {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  .recorder__state {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #e9896a;
    box-shadow: 0 0 0 4px rgb(233 137 106 / 0.25);
  }

  .hero :global(.recorder__wave) {
    color: #3a2a25;
    opacity: 0.7;
    mix-blend-mode: normal;
  }

  .note {
    display: grid;
    gap: 6px;
    padding: clamp(18px, 2.4vw, 28px);
    justify-self: end;
    width: min(100%, 440px);
  }

  .note__head {
    margin-bottom: 8px;
  }

  .note__title {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .note__meta,
  .note__label {
    font-size: 0.8125rem;
    color: #5f5f5f;
  }

  .note__label {
    margin-top: 8px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .note__decision {
    font-size: 0.9375rem;
  }

  .checklist {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .checklist__item {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    line-height: 1.4;
  }

  .checklist__item::before {
    content: "";
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 2px;
    border-radius: 5px;
    border: 1.5px solid rgb(10 10 10 / 0.35);
  }

  .checklist__item--done {
    color: #5f5f5f;
    text-decoration: line-through;
    text-decoration-color: rgb(10 10 10 / 0.3);
  }

  .checklist__item--done::before {
    content: "✓";
    display: grid;
    place-items: center;
    border-color: #0a0a0a;
    background: #0a0a0a;
    color: #fafafa;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
  }

  .library {
    margin-top: clamp(28px, 4vw, 44px);
  }

  .library__label {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--muted);
    margin-bottom: 16px;
  }

  .library__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 24px);
  }

  /* Özellikler: üstte iki geniş, altta dört kart; başlıklar kapakların altında. */
  .features {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(28px, 3.4vw, 44px) clamp(16px, 2.2vw, 28px);
  }

  .feature {
    grid-column: span 3;
    display: grid;
    align-content: start;
    gap: 10px;
    min-width: 0;
  }

  .feature--wide {
    grid-column: span 6;
  }

  .feature :global(.feature__cover) {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    padding: 20px;
    margin-bottom: 8px;
    border-radius: var(--radius-m);
  }

  .feature--wide :global(.feature__cover) {
    aspect-ratio: 16 / 9;
    padding: 28px;
  }

  .bubble-stack {
    display: grid;
    gap: 10px;
    padding: 18px 22px;
    max-width: 380px;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .bubble-stack__translation {
    padding-top: 10px;
    border-top: 1px solid rgb(10 10 10 / 0.1);
    color: #3a3a3a;
  }

  .bubble-stack__translation::before {
    content: "↳ ";
    color: #8ea3e6;
    font-weight: 600;
  }

  .checklist--card {
    padding: 18px 22px;
    min-width: min(100%, 280px);
  }

  .missed,
  .ask {
    display: grid;
    gap: 10px;
    justify-items: center;
    text-align: center;
  }

  .missed__button {
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .missed__answer,
  .ask__question {
    padding: 12px 16px;
    border-radius: 16px;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .ask__source {
    font-size: 0.75rem;
    font-weight: 500;
    color: #2a2238;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chip {
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .privacy-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .section--tinted {
    background: var(--soft);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
    margin: clamp(32px, 4vw, 52px) 0 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    align-content: start;
    gap: 10px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .step__number {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
  }

  .pricing-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }

  .pricing-band__text {
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  .pricing-band :global(.pricing-band__cover) {
    display: grid;
    place-items: center;
    min-height: 340px;
    padding: 28px;
  }

  .price-tag {
    display: grid;
    gap: 6px;
    padding: 26px 30px;
    width: min(100%, 340px);
  }

  .price-tag__amount {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: 2.75rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .price-tag__per {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
    color: #5f5f5f;
  }

  .price-tag__offer {
    font-weight: 500;
  }

  .price-tag__tax {
    font-size: 0.8125rem;
    color: #5f5f5f;
  }

  .faq-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: start;
  }

  .final {
    padding-bottom: clamp(24px, 4vw, 48px);
  }

  .final :global(.final__cover) {
    padding: clamp(48px, 8vw, 112px) clamp(24px, 6vw, 80px);
  }

  .final__content {
    display: grid;
    justify-items: center;
    gap: 18px;
    text-align: center;
  }

  .final__content h2 {
    max-width: 18ch;
  }

  .final__lead {
    font-size: 1.125rem;
    color: #2b2b2b;
  }

  .final__actions {
    justify-content: center;
  }

  /* Kapak her temada açık kaldığından kapak üstündeki birincil düğme hep koyu. */
  .button--on-film {
    background: #0a0a0a;
    color: #fafafa;
  }

  .button--on-film:hover {
    background: #262626;
  }

  @media (max-width: 960px) {
    .hero__stage {
      grid-template-columns: minmax(0, 1fr);
    }

    .note {
      justify-self: stretch;
      width: 100%;
    }

    .feature,
    .feature--wide {
      grid-column: span 6;
    }

    .pricing-band,
    .faq-layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .library__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .feature,
    .feature--wide {
      grid-column: 1 / -1;
    }

    .steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__actions .button {
      flex: 1 1 auto;
    }
  }
</style>
