---
// İndirme sayfası: DMG düğmesi (adres yapılandırmadan), sistem gereksinimleri, Mac'e kurulum adımları, güncellemeler.
import Base from "../layouts/Base.astro";
import Film from "../components/Film.astro";
import Logo from "../components/Logo.astro";
import Waveform from "../components/Waveform.astro";
import { latestReleaseUrl, latestVersion, repositoryUrl } from "../config";
import { copy, type DownloadCopy, type TitledText } from "../i18n/copy";
import type { Lang } from "../i18n/routes";
import { siteConfig } from "../site";

interface Props {
  readonly lang: Lang;
}
const { lang } = Astro.props;
const text: DownloadCopy = copy[lang].download;
---

<Base lang={lang} page="download" meta={text.meta} indexed={true}>
  <section class="page download-hero">
    <div class="download-hero__text">
      <h1 class="title-xl">{text.title}</h1>
      <p class="lead">{text.lead}</p>
      <div class="download-hero__actions">
        <a class="button button--primary download-button" href={siteConfig.dmgUrl}>
          <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 2v8m0 0 3.5-3.5M8 10 4.5 6.5M3 13h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          {text.button}
        </a>
        <p class="small muted"><span class="pill">{text.versionLabel} {latestVersion}</span> {copy[lang].common.requirementsShort}</p>
      </div>
      <p class="small muted note">{text.buttonNote} <a href={latestReleaseUrl}>{text.releaseNotes}</a></p>
    </div>
    <Film palette="mint" layout="clouds-left" class="download-hero__cover">
      <div class="app-tile">
        <Logo size={96} />
        <span class="app-tile__name">AI-Notepad</span>
      </div>
      <Waveform seed="AI-Notepad" width={200} height={44} class="download-hero__wave" />
    </Film>
  </section>

  <section class="section page" aria-labelledby="requirements-title">
    <h2 class="title-l reveal" id="requirements-title">{text.requirementsTitle}</h2>
    <dl class="requirements">
      {
        text.requirements.map((requirement: TitledText) => (
          <div class="card requirement reveal">
            <dt class="title-m">{requirement.title}</dt>
            <dd class="muted">{requirement.text}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="page install" aria-labelledby="install-title">
    <h2 class="title-l reveal" id="install-title">{text.installTitle}</h2>
    <ol class="install__steps">
      {
        text.installSteps.map((step: TitledText, index: number) => (
          <li class="install__step reveal">
            <span class="install__number tabular" aria-hidden="true">{index + 1}</span>
            <div>
              <h3 class="title-m">{step.title}</h3>
              <p class="muted">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section page more" aria-label={text.updatesTitle}>
    <div class="card reveal">
      <h2 class="title-m">{text.updatesTitle}</h2>
      <p class="muted">{text.updatesText}</p>
      <a class="text-link" href={latestReleaseUrl}>{text.releaseNotes} <span aria-hidden="true">→</span></a>
    </div>
    <div class="card reveal">
      <h2 class="title-m">{text.developerTitle}</h2>
      <p class="muted">{text.developerText}</p>
      <a class="text-link" href={repositoryUrl}>GitHub <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  .download-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    padding-top: clamp(48px, 8vw, 96px);
  }

  .download-hero__text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  .download-hero__actions {
    display: grid;
    gap: 12px;
    justify-items: start;
    margin-top: 6px;
  }

  .download-button {
    min-height: 54px;
    padding: 0 28px;
    font-size: 1rem;
  }

  .download-hero__actions .pill {
    margin-right: 6px;
  }

  .note {
    max-width: 30rem;
  }

  .download-hero :global(.download-hero__cover) {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 28px;
    aspect-ratio: 5 / 4;
  }

  .app-tile {
    display: grid;
    justify-items: center;
    gap: 14px;
  }

  .app-tile :global(.logo-mark) {
    filter: drop-shadow(0 18px 30px rgb(30 60 45 / 0.25));
  }

  .app-tile__name {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .requirements {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: clamp(28px, 4vw, 44px) 0 0;
  }

  .requirement {
    display: grid;
    align-content: start;
    gap: 6px;
  }

  .requirement dd {
    margin: 0;
  }

  .install {
    display: grid;
    gap: clamp(28px, 4vw, 44px);
  }

  .install__steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 52rem;
  }

  .install__step {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 18px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }

  .install__step h3 {
    margin-bottom: 6px;
  }

  .install__number {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--primary);
    color: var(--on-primary);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .more {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .more .card {
    display: grid;
    gap: 10px;
    align-content: start;
    justify-items: start;
  }

  @media (max-width: 960px) {
    .requirements {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .download-hero,
    .more {
      grid-template-columns: minmax(0, 1fr);
    }

    .download-button {
      width: 100%;
    }

    .download-hero__actions {
      justify-items: stretch;
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .requirements {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
