---
// Üst çubuksuz, iki dilli sade sayfa iskeleti: dil yönlendirmesi (kök, Stripe ve e-posta dönüşleri) ve 404.
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { type Lang, type PageKey, langs, pageUrl } from "../i18n/routes";
import { siteConfig } from "../site";

interface Props {
  readonly title: string;
  readonly description: string;
  /** Arama motorlarına açık mı (yalnızca kök). */
  readonly indexed: boolean;
  /** hreflang bağlantıları verilecek sayfa; yoksa null. */
  readonly alternatesFor: PageKey | null;
}
const { title, description, indexed, alternatesFor } = Astro.props;
const origin: string = siteConfig.siteOrigin;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexed ? <link rel="canonical" href={`${origin}/`} /> : <meta name="robots" content="noindex" />}
    {
      alternatesFor === null
        ? null
        : [
            ...langs.map((alternate: Lang) => <link rel="alternate" hreflang={alternate} href={pageUrl(alternatesFor, alternate, origin)} />),
            <link rel="alternate" hreflang="x-default" href={`${origin}/`} />,
          ]
    }
    <link rel="preload" href="/fonts/InterVariable-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${origin}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <main class="minimal">
      <a class="minimal__brand" href="/" aria-label="AI-Notepad">
        <Logo size={40} />
      </a>
      <slot />
    </main>
  </body>
</html>

<style>
  .minimal {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 24px;
    min-height: 100vh;
    padding: 48px var(--gutter);
    text-align: center;
  }

  .minimal__brand {
    border-radius: 10px;
  }
</style>
