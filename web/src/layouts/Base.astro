---
// Tüm sayfaların iskeleti: başlık ve açıklama, kanonik adres, Open Graph, simgeler, tema betiği, üst çubuk ve alt bilgi.
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PullReveal from "../components/PullReveal.astro";
import { productName } from "../config";
import { copy, type PageMeta } from "../copy";
import { blogFeedPath, type SitePage, sitePageKey, sitePagePath } from "../routes";
import { siteConfig } from "../site";

interface Props {
  /** Sabit sayfa ya da blog yazısı: kanonik adres ve üst çubuktaki etkin bağlantı bundan. */
  readonly page: SitePage;
  readonly meta: PageMeta;
  /** Kişiye özel sayfalar (hesap, yönetim) ve 404 arama motorlarına kapalıdır; kanonik adresleri de verilmez. */
  readonly indexed: boolean;
}
const { page, meta, indexed } = Astro.props;
const origin: string = siteConfig.siteOrigin;
const canonical: string = `${origin}${sitePagePath(page)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Tema ilk boyamadan önce uygulanır: engelleyici ama harici (CSP satır içi betiğe izin vermez). */}
    <script is:inline src="/theme.js"></script>
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {indexed ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <link rel="preload" href="/fonts/InterVariable-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={copy.blog.feedTitle} href={blogFeedPath} />
    <meta name="theme-color" content="#fdfcfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={productName} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${origin}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.common.ogImageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.common.skipLink}</a>
    {/* Sayfanın kendisi; sonundaki çekmede yukarı kayar ve arkasındaki PullReveal görünür. */}
    <div id="page-shell" class="page-shell">
      <Header page={sitePageKey(page)} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
    <PullReveal />
  </body>
</html>

<script>
  import "../client/anchor-focus";
</script>
