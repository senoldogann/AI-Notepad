---
// Tüm sayfaların iskeleti: başlık ve açıklama, kanonik adres, hreflang, Open Graph, simgeler, üst çubuk ve alt bilgi.
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { copy, type PageMeta } from "../i18n/copy";
import { type Lang, type PageKey, langMeta, langs, pageUrl } from "../i18n/routes";
import { siteConfig } from "../site";

interface Props {
  readonly lang: Lang;
  readonly page: PageKey;
  readonly meta: PageMeta;
  /** Kişiye özel sayfalar (hesap, giriş bağlantısı) arama motorlarına kapalıdır. */
  readonly indexed: boolean;
}
const { lang, page, meta, indexed } = Astro.props;
const origin: string = siteConfig.siteOrigin;
const canonical: string = pageUrl(page, lang, origin);
const ogImage: string = `${origin}/og.png`;
---

<!doctype html>
<html lang={langMeta[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {indexed ? null : <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {langs.map((alternate: Lang) => <link rel="alternate" hreflang={alternate} href={pageUrl(page, alternate, origin)} />)}
    <link rel="alternate" hreflang="x-default" href={`${origin}/`} />
    <link rel="preload" href="/fonts/InterVariable-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fdfcfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AI-Notepad" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AI-Notepad" />
    <meta property="og:locale" content={langMeta[lang].ogLocale} />
    {
      langs
        .filter((alternate: Lang): boolean => alternate !== lang)
        .map((alternate: Lang) => <meta property="og:locale:alternate" content={langMeta[alternate].ogLocale} />)
    }
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">{copy[lang].common.skipLink}</a>
    <Header lang={lang} page={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} page={page} />
    <script>
      import { rememberLang } from "../client/lang";

      rememberLang(document.documentElement.lang);
    </script>
  </body>
</html>
