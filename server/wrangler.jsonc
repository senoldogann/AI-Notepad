// AI-Notepad abonelik sürümü sunucusu (Cloudflare Worker).
// Gizli değerler burada değil, `wrangler secret put` ile girilir (bkz. README.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ainotepad-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  // Günlük temizlik (03:17 UTC): süresi dolmuş satırlar silinir (`src/cleanup.ts`). Ortamlara kalıtılır.
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ainotepad",
      // `wrangler d1 create ainotepad` çıktısındaki kimlik buraya yazılır.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Hız sınırları: süre yalnızca 10 ya da 60 saniye olabilir.
  "ratelimits": [
    { "name": "AUTH_IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
    { "name": "START_USER_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "PROXY_USER_LIMITER", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "SITE_ORIGIN": "http://localhost:8788",
    "APPLE_CLIENT_IDS": "com.senoldogan.AINotepadHosted",
    "APP_ATTEST_POLICY": "optional",
    "APP_ATTEST_ENVIRONMENT": "development",
    "APP_ATTEST_APP_IDS": "TEAMID0000.com.senoldogan.AINotepadHosted",
    "APP_ATTEST_ALLOWED_CATEGORIES": "3,6",
    "TRIAL_MEETINGS": "3",
    "TRIAL_ACCOUNTS_PER_IP_PER_DAY": "3",
    "TRIAL_MAX_MEETING_MINUTES": "90",
    "SUBSCRIBER_MAX_MEETING_MINUTES": "240",
    "MONTHLY_CAP_HOURS": "10",
    "MEETING_GRACE_MINUTES": "30",
    "PAST_DUE_GRACE_DAYS": "7",
    // Toplantı başına token bütçesi (girdi + çıktı, Haiku 5.5 tokenizer'ı; Türkçe ~1,7 token/kelime):
    // - Canlı çeviri: her bitmiş cümle için bir çağrı (`translationRequest`: sistem ~300 + 3 cümle bağlam ~75 +
    //   cümle ~25 + sarmalayıcı ~20 ≈ 420 girdi; çeviri ~30 + low effort düşünme ~70 ≈ 100 çıktı) ≈ 600 token/çağrı.
    //   Konuşma ~150 kelime/dk, ~12 kelime/cümle → ~12 cümle/dk = 720 çağrı/saat.
    //   4 saat: 2880 × 600 ≈ 1,73 M.  90 dakika: 1080 × 600 ≈ 0,65 M.
    // - "Ne kaçırdım?" ve Sor: ~10 kullanım × ~4 K ≈ 40 K (deneme ~15 K).
    // - Toplantı sonu not (parçalı not + birleştirme + konuşmacı gözden geçirme): 4 saatlik metin ~60–70 K token,
    //   ~3 geçiş + 8 K'lık çıktılar ≈ 300 K (90 dakika ≈ 100 K).
    // Toplam 4 saat ≈ 2,07 M, %25 pay → 2,6 M. Deneme (90 dk) ≈ 0,77 M, %25 pay → 1,0 M.
    // Maliyet üst sınırı (girdi ağırlıklı, 0,10 $/M girdi, 0,50 $/M çıktı): 4 saatlik toplantı < ~0,40 $.
    // Not: çağrı başına `tahmin + max_tokens` önceden ayrılır, sonra gerçek kullanıma indirilir; bütçe gerçek kullanımı ölçer.
    "TRIAL_MEETING_TOKEN_BUDGET": "1000000",
    "SUBSCRIBER_MEETING_TOKEN_BUDGET": "2600000",
    // Kullanıcı başına token sınırları (yeni toplantı açmak bütçeyi sıfırlamasın diye):
    // - Saatlik oran yukarıdaki türetmeden: 4 saat ≈ 2,07 M → ~0,52 M token/saat.
    // - Aylık: 10 saat × 0,52 M = 5,2 M, %25 pay → 6,5 M (en çok ~0,9 $/ay).
    // - Günlük: en uzun tek toplantının bütçesi (2,6 M) sığsın, kısa ek kullanım kalsın → 3,0 M.
    "MONTHLY_TOKEN_CAP": "6500000",
    "DAILY_TOKEN_CAP": "3000000",
    "MAX_MEETING_STARTS_PER_DAY": "20",
    "LLM_MAX_TOKENS": "8192",
    "LLM_MAX_REQUEST_BYTES": "400000",
    "LLM_MAX_INPUT_TOKENS": "100000",
    "TRANSCRIBE_MAX_BYTES": "95000000",
    "TRANSCRIBE_MAX_KEYTERMS": "100",
    "SCRIBE_USD_PER_HOUR": "0.22",
    "SCRIBE_KEYTERMS_USD_PER_HOUR": "0.05",
    "DAILY_SPEND_CEILING_USD": "25",
    "REFRESH_TOKEN_DAYS": "60",
    "EMAIL_SENDER": "dev",
    "EMAIL_FROM": "AI-Notepad <giris@example.com>",
    "EMAIL_LINK_URL": "http://localhost:8788/giris/eposta",
    "STRIPE_PRICE_ID": "price_placeholder"
  },
  "env": {
    "production": {
      "name": "ainotepad-server-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ainotepad-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "AUTH_IP_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "API_IP_LIMITER", "namespace_id": "2002", "simple": { "limit": 300, "period": 60 } },
        { "name": "START_USER_LIMITER", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } },
        { "name": "PROXY_USER_LIMITER", "namespace_id": "2004", "simple": { "limit": 120, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "SITE_ORIGIN": "https://ainotepad.pages.dev",
        "APPLE_CLIENT_IDS": "com.senoldogan.AINotepadHosted",
        "APP_ATTEST_POLICY": "optional",
        "APP_ATTEST_ENVIRONMENT": "production",
        "APP_ATTEST_APP_IDS": "TEAMID0000.com.senoldogan.AINotepadHosted",
        "APP_ATTEST_ALLOWED_CATEGORIES": "6",
        "TRIAL_MEETINGS": "3",
        "TRIAL_ACCOUNTS_PER_IP_PER_DAY": "3",
        "TRIAL_MAX_MEETING_MINUTES": "90",
        "SUBSCRIBER_MAX_MEETING_MINUTES": "240",
        "MONTHLY_CAP_HOURS": "10",
        "MEETING_GRACE_MINUTES": "30",
        "PAST_DUE_GRACE_DAYS": "7",
        // Türetme: üstteki geliştirme `vars` açıklaması.
        "TRIAL_MEETING_TOKEN_BUDGET": "1000000",
        "SUBSCRIBER_MEETING_TOKEN_BUDGET": "2600000",
        "MONTHLY_TOKEN_CAP": "6500000",
        "DAILY_TOKEN_CAP": "3000000",
        "MAX_MEETING_STARTS_PER_DAY": "20",
        "LLM_MAX_TOKENS": "8192",
            "LLM_MAX_REQUEST_BYTES": "400000",
        "LLM_MAX_INPUT_TOKENS": "100000",
        "TRANSCRIBE_MAX_BYTES": "95000000",
        "TRANSCRIBE_MAX_KEYTERMS": "100",
        "SCRIBE_USD_PER_HOUR": "0.22",
        "SCRIBE_KEYTERMS_USD_PER_HOUR": "0.05",
        "DAILY_SPEND_CEILING_USD": "25",
        "REFRESH_TOKEN_DAYS": "60",
        "EMAIL_SENDER": "resend",
        "EMAIL_FROM": "AI-Notepad <giris@example.com>",
        "EMAIL_LINK_URL": "https://ainotepad.pages.dev/giris/eposta",
        "STRIPE_PRICE_ID": "price_placeholder"
      }
    }
  }
}
