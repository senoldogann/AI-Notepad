// Gistsmith abonelik sürümü sunucusu (Cloudflare Worker). İç adlar (worker, D1, paket kimlikleri) eski
// `ainotepad` adını korur.
// Gizli değerler burada değil, `wrangler secret put` ile girilir (bkz. README.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ainotepad-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  // Günlük temizlik (03:17 UTC): süresi dolmuş satırlar silinir (`src/cleanup.ts`). Ortamlara kalıtılır.
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ainotepad",
      // `wrangler d1 create ainotepad` çıktısındaki kimlik buraya yazılır.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Hız sınırları: süre yalnızca 10 ya da 60 saniye olabilir. REPORT_IP_LIMITER: `POST /v1/reports` (geri bildirim,
  // çökme, iletişim) IP başına dakikada 5; ayrıca hesap başına günde 20 ve tür başına günlük `REPORT_BYTES_PER_DAY`.
  "ratelimits": [
    { "name": "AUTH_IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
    { "name": "START_USER_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "PROXY_USER_LIMITER", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } },
    { "name": "REPORT_IP_LIMITER", "namespace_id": "1005", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "SITE_ORIGIN": "http://localhost:8788",
    "APPLE_CLIENT_IDS": "com.senoldogan.AINotepad.hosted,com.senoldogan.AINotepad.web",
    // Google OAuth istemci kimlikleri (açık değerler); kimlik jetonunun `aud`'u bunlardan biri olmalı. Mac uygulaması
    // Google kimlik jetonunu site üzerinden aldığı için tek istemci sitenin web istemcisidir.
    "GOOGLE_CLIENT_IDS": "461373321454-ku1ot0ildt8b9toe7aerq1imidfgu1ah.apps.googleusercontent.com",
    // Yönetici API'si (`/v1/admin/…`) için `<sağlayıcı>:<sub>` listesi; boşsa kimse yönetici değildir. Kendi kimliğini
    // öğrenmek için giriş yapıp `GET /v1/admin/stats` çağır: 403 yanıtındaki `error.identity`.
    "ADMIN_IDENTITIES": "",
    // `GET /v1/download/mac` buraya yönlendirir (302) ve günlük sayacı artırır.
    "DMG_URL": "https://github.com/senoldogann/AI-Notepad/releases/latest/download/AI-Notepad.dmg",
    // Yalnızca yönetici istatistiğindeki MRR tahmini için (Stripe fiyatıyla elle aynı tutulur).
    "PRICE_USD_MONTHLY": "5.99",
    // Rapor türü başına (geri bildirim, çökme, iletişim ayrı) tüm kullanıcılar için günde en çok saklanan bayt; aşılınca
    // `429 daily_cap_reached`. 2 MB ≈ 30 en büyük (64 KB) çökme raporu ya da ~400 uzun geri bildirim. Üst sınır:
    // 3 tür × 2 MB × 180 günlük saklama ≈ 1,1 GB.
    "REPORT_BYTES_PER_DAY": "2000000",
    "APP_ATTEST_POLICY": "optional",
    "APP_ATTEST_ENVIRONMENT": "development",
    "APP_ATTEST_APP_IDS": "TEAMID0000.com.senoldogan.AINotepad.hosted",
    "APP_ATTEST_ALLOWED_CATEGORIES": "3,6",
    // Apple DeviceCheck ile Mac başına ücretsiz deneme (src/deviceCheck.ts). Tek anahtar DEVICECHECK_POLICY:
    // "required" ise denemesi henüz bir Mac'e bağlanmamış hesabın deneme toplantısı DeviceCheck jetonu ister ve Mac'in
    // bit0'ı doluysa (Mac başka hesaba deneme verdi) `403 trial_device_used`; "off" ise DeviceCheck hiç çağrılmaz
    // (yerelde ve testlerde). "required" iken DEVICECHECK_TEAM_ID ve DEVICECHECK_KEY_ID Apple biçiminde (10 karakter) ve
    // gizli DEVICECHECK_PRIVATE_KEY (.p8 içeriği) girilmiş olmalı; değilse her istek 500 (config_invalid).
    "DEVICECHECK_POLICY": "off",
    "DEVICECHECK_ENVIRONMENT": "development",
    "DEVICECHECK_TEAM_ID": "79DZ4AA4DW",
    "DEVICECHECK_KEY_ID": "DEVICECHECK_KEY_ID_PENDING",
    "TRIAL_MEETINGS": "3",
    // Deneme: TRIAL_MEETINGS toplantı ya da TRIAL_DAYS gün, hangisi önce dolarsa. Süre hesabın ilk deneme toplantısıyla
    // başlar (kayıtla değil); süre dolunca kullanılmamış toplantılar da düşer (`402 trial_exhausted`).
    "TRIAL_DAYS": "7",
    // Aboneliği olmayan kullanıcının toplantıya bağlı olmayan çağrıları (Sor, notu yeniden yazma, düzenleme, görev
    // aracı) için günlük token sınırı. Türetme: 90 dakikalık toplantının notunu yeniden yazmak ~100 K token (aşağıdaki
    // bütçe açıklaması), bir Sor cevabı ~10–30 K. 300 K ≈ günde 3 not yenileme ya da ~10–20 soru: denemeyi değerlendirmeye
    // yeter. Maliyet üst sınırı (girdi ağırlıklı, 0,10 $/M girdi, 0,50 $/M çıktı): ≤ ~0,06 $/gün/hesap; yeni hesap
    // açarak (IP başına günde 3) kötüye kullanım günlük harcama tavanıyla da sınırlı. Aboneler kullanıcı sınırlarını
    // (DAILY_TOKEN_CAP, MONTHLY_TOKEN_CAP) kullanır.
    "TRIAL_ACCOUNT_DAILY_TOKENS": "300000",
    "TRIAL_ACCOUNTS_PER_IP_PER_DAY": "3",
    "TRIAL_MAX_MEETING_MINUTES": "90",
    "SUBSCRIBER_MAX_MEETING_MINUTES": "240",
    "MONTHLY_CAP_HOURS": "10",
    "MEETING_GRACE_MINUTES": "30",
    "PAST_DUE_GRACE_DAYS": "7",
    // Toplantı başına token bütçesi (girdi + çıktı, Haiku 5.5 tokenizer'ı; Türkçe ~1,7 token/kelime):
    // - Canlı çeviri: her bitmiş cümle için bir çağrı (`translationRequest`: sistem ~300 + 3 cümle bağlam ~75 +
    //   cümle ~25 + sarmalayıcı ~20 ≈ 420 girdi; çeviri ~30 + low effort düşünme ~70 ≈ 100 çıktı) ≈ 600 token/çağrı.
    //   Konuşma ~150 kelime/dk, ~12 kelime/cümle → ~12 cümle/dk = 720 çağrı/saat.
    //   4 saat: 2880 × 600 ≈ 1,73 M.  90 dakika: 1080 × 600 ≈ 0,65 M.
    // - "Ne kaçırdım?" ve Sor: ~10 kullanım × ~4 K ≈ 40 K (deneme ~15 K).
    // - Toplantı sonu not (parçalı not + birleştirme + konuşmacı gözden geçirme): 4 saatlik metin ~60–70 K token,
    //   ~3 geçiş + 8 K'lık çıktılar ≈ 300 K (90 dakika ≈ 100 K).
    // Toplam 4 saat ≈ 2,07 M, %25 pay → 2,6 M. Deneme (90 dk) ≈ 0,77 M, %25 pay → 1,0 M.
    // Maliyet üst sınırı (girdi ağırlıklı, 0,10 $/M girdi, 0,50 $/M çıktı): 4 saatlik toplantı < ~0,40 $.
    // Not: çağrı başına `tahmin + max_tokens` önceden ayrılır, sonra gerçek kullanıma indirilir; bütçe gerçek kullanımı ölçer.
    "TRIAL_MEETING_TOKEN_BUDGET": "1000000",
    "SUBSCRIBER_MEETING_TOKEN_BUDGET": "2600000",
    // Kullanıcı başına token sınırları (yeni toplantı açmak bütçeyi sıfırlamasın diye):
    // - Saatlik oran yukarıdaki türetmeden: 4 saat ≈ 2,07 M → ~0,52 M token/saat.
    // - Aylık: 10 saat × 0,52 M = 5,2 M, %25 pay → 6,5 M (en çok ~0,9 $/ay).
    // - Günlük: en uzun tek toplantının bütçesi (2,6 M) sığsın, kısa ek kullanım kalsın → 3,0 M.
    "MONTHLY_TOKEN_CAP": "6500000",
    // Abonenin toplantıya bağlı olmayan çağrıları (Sor, notu yeniden yazma, düzenleme, görev aracı) için aylık ayrı sınır
    // (MONTHLY_TOKEN_CAP'in parçası; toplantı bütçeleri değişmez). Türetme: notu yeniden yazmak ~100 K, Sor ~10–30 K →
    // 1,5 M ≈ ayda ~15 not yenileme ya da ~50–100 soru; en çok ~0,2 $/ay. Aşılınca `403 monthly_cap_reached`.
    "MONTHLY_ACCOUNT_TOKEN_CAP": "1500000",
    "DAILY_TOKEN_CAP": "3000000",
    "MAX_MEETING_STARTS_PER_DAY": "20",
    "LLM_MAX_TOKENS": "8192",
    // Toplantıya bağlı olmayan çağrı (Sor, notu yeniden yazma, düzenleme, görev aracı): daha küçük çağrı başı sınır.
    "LLM_ACCOUNT_MAX_TOKENS": "6144",
    "LLM_MAX_REQUEST_BYTES": "400000",
    "LLM_MAX_INPUT_TOKENS": "100000",
    "TRANSCRIBE_MAX_BYTES": "95000000",
    "TRANSCRIBE_MAX_KEYTERMS": "100",
    "SCRIBE_USD_PER_HOUR": "0.22",
    "SCRIBE_KEYTERMS_USD_PER_HOUR": "0.05",
    "DAILY_SPEND_CEILING_USD": "25",
    // Deneme harcamasının (deneme toplantıları + denemedeki toplantı dışı çağrılar) ayrı günlük tavanı: aşılınca yeni deneme
    // toplantısı ve denemedeki hesap çağrısı `503 trial_capacity_reached` alır; aboneler yalnızca genel tavana tabidir
    // (kötüye kullanılan deneme genel tavanı tüketip aboneleri durduramaz). Açık deneme toplantıları sürer.
    "DAILY_TRIAL_SPEND_CEILING_USD": "10",
    "REFRESH_TOKEN_DAYS": "60",
    "STRIPE_PRICE_ID": "price_placeholder"
  },
  "env": {
    "production": {
      "name": "ainotepad-server-production",
      // Yalnızca özel alan adı (gistsmith.com bölgesi aynı hesapta): https://api.gistsmith.com. workers.dev adresi ve
      // sürüm önizleme adresleri kapalıdır: onlar bölgenin WAF hız sınırı kuralını atlardı.
      "routes": [{ "pattern": "api.gistsmith.com", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ainotepad-production",
          "database_id": "d732acfd-fdb3-4f52-ac79-7c2654d9388b",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "AUTH_IP_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "API_IP_LIMITER", "namespace_id": "2002", "simple": { "limit": 300, "period": 60 } },
        { "name": "START_USER_LIMITER", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } },
        { "name": "PROXY_USER_LIMITER", "namespace_id": "2004", "simple": { "limit": 120, "period": 60 } },
        { "name": "REPORT_IP_LIMITER", "namespace_id": "2005", "simple": { "limit": 5, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        // Site; API özel alan adı `https://api.gistsmith.com` (Worker'ın tek adresi; workers.dev kapalı).
        "SITE_ORIGIN": "https://gistsmith.com",
        "APPLE_CLIENT_IDS": "com.senoldogan.AINotepad.hosted,com.senoldogan.AINotepad.web",
        // Sitenin Google web istemcisi (bkz. üstteki geliştirme `vars` açıklaması). `placeholder` içeren değerle üretim
        // her istekte 500 verir (ConfigPlaceholderError).
        "GOOGLE_CLIENT_IDS": "461373321454-ku1ot0ildt8b9toe7aerq1imidfgu1ah.apps.googleusercontent.com",
        // Boş: kimse yönetici değil. Bkz. üstteki geliştirme `vars` açıklaması.
        "ADMIN_IDENTITIES": "google:101383806107899312129",
        "DMG_URL": "https://github.com/senoldogann/gistsmith-releases/releases/latest/download/Gistsmith.dmg",
        "PRICE_USD_MONTHLY": "5.99",
        // Bkz. üstteki geliştirme `vars` açıklaması.
        "REPORT_BYTES_PER_DAY": "2000000",
        "APP_ATTEST_POLICY": "optional",
        "APP_ATTEST_ENVIRONMENT": "production",
        "APP_ATTEST_APP_IDS": "79DZ4AA4DW.com.senoldogan.AINotepad.hosted",
        "APP_ATTEST_ALLOWED_CATEGORIES": "6",
        // Bkz. üstteki geliştirme `vars` açıklaması. Anahtar Apple Developer › Keys'te "Gistsmith DeviceCheck"; gizli
        // DEVICECHECK_PRIVATE_KEY (.p8 içeriği) girilmeden üretim her istekte 500 verir.
        "DEVICECHECK_POLICY": "required",
        "DEVICECHECK_ENVIRONMENT": "production",
        "DEVICECHECK_TEAM_ID": "79DZ4AA4DW",
        "DEVICECHECK_KEY_ID": "HRQ8LH4N52",
        "TRIAL_MEETINGS": "3",
        // Bkz. üstteki geliştirme `vars` açıklaması.
        "TRIAL_DAYS": "7",
        // Türetme: üstteki geliştirme `vars` açıklaması.
        "TRIAL_ACCOUNT_DAILY_TOKENS": "300000",
        "TRIAL_ACCOUNTS_PER_IP_PER_DAY": "3",
        "TRIAL_MAX_MEETING_MINUTES": "90",
        "SUBSCRIBER_MAX_MEETING_MINUTES": "240",
        "MONTHLY_CAP_HOURS": "10",
        "MEETING_GRACE_MINUTES": "30",
        "PAST_DUE_GRACE_DAYS": "7",
        // Türetme: üstteki geliştirme `vars` açıklaması.
        "TRIAL_MEETING_TOKEN_BUDGET": "1000000",
        "SUBSCRIBER_MEETING_TOKEN_BUDGET": "2600000",
        "MONTHLY_TOKEN_CAP": "6500000",
        // Bkz. üstteki geliştirme `vars` açıklaması.
        "MONTHLY_ACCOUNT_TOKEN_CAP": "1500000",
        "DAILY_TOKEN_CAP": "3000000",
        "MAX_MEETING_STARTS_PER_DAY": "20",
        "LLM_MAX_TOKENS": "8192",
        // Toplantıya bağlı olmayan çağrı (Sor, notu yeniden yazma, düzenleme, görev aracı): daha küçük çağrı başı sınır.
        "LLM_ACCOUNT_MAX_TOKENS": "6144",
        "LLM_MAX_REQUEST_BYTES": "400000",
        "LLM_MAX_INPUT_TOKENS": "100000",
        "TRANSCRIBE_MAX_BYTES": "95000000",
        "TRANSCRIBE_MAX_KEYTERMS": "100",
        "SCRIBE_USD_PER_HOUR": "0.22",
        "SCRIBE_KEYTERMS_USD_PER_HOUR": "0.05",
        "DAILY_SPEND_CEILING_USD": "25",
        // Bkz. üstteki geliştirme `vars` açıklaması.
        "DAILY_TRIAL_SPEND_CEILING_USD": "10",
        "REFRESH_TOKEN_DAYS": "60",
        "STRIPE_PRICE_ID": "price_1UVgVdLYGoRn8lDP8H0WX1VF"
      }
    }
  }
}
