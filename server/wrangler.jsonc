// Gistsmith abonelik sürümü sunucusu (Cloudflare Worker). İç adlar (worker, D1, paket kimlikleri) eski
// `ainotepad` adını korur.
// Gizli değerler burada değil, `wrangler secret put` ile girilir (bkz. README.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ainotepad-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  // Günlük temizlik (03:17 UTC): süresi dolmuş satırlar silinir (`src/cleanup.ts`). Ortamlara kalıtılır.
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ainotepad",
      // `wrangler d1 create ainotepad` çıktısındaki kimlik buraya yazılır.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Hız sınırları: süre yalnızca 10 ya da 60 saniye olabilir. REPORT_IP_LIMITER: `POST /v1/reports` (geri bildirim,
  // çökme, iletişim) IP başına dakikada 5; ayrıca hesap başına günde 20 ve tür başına günlük `REPORT_BYTES_PER_DAY`.
  // DEEPGRAM_USER_LIMITER: `POST /v1/live/deepgram-token` kullanıcı başına dakikada 10 (kayıt başında iki akış, kopmada
  // yeniden bağlanma; ayrıca toplantı başına toplam ve 5 dakikalık pencere sınırı, bkz. src/deepgram.ts).
  // TELEMETRY_USER_LIMITER: `POST /v1/telemetry` ve `/v1/telemetry/features` kullanıcı başına dakikada 6 (uygulama en
  // çok birkaç dakikada bir gönderir; ayrıca hesap başına günde 200 istek, bkz. src/telemetry.ts).
  "ratelimits": [
    { "name": "AUTH_IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 1200, "period": 60 } },
    { "name": "START_USER_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "PROXY_USER_LIMITER", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } },
    { "name": "REPORT_IP_LIMITER", "namespace_id": "1005", "simple": { "limit": 5, "period": 60 } },
    { "name": "DEEPGRAM_USER_LIMITER", "namespace_id": "1006", "simple": { "limit": 10, "period": 60 } },
    { "name": "TELEMETRY_USER_LIMITER", "namespace_id": "1007", "simple": { "limit": 6, "period": 60 } }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "SITE_ORIGIN": "http://localhost:8788",
    "APPLE_CLIENT_IDS": "com.senoldogan.AINotepad.hosted,com.senoldogan.AINotepad.web",
    // Google OAuth istemci kimlikleri (açık değerler); kimlik jetonunun `aud`'u bunlardan biri olmalı. Mac uygulaması
    // Google kimlik jetonunu site üzerinden aldığı için tek istemci sitenin web istemcisidir.
    "GOOGLE_CLIENT_IDS": "461373321454-ku1ot0ildt8b9toe7aerq1imidfgu1ah.apps.googleusercontent.com",
    // Yönetici API'si (`/v1/admin/…`) için `<sağlayıcı>:<sub>` listesi; boşsa kimse yönetici değildir. Kendi kimliğin
    // D1'deki `auth_identities` tablosundadır (bkz. README "İlk dağıtım").
    "ADMIN_IDENTITIES": "",
    // Yönetici uçlarının Cloudflare Access denetimi: ekip alan adı ve Access uygulamasının AUD etiketi (64 onaltılık).
    // AUD boşsa denetim kapalıdır (yerelde Access yok); yalnızca `ADMIN_IDENTITIES` denetlenir.
    "CF_ACCESS_TEAM_DOMAIN": "dry-heart-1ee2.cloudflareaccess.com",
    "CF_ACCESS_AUD": "",
    // `GET /v1/download/mac` buraya yönlendirir (302) ve günlük sayacı artırır.
    "DMG_URL": "https://github.com/senoldogann/AI-Notepad/releases/latest/download/AI-Notepad.dmg",
    // DMG ile aynı sürümdeki Sparkle akışı: `GET /v1/download/mac/version` sitedeki sürüm numarasını buradan okur.
    "APPCAST_URL": "https://github.com/senoldogann/AI-Notepad/releases/latest/download/appcast.xml",
    // Fiyatlar Stripe fiyatlarıyla elle aynı tutulur (Stripe çağrılmaz). Aylık: yönetici MRR tahmini, davet indirimi
    // (yıllık planda tek seferlik indirim) ve davet ödülü (davet edenin müşteri bakiyesi alacağı). Yıllık: yalnızca MRR
    // (ayda 1/12'si).
    "PRICE_USD_MONTHLY": "5.99",
    "PRICE_USD_YEARLY": "49",
    // Davet programı (src/referrals.ts): "on" ise abonelere davet kodu verilir ve Checkout kodu kabul eder; "off" ise
    // yeni kod verilmez, kod reddedilir (`503 referral_unavailable`); hak kazanmış bekleyen ödüller yine verilir.
    "REFERRAL_POLICY": "on",
    // Davet edenin aynı anda açık tutabileceği en çok davet: ödülü bekleyen (`joined`, `qualified`), son 24 saatte
    // Checkout'a götürülen (açık ödeme sayfası olabilir) ve son 365 günde kart yeniden kullanıldığı için düşen davetler.
    // Dolunca kod yeni arkadaşa `409 referral_limit_reached` döner; ödül verildikçe ya da davet düştükçe yer açılır.
    // Kötüye kullanım sınırı: tek kartla açılan hesaplar da bir yer tutar, sınırsız ücretsiz ay çıkmaz.
    "REFERRAL_MAX_PENDING": "3",
    // Rapor türü başına (geri bildirim, çökme, iletişim ayrı) tüm kullanıcılar için günde en çok saklanan bayt; aşılınca
    // `429 daily_cap_reached`. 2 MB ≈ 30 en büyük (64 KB) çökme raporu ya da ~400 uzun geri bildirim. Üst sınır:
    // 3 tür × 2 MB × 180 günlük saklama ≈ 1,1 GB.
    "REPORT_BYTES_PER_DAY": "2000000",
    "APP_ATTEST_POLICY": "optional",
    "APP_ATTEST_ENVIRONMENT": "development",
    "APP_ATTEST_APP_IDS": "TEAMID0000.com.senoldogan.AINotepad.hosted",
    "APP_ATTEST_ALLOWED_CATEGORIES": "3,6",
    // Apple DeviceCheck ile Mac başına ücretsiz deneme (src/deviceCheck.ts). Tek anahtar DEVICECHECK_POLICY:
    // "required" ise denemesi henüz bir Mac'e bağlanmamış hesabın deneme toplantısı DeviceCheck jetonu ister ve Mac'in
    // bit0'ı doluysa (Mac başka hesaba deneme verdi) `403 trial_device_used`; "off" ise DeviceCheck hiç çağrılmaz
    // (yerelde ve testlerde). "required" iken DEVICECHECK_TEAM_ID ve DEVICECHECK_KEY_ID Apple biçiminde (10 karakter) ve
    // gizli DEVICECHECK_PRIVATE_KEY (.p8 içeriği) girilmiş olmalı; değilse her istek 500 (config_invalid).
    "DEVICECHECK_POLICY": "off",
    "DEVICECHECK_ENVIRONMENT": "development",
    "DEVICECHECK_TEAM_ID": "79DZ4AA4DW",
    "DEVICECHECK_KEY_ID": "DEVICECHECK_KEY_ID_PENDING",
    "TRIAL_MEETINGS": "3",
    // Deneme: TRIAL_MEETINGS toplantı ya da TRIAL_DAYS gün, hangisi önce dolarsa. Süre hesabın ilk deneme toplantısıyla
    // başlar (kayıtla değil); süre dolunca kullanılmamış toplantılar da düşer (`402 trial_exhausted`).
    "TRIAL_DAYS": "7",
    // Aboneliği olmayan kullanıcının toplantıya bağlı olmayan çağrıları (Sor, notu yeniden yazma, düzenleme, görev
    // aracı) için günlük token sınırı. Türetme: 90 dakikalık toplantının notunu yeniden yazmak ~100 K token (aşağıdaki
    // bütçe açıklaması), bir Sor cevabı ~10–30 K. 300 K ≈ günde 3 not yenileme ya da ~10–20 soru: denemeyi değerlendirmeye
    // yeter. Maliyet üst sınırı (girdi ağırlıklı, 0,10 $/M girdi, 0,50 $/M çıktı): ≤ ~0,06 $/gün/hesap; yeni hesap
    // açarak (IP başına günde TRIAL_ACCOUNTS_PER_IP_PER_DAY hesap: IP başına günde ≤ ~0,06 $ × bu sayı) kötüye kullanım
    // günlük deneme harcama tavanıyla (DAILY_TRIAL_SPEND_CEILING_USD) da sınırlı. Aboneler kullanıcı sınırlarını
    // (DAILY_TOKEN_CAP, MONTHLY_TOKEN_CAP) kullanır.
    "TRIAL_ACCOUNT_DAILY_TOKENS": "300000",
    "TRIAL_ACCOUNTS_PER_IP_PER_DAY": "3",
    "TRIAL_MAX_MEETING_MINUTES": "90",
    "SUBSCRIBER_MAX_MEETING_MINUTES": "240",
    "MONTHLY_CAP_HOURS": "10",
    "MEETING_GRACE_MINUTES": "30",
    "PAST_DUE_GRACE_DAYS": "7",
    // Toplantı başına token bütçesi (girdi + çıktı, Haiku 5.5 tokenizer'ı; Türkçe ~1,7 token/kelime):
    // - Canlı çeviri: her bitmiş cümle için bir çağrı (`translationRequest`: sistem ~300 + 3 cümle bağlam ~75 +
    //   cümle ~25 + sarmalayıcı ~20 ≈ 420 girdi; çeviri ~30 + low effort düşünme ~70 ≈ 100 çıktı) ≈ 600 token/çağrı.
    //   Konuşma ~150 kelime/dk, ~12 kelime/cümle → ~12 cümle/dk = 720 çağrı/saat.
    //   4 saat: 2880 × 600 ≈ 1,73 M.  90 dakika: 1080 × 600 ≈ 0,65 M.
    // - "Ne kaçırdım?" ve Sor: ~10 kullanım × ~4 K ≈ 40 K (deneme ~15 K).
    // - Toplantı sonu not (parçalı not + birleştirme + konuşmacı gözden geçirme): 4 saatlik metin ~60–70 K token,
    //   ~3 geçiş + 8 K'lık çıktılar ≈ 300 K (90 dakika ≈ 100 K).
    // Toplam 4 saat ≈ 2,07 M, %25 pay → 2,6 M. Deneme (90 dk) ≈ 0,77 M, %25 pay → 1,0 M.
    // Maliyet üst sınırı (girdi ağırlıklı, 0,10 $/M girdi, 0,50 $/M çıktı): 4 saatlik toplantı < ~0,40 $.
    // Not: çağrı başına `tahmin + max_tokens` önceden ayrılır, sonra gerçek kullanıma indirilir; bütçe gerçek kullanımı ölçer.
    "TRIAL_MEETING_TOKEN_BUDGET": "1000000",
    "SUBSCRIBER_MEETING_TOKEN_BUDGET": "2600000",
    // Kullanıcı başına token sınırları (yeni toplantı açmak bütçeyi sıfırlamasın diye):
    // - Saatlik oran yukarıdaki türetmeden: 4 saat ≈ 2,07 M → ~0,52 M token/saat.
    // - Aylık: 10 saat × 0,52 M = 5,2 M, %25 pay → 6,5 M (en çok ~0,9 $/ay).
    // - Günlük: en uzun tek toplantının bütçesi (2,6 M) sığsın, kısa ek kullanım kalsın → 3,0 M.
    "MONTHLY_TOKEN_CAP": "6500000",
    // Abonenin toplantıya bağlı olmayan çağrıları (Sor, notu yeniden yazma, düzenleme, görev aracı) için aylık ayrı sınır
    // (MONTHLY_TOKEN_CAP'in parçası; toplantı bütçeleri değişmez). Türetme: notu yeniden yazmak ~100 K, Sor ~10–30 K →
    // 1,5 M ≈ ayda ~15 not yenileme ya da ~50–100 soru; en çok ~0,2 $/ay. Aşılınca `403 monthly_cap_reached`.
    "MONTHLY_ACCOUNT_TOKEN_CAP": "1500000",
    "DAILY_TOKEN_CAP": "3000000",
    "MAX_MEETING_STARTS_PER_DAY": "20",
    "LLM_MAX_TOKENS": "8192",
    // Toplantıya bağlı olmayan çağrı (Sor, notu yeniden yazma, düzenleme, görev aracı): daha küçük çağrı başı sınır.
    "LLM_ACCOUNT_MAX_TOKENS": "6144",
    "LLM_MAX_REQUEST_BYTES": "400000",
    "LLM_MAX_INPUT_TOKENS": "100000",
    "TRANSCRIBE_MAX_BYTES": "95000000",
    "TRANSCRIBE_MAX_KEYTERMS": "100",
    "SCRIBE_USD_PER_HOUR": "0.22",
    "SCRIBE_KEYTERMS_USD_PER_HOUR": "0.05",
    // ElevenLabs Creator planı: ayda 121 000 kredi, ölçülen ~1080 kredi/ses saati → ~110 saat; dönem ayın 11'inde
    // yenilenir. Kredi bitince her konuşma tanıma isteği başarısız olur (sağlayıcı uyarmaz): kullanım %80 ve %95'i aşınca
    // `elevenlabs_capacity_threshold` alarmı, eşiğin üstündeyken günlük `elevenlabs_capacity_high` alarmı; durum
    // `GET /v1/admin/stats` → `elevenLabs`. Gün 1–28 olmalı.
    "ELEVENLABS_MONTHLY_AUDIO_HOURS": "110",
    "ELEVENLABS_BILLING_DAY": "11",
    // Deepgram canlı metni (src/deepgram.ts): "on" ise açık toplantıya kısa ömürlü Deepgram jetonu verilir (gizli
    // DEEPGRAM_API_KEY gerekir; yoksa her istek 500), "off" ise verilmez ve uygulama canlı metni Mac'te (WhisperKit)
    // üretir. Yerelde ve testlerde "off". Bütçe ömür boyudur (sahibin ücretsiz kredisinin canlı metne ayrılan kısmı);
    // tahmin temkinlidir: toplantının ilk jetonunda kalan en çok süresi × 2 akış peşin sayılır, toplantı bitince gerçek
    // süreye indirilir. Tahmin bütçeye ulaşınca yeni toplantılar Mac'e geçer (`/v1/me` → `liveEngine: "whisperkit"`);
    // %80 ve %95'te `deepgram_budget_threshold` alarmı. Fiyat: Nova-3 çok dilli akışın dakika liste fiyatı (temkinli).
    "DEEPGRAM_POLICY": "off",
    "DEEPGRAM_BUDGET_USD": "185",
    "DEEPGRAM_USD_PER_MINUTE": "0.0092",
    "DAILY_SPEND_CEILING_USD": "25",
    // Deneme harcamasının (deneme toplantıları + denemedeki toplantı dışı çağrılar) ayrı günlük tavanı: aşılınca deneme
    // harcaması açan her istek (yeni deneme toplantısı, açık ya da yeniden açılmış deneme toplantılarının yapay zekâ ve
    // yazıya dökme çağrıları, deneme toplantısının yeniden işlenmesi, denemedeki hesap çağrısı) `503
    // trial_capacity_reached` alır; aboneler yalnızca genel tavana tabidir (kötüye kullanılan deneme genel tavanı tüketip
    // aboneleri durduramaz).
    "DAILY_TRIAL_SPEND_CEILING_USD": "10",
    "REFRESH_TOKEN_DAYS": "60",
    // Aynı ürünün iki fiyatı: aylık (varsayılan plan) ve yıllık. İkisi de "bizim" sayılır (webhook, iade, itiraz).
    "STRIPE_PRICE_ID": "price_placeholder",
    "STRIPE_YEARLY_PRICE_ID": "price_yearly_placeholder",
    // Yönetim panelinden blog yayını (src/blog.ts): yazılar bu deponun bu dalındaki web/src/content/blog/*.md
    // dosyalarıdır; panel GitHub API'siyle okur, yazar ve siler (her kayıt dala bir commit). Gizli GITHUB_BLOG_TOKEN
    // (yalnızca bu depoda Contents okuma/yazma yetkili ince ayarlı jeton) girilmemişse blog uçları
    // `503 blog_unavailable` döner. Yerelde ve testlerde jeton yoktur.
    "GITHUB_BLOG_REPO": "senoldogann/AI-Notepad",
    "GITHUB_BLOG_BRANCH": "main",
    // Yönetim panelindeki site istatistikleri (src/siteAnalytics.ts): Cloudflare GraphQL API'sinden sitenin Web
    // Analytics toplamları (sayfa görüntüleme, ziyaret, en çok açılan sayfalar, yönlendiren siteler; son 30 gün). Hesap
    // kimliği ve sitenin etiketi açık değerdir (32 onaltılık karakter); gizli CF_ANALYTICS_TOKEN (yalnızca Account ›
    // Account Analytics › Read yetkili API jetonu) girilmemişse ya da biri boşsa uç `503 analytics_unavailable` döner.
    // Yerelde ve testlerde boş.
    "CF_ANALYTICS_ACCOUNT_ID": "",
    "CF_ANALYTICS_SITE_TAG": ""
  },
  "env": {
    "production": {
      "name": "ainotepad-server-production",
      // Yalnızca özel alan adı (gistsmith.com bölgesi aynı hesapta): https://api.gistsmith.com. workers.dev adresi ve
      // sürüm önizleme adresleri kapalıdır: onlar bölgenin WAF hız sınırı kuralını atlardı.
      "routes": [{ "pattern": "api.gistsmith.com", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ainotepad-production",
          "database_id": "d732acfd-fdb3-4f52-ac79-7c2654d9388b",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "AUTH_IP_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "API_IP_LIMITER", "namespace_id": "2002", "simple": { "limit": 1200, "period": 60 } },
        { "name": "START_USER_LIMITER", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } },
        { "name": "PROXY_USER_LIMITER", "namespace_id": "2004", "simple": { "limit": 120, "period": 60 } },
        { "name": "REPORT_IP_LIMITER", "namespace_id": "2005", "simple": { "limit": 5, "period": 60 } },
        { "name": "DEEPGRAM_USER_LIMITER", "namespace_id": "2006", "simple": { "limit": 10, "period": 60 } },
        { "name": "TELEMETRY_USER_LIMITER", "namespace_id": "2007", "simple": { "limit": 6, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        // Site; API özel alan adı `https://api.gistsmith.com` (Worker'ın tek adresi; workers.dev kapalı).
        "SITE_ORIGIN": "https://gistsmith.com",
        "APPLE_CLIENT_IDS": "com.senoldogan.AINotepad.hosted,com.senoldogan.AINotepad.web",
        // Sitenin Google web istemcisi (bkz. üstteki geliştirme `vars` açıklaması). `placeholder` içeren değerle üretim
        // her istekte 500 verir (ConfigPlaceholderError).
        "GOOGLE_CLIENT_IDS": "461373321454-ku1ot0ildt8b9toe7aerq1imidfgu1ah.apps.googleusercontent.com",
        // Sahibin Google kimliği; tek yönetici kapısıdır (CF_ACCESS_AUD bilerek boş). Biçim: üstteki geliştirme `vars`
        // açıklaması.
        "ADMIN_IDENTITIES": "google:101383806107899312129",
        // Access uygulamasının AUD etiketi. Bilerek boş (denetim kapalı): yönetim paneli API'yi Access çerezi olmadan
        // çağırır; açılırsa panel 403 alır (bkz. src/auth/access.ts).
        "CF_ACCESS_TEAM_DOMAIN": "dry-heart-1ee2.cloudflareaccess.com",
        "CF_ACCESS_AUD": "",
        "DMG_URL": "https://github.com/senoldogann/gistsmith-releases/releases/latest/download/Gistsmith.dmg",
        "APPCAST_URL": "https://github.com/senoldogann/gistsmith-releases/releases/latest/download/appcast.xml",
        // Bkz. üstteki geliştirme `vars` açıklaması. Yıllık fiyat vergi dahil 49 $ (`gistsmith_yearly`).
        "PRICE_USD_MONTHLY": "5.99",
        "PRICE_USD_YEARLY": "49",
        "REFERRAL_POLICY": "on",
        // Bkz. üstteki geliştirme `vars` açıklaması.
        "REFERRAL_MAX_PENDING": "3",
        // Bkz. üstteki geliştirme `vars` açıklaması.
        "REPORT_BYTES_PER_DAY": "2000000",
        "APP_ATTEST_POLICY": "optional",
        "APP_ATTEST_ENVIRONMENT": "production",
        "APP_ATTEST_APP_IDS": "79DZ4AA4DW.com.senoldogan.AINotepad.hosted",
        "APP_ATTEST_ALLOWED_CATEGORIES": "6",
        // Bkz. üstteki geliştirme `vars` açıklaması. Anahtar Apple Developer › Keys'te "Gistsmith DeviceCheck"; gizli
        // DEVICECHECK_PRIVATE_KEY (.p8 içeriği) girilmeden üretim her istekte 500 verir.
        "DEVICECHECK_POLICY": "required",
        "DEVICECHECK_ENVIRONMENT": "production",
        "DEVICECHECK_TEAM_ID": "79DZ4AA4DW",
        "DEVICECHECK_KEY_ID": "HRQ8LH4N52",
        "TRIAL_MEETINGS": "3",
        // Bkz. üstteki geliştirme `vars` açıklaması.
        "TRIAL_DAYS": "7",
        // Türetme: üstteki geliştirme `vars` açıklaması.
        "TRIAL_ACCOUNT_DAILY_TOKENS": "300000",
        // Lansman (sahibin kararı, 2026-10-29): aynı ofis ve mobil operatör (CGNAT) arkasındaki kullanıcılar takılmasın;
        // Mac başına deneme DeviceCheck ile ayrıca sınırlı.
        "TRIAL_ACCOUNTS_PER_IP_PER_DAY": "10",
        "TRIAL_MAX_MEETING_MINUTES": "90",
        "SUBSCRIBER_MAX_MEETING_MINUTES": "240",
        "MONTHLY_CAP_HOURS": "10",
        "MEETING_GRACE_MINUTES": "30",
        "PAST_DUE_GRACE_DAYS": "7",
        // Türetme: üstteki geliştirme `vars` açıklaması.
        "TRIAL_MEETING_TOKEN_BUDGET": "1000000",
        "SUBSCRIBER_MEETING_TOKEN_BUDGET": "2600000",
        "MONTHLY_TOKEN_CAP": "6500000",
        // Bkz. üstteki geliştirme `vars` açıklaması.
        "MONTHLY_ACCOUNT_TOKEN_CAP": "1500000",
        "DAILY_TOKEN_CAP": "3000000",
        "MAX_MEETING_STARTS_PER_DAY": "20",
        "LLM_MAX_TOKENS": "8192",
        // Toplantıya bağlı olmayan çağrı (Sor, notu yeniden yazma, düzenleme, görev aracı): daha küçük çağrı başı sınır.
        "LLM_ACCOUNT_MAX_TOKENS": "6144",
        "LLM_MAX_REQUEST_BYTES": "400000",
        "LLM_MAX_INPUT_TOKENS": "100000",
        "TRANSCRIBE_MAX_BYTES": "95000000",
        "TRANSCRIBE_MAX_KEYTERMS": "100",
        "SCRIBE_USD_PER_HOUR": "0.22",
        "SCRIBE_KEYTERMS_USD_PER_HOUR": "0.05",
        // Bkz. üstteki geliştirme `vars` açıklaması.
        // Otomatik yükleme kapalı (sahibin kararı: her ödeme önce sorulur). Bu dönem (11 Ekim–11 Kasım): Creator planı
        // 121 K + bir kez alınan 137,5 K yükleme kredisi = 258,5 K; ölçülen ~1.080 kredi/saat ile ~239 saat. Yükleme
        // kredisi 12 ay geçerli, ay başında sıfırlanmaz; her dönem başında hesaptaki kalan krediye göre yeniden ayarla.
        "ELEVENLABS_MONTHLY_AUDIO_HOURS": "235",
        "ELEVENLABS_BILLING_DAY": "11",
        // Bkz. üstteki geliştirme `vars` açıklaması. Gizli DEEPGRAM_API_KEY girilmeden "on" her istekte 500 verir.
        // Açık (sahibin kararı): kurulan akış jetonun süresi dolsa da sürebilir. DEEPGRAM_BUDGET_USD tahmini izler, kesin
        // sınır değildir (değiştirilmiş istemci akışı toplantıdan sonra açık tutabilir); kesin üst sınır Deepgram
        // projesinin otomatik yüklemesiz ön ödemeli bakiyesidir.
        "DEEPGRAM_POLICY": "on",
        "DEEPGRAM_BUDGET_USD": "185",
        "DEEPGRAM_USD_PER_MINUTE": "0.0092",
        "DAILY_SPEND_CEILING_USD": "50",
        // Bkz. üstteki geliştirme `vars` açıklaması.
        "DAILY_TRIAL_SPEND_CEILING_USD": "25",
        "REFRESH_TOKEN_DAYS": "60",
        "STRIPE_PRICE_ID": "price_1UVi9QLYGoRn8lDP4oA916Gt",
        // Yıllık fiyat (arama anahtarı `gistsmith_yearly`, vergi dahil, aylıkla aynı ürün).
        "STRIPE_YEARLY_PRICE_ID": "price_1UW0JgLYGoRn8lDPf8gFeNSz",
        // Bkz. üstteki geliştirme `vars` açıklaması. Dala gelen her blog commit'i sitenin yayın iş akışını
        // (.github/workflows/deploy-web.yml) tetikler.
        "GITHUB_BLOG_REPO": "senoldogann/AI-Notepad",
        "GITHUB_BLOG_BRANCH": "main",
        // Bkz. üstteki geliştirme `vars` açıklaması. Sahibin dolduracağı değerler: Cloudflare panelinin hesap kimliği ve
        // Web Analytics › gistsmith.com sitesinin etiketi (`siteTag`); gizli CF_ANALYTICS_TOKEN ayrıca girilir.
        "CF_ANALYTICS_ACCOUNT_ID": "",
        "CF_ANALYTICS_SITE_TAG": ""
      }
    }
  }
}
