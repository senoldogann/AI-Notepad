      "shouldTranslate": false
    },
    "NSAudioCaptureUsageDescription": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-Notepad listens to system audio to transcribe the other participants in your meetings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-Notepad toplantıdaki diğer katılımcıların sesini yazıya dökmek için sistem sesini dinler."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-Notepad shows your upcoming meetings, reminds you before they start and saves the note under the meeting's name."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-Notepad yaklaşan toplantılarını gösterir, başlamadan önce hatırlatır ve notu toplantının adıyla kaydeder."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-Notepad uses the microphone to transcribe what you say in meetings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-Notepad toplantıda söylediklerini yazıya dökmek için mikrofonu kullanır."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-Notepad adds tasks from your meeting notes to Reminders when you ask it to."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-Notepad toplantı notundaki görevleri istediğinde Anımsatıcılar'a ekler."
          }
        }
      }
    }
  },
  "version": "1.0"
}
