    "AI-Notepad": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-Notepad"
          }
        }
      }
    },
    "AI-Notepad bağlantı denemesi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-Notepad connection test"
          }
        }
      }
    },
    "AI-Notepad'i açar ve yüz yüze toplantıyı kaydetmeye başlar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens AI-Notepad and starts recording an in-person meeting."
          }
        }
      }
    },
    "AI-Notepad, Teams ve Zoom toplantılarını canlı olarak yazıya döker ve Türkçeye çevirir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-Notepad transcribes Teams and Zoom meetings live and translates them into Turkish."
          }
        }
      }
    },
    "Ad": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        }
      }
    },
    "Ad (ör. Aino)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name (e.g. Aino)"
          }
        }
      }
    },
    "Ad konuşma tanımaya verilir; bir toplantıda konuşmacıya bu adı verince toplantıları ve görevleri burada toplanır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name is given to speech recognition; when you give a speaker this name in a meeting, their meetings and tasks gather here."
          }
        }
      }
    },
    "Ad toplantılarda verildi; değiştirmek için toplantının Transkript sekmesini kullan.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name was given in meetings; to change it, use the meeting's Transcript tab."
          }
        }
      }
    },
    "Ad ver ya da başka konuşmacıyla birleştir": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name or merge with another speaker"
          }
        }
      }
    },
    "Ad verdiğin kişilerin ses izi (ses değil, yalnızca sayılar) bu Mac'te saklanır: sonraki toplantılarda adı kendiliğinden gelir, kayıtta bir süre susup dönen kişi aynı numarayı alır. Emin olunmayan durumda ad verilmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voiceprint of people you name (numbers only, no audio) is kept on this Mac: in later meetings their name appears automatically, and someone who goes quiet and speaks again during a recording keeps the same number. No name is given when unsure."
          }
        }
      }
    },
