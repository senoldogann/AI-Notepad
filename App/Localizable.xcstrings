          "stringUnit": {
            "state": "translated",
            "value": "%@: %@"
          }
        }
      }
    },
    "%@: %lld görev açıldı": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@: %lld task created"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@: %lld tasks created"
                }
              }
            }
          }
        },
        "tr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@: %lld görev açıldı"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@: %lld görev açıldı"
                }
              }
            }
          }
        }
      }
    },
    "%@: %lld/%lld görev açıldı. «%@» açılırken yanıt gelmedi (%@); iş açılmış olabilir. Yeniden göndermeden önce %@ içinde kontrol et: açıldıysa yeniden gönderim onu ikinci kez açar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld of %lld tasks created. No response while creating “%@” (%@); the issue may have been created. Check in %@ before sending again: if it was created, sending again creates it a second time."
          }
        }
      }
    },
    "%@: %lld/%lld görev açıldı; kalanlar açılamadı: %@. Yeniden gönderince yalnızca kalanlar gider.": {
      "localizations": {
        "en": {
