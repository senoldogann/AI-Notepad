            "state": "translated",
            "value": "All done."
          }
        }
      }
    },
    "Hepsi tamamlandı. Yeni toplantılarda sana düşen işler buraya gelir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All done. Your tasks from new meetings will appear here."
