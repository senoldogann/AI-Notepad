            "value": "Interface language"
          }
        }
      }
    },
    "Arayüz dilini, tanıma motorunu, görünümü, yapay zekâ modellerini, anahtarları ve kısayolları yönet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage the interface language, recognition engine, appearance, AI models, keys and shortcuts."
