    "Mikrofon başlatılamadı (kod %lld). Giriş cihazını kontrol edip kaydı yeniden başlat.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone couldn't start (code %lld). Check the input device and restart the recording."
          }
        }
      }
    },
    "Mikrofon beklenmedik şekilde durdu. Kaydı bitirip yeniden başlat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone stopped unexpectedly. Finish the recording and start again."
          }
        }
      }
    },
    "Mikrofon izni yok. Sistem Ayarları › Gizlilik ve Güvenlik › Mikrofon'da bu uygulamaya izin ver.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No microphone permission. Allow this app in System Settings › Privacy & Security › Microphone."
          }
        }
      }
    },
    "Mikrofon kesildi (arama ya da alarm). Kesinti bitince kayıt kendiliğinden sürer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone was interrupted (call or alarm). Recording resumes by itself when it ends."
          }
        }
      }
    },
    "Mikrofon senin sesin, sistem sesi karşı taraf. İkisi ayrı kaydedilir, konuşmacılar ayrılır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is you, system audio is the other side. Both are recorded separately and speakers are separated."
