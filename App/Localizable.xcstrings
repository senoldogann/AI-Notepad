    },
    "Birebir görüşme": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-on-one"
          }
        }
      }
    },
    "Biten toplantılar iCloud Drive'a taşınır ve Mac'teki AI-Notepad'de de görünür (Mac'te de açık olmalı). Kayıt ve işleme bu iPhone'da yapılır. Kapatınca iCloud'daki toplantılar bu iPhone'a taşınır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished meetings move to iCloud Drive and also appear in AI-Notepad on your Mac (it must be on there too). Recording and processing happen on this iPhone. Turning it off moves the meetings in iCloud to this iPhone."
          }
        }
      }
    },
    "Biten toplantılar iCloud Drive'a taşınır ve iPhone'daki AI-Notepad'de de görünür; iPhone'da kaydedilenler buraya gelir. Kayıt ve işleme her zaman bu Mac'te yapılır. Kapatınca iCloud'daki toplantılar bu Mac'e geri taşınır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished meetings move to iCloud Drive and also appear in AI-Notepad on your iPhone; meetings recorded on the iPhone come here. Recording and processing always happen on this Mac. Turning it off moves the meetings in iCloud back to this Mac."
          }
        }
      }
    },
    "Bitince toplantının sayfası açılır; görevlerin en üstte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When done, the meeting page opens with your tasks at the top."
          }
