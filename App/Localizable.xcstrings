        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add this configuration to the client's MCP settings (Claude Desktop: Settings › Developer › Edit Config). The client can list and search your meetings and read notes and transcripts; it only reads and changes nothing."
          }
