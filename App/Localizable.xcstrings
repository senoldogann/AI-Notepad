    "%@%@%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@%@"
          }
        }
      }
    },
    "%@'e dönebilirsin; bu sekmeyi kapatabilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can go back to %@ and close this tab."
          }
        }
      }
    },
