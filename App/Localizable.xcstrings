{
  "sourceLanguage": "tr",
  "strings": {
    " (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " (%@)"
          }
        }
      }
    },
    "\"%@\" klasörüne, hesap gerekmez": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Into a \"%@\" folder, no account needed"
          }
        }
      }
    },
    "\"%@\" toplantısı öncesi brifing: Bu konuda önceki toplantılarda neler konuşuldu, hangi kararlar alındı, hangi görevler hâlâ açık? Kısa maddelerle, en yeniden başlayarak.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Briefing for \"%@\": what was discussed in earlier meetings on this topic, what was decided and which tasks are still open? Short bullet points, newest first."
          }
        }
      }
    },
    "\"Başlat\"a bas; konuşmalar burada canlı yazıya dökülür, bitince toplantının notu hazırlanır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press \"Start\": the conversation is transcribed here live, and the meeting note is prepared when it ends."
          }
        }
      }
    },
    "\"Ne kaçırdım?\" son %lld dakikayı özetler": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "\"What did I miss?\" summarizes the last %lld minute"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "\"What did I miss?\" summarizes the last %lld minutes"
                }
              }
            }
          }
        },
        "tr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "\"Ne kaçırdım?\" son %lld dakikayı özetler"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "\"Ne kaçırdım?\" son %lld dakikayı özetler"
                }
              }
            }
          }
        }
      }
    },
    "\"Ne kaçırdım?\", soru ve toplantı notu": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"What did I miss?\", questions and meeting notes"
          }
        }
      }
    },
    "\"Notu yenile\" ile not yeniden yazılabilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use \"Refresh note\" to write it again."
          }
        }
      }
    },
    "\"Sen\" kaydı yazıya dökülemedi: %@ Canlı metin eksik olabilir; \"Tekrar işle\" ile yeniden deneyebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't transcribe the \"You\" recording: %@ The live text may be incomplete; you can try again with \"Reprocess\"."
          }
        }
      }
    },
    "\"Sen\" metni eksik: kayıt sırasında akış koptu ve \"Sen\" sesi kaydedilmemiş.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"You\" text is incomplete: the stream dropped during recording and the \"You\" audio wasn't saved."
          }
        }
      }
    },
    "%@ %@ hazır": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ is ready"
          }
        }
      }
    },
    "%@ %@ çıktı": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ is available"
          }
        }
      }
    },
    "%@ / %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@"
          }
        }
      }
    },
    "%@ / %@ sa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@ h"
          }
        }
      }
    },
    "%@ adresine ulaşılamadı; internet bağlantını kontrol et.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach %@; check your internet connection."
          }
        }
      }
    },
    "%@ anahtarı kabul edilmedi. Ayarlar'dan anahtarı kontrol et.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't accept the key. Check the key in Settings."
          }
        }
      }
    },
    "%@ anahtarı kayıtlı değil. Ayarlar'dan ekle.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No %@ key saved. Add it in Settings."
          }
        }
      }
    },
    "%@ bağlandı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ connected."
          }
        }
      }
    },
    "%@ bağlandı; deneme mesajı gönderildi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ connected; a test message was sent."
          }
        }
      }
    },
    "%@ bağlantı denemesi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ connection test"
          }
        }
      }
    },
    "%@ bağlantısı bu cihazdan kaldırıldı ama %@ tarafında kapatılamadı (%@). %@'in erişimini %@ ayarlarından kaldır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ connection was removed from this device, but it couldn't be closed on the %@ side (%@). Remove %@'s access in your %@ settings."
          }
        }
      }
    },
    "%@ bağlantısında iş açan araç bulunamadı; sunucunun araçları değişmiş olabilir. Uygulamayı güncelle ya da yeniden bağlan.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ offers no tool for creating issues; its tools may have changed. Update the app or reconnect."
          }
        }
      }
    },
    "%@ başka bir uygulamada kullanılıyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is used by another app."
          }
        }
      }
    },
    "%@ beklenen aracı (%@) artık sunmuyor; uygulamayı güncelle.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no longer offers the expected tool (%@); update the app."
          }
        }
      }
    },
    "%@ beklenmedik şekilde kapandı — raporu gönder?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quit unexpectedly — send the report?"
          }
        }
      }
    },
    "%@ beklenmeyen bir yanıt verdi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ returned an unexpected response."
          }
        }
      }
    },
    "%@ bir Agent Skill değil: başta name ve description içeren --- bölümü yok.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't an Agent Skill: it has no leading --- section with name and description."
          }
        }
      }
    },
    "%@ bir macOS sistem kısayolu; başka bir kısayol seç.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a macOS system shortcut; choose another one."
          }
        }
      }
    },
    "%@ boş: yönerge yok.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is empty: no instructions."
          }
        }
      }
    },
    "%@ diğer eyleme atanmış.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is already assigned to the other action."
          }
        }
      }
    },
    "%@ erişimin uygulamadan geri alınmasını desteklemiyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doesn't support revoking access from the app."
          }
        }
      }
    },
    "%@ etiketini kaldır": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove tag %@"
          }
        }
      }
    },
    "%@ girişi başka bir denemeden döndü; yeniden dene.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sign-in came back from a different attempt; try again."
          }
        }
      }
    },
    "%@ girişi bu sürümde henüz etkin değil. Şimdilik \"Webhook adresi\" kartıyla bağlayabilirsin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sign-in isn't available in this version yet. For now you can connect with the \"Webhook URL\" card."
          }
        }
      }
    },
    "%@ girişi tamamlanmadı (izin verilmedi). Yeniden dene.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sign-in wasn't completed (access not granted). Try again."
          }
        }
      }
    },
    "%@ girişi tamamlanmadı: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sign-in wasn't completed: %@"
          }
        }
      }
    },
    "%@ girişinin dönüşü başka bir denemeye ait; Ayarlar › Bağlantılar'dan yeniden bağlan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ sign-in returned from a different attempt; connect again from Settings › Connections."
          }
        }
      }
    },
    "%@ hesabında yazabileceğin bir kanal bulunamadı. Önce bir kanala katıl, sonra yeniden bağlan.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No channel you can post to was found in your %@ account. Join a channel first, then connect again."
          }
        }
      }
    },
    "%@ ile %@ aynı kişi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ and %@ are the same person"
          }
        }
      }
    },
    "%@ isteği kabul etmedi. Yeniden dene; sürerse bağlantıyı kaldırıp yeniden bağlan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't accept the request. Try again; if it keeps happening, remove the connection and connect again."
          }
        }
      }
    },
    "%@ içe aktarılamadı: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't import %@: %@"
          }
        }
      }
    },
    "%@ işlemi yapamadı (%@): %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ couldn't complete it (%@): %@"
          }
        }
      }
    },
    "%@ kaydedilemedi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ could not be registered."
          }
        }
      }
    },
    "%@ kotası doldu. Hesabından kota ekle ya da Ayarlar'dan Mac'te motorunu seç.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quota is used up. Add quota to your account or choose the On-Mac engine in Settings."
          }
        }
      }
    },
    "%@ kullanılamaz: ⌃, ⌥ ya da ⌘ ile birlikte bir harf/rakam seç.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can't be used: pick a letter or digit together with ⌃, ⌥ or ⌘."
          }
        }
      }
    },
    "%@ metin akışı durdu: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ transcript stream stopped: %@"
          }
        }
      }
    },
    "%@ not yazılır": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note is written in %@"
          }
        }
      }
    },
    "%@ oturumunun süresi doldu. Ayarlar › Bağlantılar'dan yeniden bağlan.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %@ session expired. Connect again in Settings › Connections."
          }
        }
      }
    },
    "%@ servisine bağlanılamadı; internet bağlantını kontrol et.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't connect to %@; check your internet connection."
          }
        }
      }
    },
    "%@ ses akışı beklenmedik şekilde durdu. Cihazı kontrol edip kaydı yeniden başlat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ audio stream stopped unexpectedly. Check the device and restart the recording."
          }
        }
      }
    },
    "%@ sesi diske yazılamadı: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ audio could not be written to disk: %@"
          }
        }
      }
    },
    "%@ sürümü hazırlanıyor…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing the %@ version…"
          }
        }
      }
    },
    "%@ tek tıkla girişi desteklemiyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doesn't support one-click sign-in."
          }
        }
      }
    },
    "%@ uygulamasında bağlantıyı yeniden başlat.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start connecting again in %@."
          }
        }
      }
    },
    "%@ webhook'u kabul etmedi. Adresin doğru ve etkin olduğunu kontrol et.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't accept the webhook. Check that the address is correct and active."
          }
        }
      }
    },
    "%@ yanıt vermedi (%@); not gitmiş olabilir. Kontrol et, gitmediyse elle yeniden gönder. Kendiliğinden yeniden gönderilmeyecek.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ did not respond (%@); the note may have been delivered. Check, and send it again manually if it did not arrive. It will not be resent automatically."
          }
        }
      }
    },
    "%@ yanıtı anlaşılamadı; yeniden dene.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't understand the %@ response; try again."
          }
        }
      }
    },
    "%@ yanıtı yarıda kesildi. Biraz sonra yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stopped responding midway. Try again in a moment."
          }
        }
      }
    },
    "%@ yeniden bağlandı; eski bağlantının izni %@ tarafında geri alınamadı (%@). Eski erişimi %@ ayarlarından kaldırabilirsin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reconnected, but the old connection's access couldn't be revoked on the %@ side (%@). You can remove the old access in your %@ settings."
          }
        }
      }
    },
    "%@ yorum satırları içeriyor; yorumlar kaybolmasın diye üzerine yazılmadı. Toplantı sunucusunu o uygulamanın ayarından elle ekle (komut: bu uygulama, --mcp argümanıyla).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ contains comments; it wasn't overwritten so they aren't lost. Add the meetings server by hand in that app's settings (command: this app, with the --mcp argument)."
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        }
      }
    },
    "%@ · Dinlemeye başlamak için tıkla.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Click to start listening."
          }
        }
      }
    },
    "%@ · okunmadı: %@ toplantılar (cihaz içi model bu dilleri desteklemiyor)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · not read: %@ meetings (the on-device model doesn't support these languages)"
          }
        }
      }
    },
    "%@ şu an yanıt veremedi. Biraz sonra yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ couldn't respond right now. Try again in a moment."
          }
        }
      }
    },
    "%@ — %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — %@"
          }
        }
      }
    },
    "%@ — Güncelle…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — Update…"
          }
        }
      }
    },
    "%@ — Yeniden başlat ve güncelle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — Restart and update"
          }
        }
      }
    },
    "%@ — kayıt bitince güncellenebilir": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — can update after recording"
          }
        }
      }
    },
    "%@ → %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@"
          }
        }
      }
    },
    "%@%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@"
          }
        }
