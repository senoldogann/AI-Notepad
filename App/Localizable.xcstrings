    "Hırvatça": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Croatian"
          }
        }
      }
    },
    "Hızlı model ve düşük effort önerilir: çeviri 1–2 sn'de gelir. Haiku ve Sonnet'te high ve altında düşünme kapatılır; Opus, Fable ve xhigh/max'ta düşünme açık kalır, çeviriler gecikip birikebilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fast model and low effort are recommended: translations arrive in 1–2 s. Haiku and Sonnet turn thinking off at high and below; with Opus, Fable or xhigh/max, thinking stays on and translations can lag and pile up."
          }
        }
      }
    },
