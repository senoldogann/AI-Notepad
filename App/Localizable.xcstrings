            "value": "Select a meeting"
          }
        }
      }
    },
    "Bir toplantının Transkript sekmesinde konuşmacıya bu adı verince toplantıları, konuşma payı ve görevleri burada görünür.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you give a speaker this name in a meeting's Transcript tab, their meetings, talk share and tasks appear here."
