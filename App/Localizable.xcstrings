          "stringUnit": {
            "state": "translated",
            "value": "Speaker suggestions"
          }
        }
      }
    },
    "Konuşmacılar ElevenLabs ile dakikada bir ayrılır; kayıt bitince ElevenLabs son geçişi yapılır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speakers are separated with ElevenLabs every minute; an ElevenLabs final pass runs when the recording ends."
          }
        }
      }
    },
    "Konuşmacılar Mac'te ayrılıyor": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separating speakers on this Mac"
          }
        }
      }
    },
    "Konuşmacılar Mac'te ayrılıyor ve not hazırlanıyor…": {
