{
  "sourceLanguage": "tr",
  "strings": {
    "": {
      "shouldTranslate": false
    },
    " (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " (%@)"
          }
        }
      }
    },
    "\"Başlat\"a bas; konuşmalar burada canlı yazıya dökülür, bitince toplantının notu hazırlanır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press \"Start\": the conversation is transcribed here live, and the meeting note is prepared when it ends."
          }
        }
      }
    },
    "\"Ne kaçırdım?\" ile son dakikaların Türkçe özeti; toplantı hakkında Türkçe soru.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"What did I miss?\" gives a Turkish summary of the last minutes; ask questions about the meeting in Turkish."
          }
        }
      }
    },
    "\"Ne kaçırdım?\" son %lld dakikayı özetler": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"What did I miss?\" summarizes the last %lld minutes"
          }
        }
      }
    },
    "\"Ne kaçırdım?\", soru ve toplantı notu": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"What did I miss?\", questions and meeting notes"
          }
        }
      }
    },
    "\"Notu yenile\" ile not yeniden yazılabilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use \"Refresh note\" to write it again."
          }
        }
      }
    },
    "\"Sen\" kaydı yazıya dökülemedi: %@ Canlı metin eksik olabilir; \"Tekrar işle\" ile yeniden deneyebilirsin.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't transcribe the \"You\" recording: %@ The live text may be incomplete; you can try again with \"Reprocess\"."
          }
        }
      }
    },
    "\"Sen\" metni eksik: kayıt sırasında akış koptu ve \"Sen\" sesi kaydedilmemiş.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"You\" text is incomplete: the stream dropped during recording and the \"You\" audio wasn't saved."
          }
        }
      }
    },
    "%@ / %@": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@"
          }
        }
      }
    },
    "%@ adresine ulaşılamadı; internet bağlantını kontrol et.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach %@; check your internet connection."
          }
        }
      }
    },
    "%@ anahtarı geçersiz (HTTP %lld). Ayarlar'dan kontrol et.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ key is invalid (HTTP %lld). Check it in Settings."
          }
        }
      }
    },
    "%@ anahtarı kayıtlı değil. Ayarlar'dan ekle.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No %@ key saved. Add it in Settings."
          }
        }
      }
    },
    "%@ anından çal": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play from %@"
          }
        }
      }
    },
    "%@ başka bir uygulamada kullanılıyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is used by another app."
          }
        }
      }
    },
    "%@ beklenmeyen bir yanıt verdi.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ returned an unexpected response."
          }
        }
      }
    },
    "%@ bir macOS sistem kısayolu; başka bir kısayol seç.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a macOS system shortcut; choose another one."
          }
        }
      }
    },
    "%@ diğer eyleme atanmış.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is already assigned to the other action."
          }
        }
      }
    },
    "%@ ile %@ aynı kişi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ and %@ are the same person"
          }
        }
      }
    },
    "%@ isteği başarısız (HTTP %lld). Biraz sonra tekrar dene.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ request failed (HTTP %lld). Try again in a moment."
          }
        }
      }
    },
    "%@ içe aktarılamadı: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't import %@: %@"
          }
        }
      }
    },
    "%@ kaydedilemedi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ could not be registered."
          }
        }
      }
    },
    "%@ kotası doldu. Hesabından kota ekle ya da Ayarlar'dan Mac'te motorunu seç.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quota is used up. Add quota to your account or choose the On-Mac engine in Settings."
          }
        }
      }
    },
    "%@ kullanılamaz: ⌃, ⌥ ya da ⌘ ile birlikte bir harf/rakam seç.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can't be used: pick a letter or digit together with ⌃, ⌥ or ⌘."
          }
        }
      }
    },
    "%@ metin akışı durdu: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ transcript stream stopped: %@"
          }
        }
      }
    },
    "%@ servisine bağlanılamadı; internet bağlantını kontrol et.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't connect to %@; check your internet connection."
          }
        }
      }
    },
    "%@ ses akışı beklenmedik şekilde durdu. Cihazı kontrol edip kaydı yeniden başlat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ audio stream stopped unexpectedly. Check the device and restart the recording."
          }
        }
      }
    },
    "%@ sesi diske yazılamadı: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ audio could not be written to disk: %@"
          }
        }
      }
    },
    "%@ sürümü hazırlanıyor…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing the %@ version…"
          }
        }
      }
    },
    "%@ webhook'u reddetti (HTTP %lld). Adresin doğru ve etkin olduğunu kontrol et.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rejected the webhook (HTTP %lld). Check that the URL is correct and active."
          }
        }
      }
    },
    "%@ yanıtı yarıda hata verdi (%@). Biraz sonra tekrar dene.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ response failed midway (%@). Try again in a moment."
          }
        }
      }
    },
    "%@ yanıtı çıktı sınırına ulaştığı için yarıda kesildi. Ayarlar › LLM'de effort'u düşürüp tekrar dene.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ response hit the output limit and was cut off. Lower the effort in Settings › LLM and try again."
          }
        }
      }
    },
    "%@ · Dinlemeye başlamak için tıkla.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Click to start listening."
