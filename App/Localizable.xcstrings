          "stringUnit": {
            "state": "translated",
            "value": "Test connection"
          }
        }
      }
    },
    "Bağlayınca uygulama toplantılarını listeleyip arar, notları ve transkriptleri okur; yalnızca okur, hiçbir şey değiştirmez. Okuduğunu kendi yapay zekâ sağlayıcısına gönderir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once connected, the app lists and searches your meetings and reads notes and transcripts; it only reads and never changes anything. What it reads goes to its own AI provider."
          }
        }
      }
    },
    "Bağlı": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected"
          }
        }
      }
    },
