      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the calendar"
          }
        }
      }
    },
    "Takvimde görüşme bağlantısı (Teams, Zoom, Meet) olan bir toplantı sürerken başka bir uygulama mikrofonu açınca kayıt kendiliğinden başlar ve bildirilir; bir kez kur, unut. Katılımcılara kaydettiğini söylemek senin sorumluluğunda.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While a calendar meeting with a call link (Teams, Zoom, Meet) is in progress and another app turns on the microphone, recording starts automatically and you're notified. Set it once and forget it. Telling participants you're recording is your responsibility."
          }
        }
      }
    },
    "Takvimdeki görüşme başladı ama kayıt açılamadı. Nedenini görmek için %@'i aç.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your calendar call started but recording couldn't turn on. Open %@ to see why."
          }
        }
      }
    },
    "Takvimdeki görüşme başladı ve kayıt kendiliğinden açıldı. Katılımcılara kaydettiğini söylemeyi unutma.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your calendar call started and recording turned on automatically. Remember to tell participants you're recording."
