                  "value": "Aylık sınırına göre bu toplantıya %lld dakika kaldı; kayıt %@ itibarıyla biter."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Aylık sınırına göre bu toplantıya %lld dakika kaldı; kayıt %@ itibarıyla biter."
                }
              }
            }
          }
        }
      }
    },
    "Aynı odadaki toplantı: mikrofondaki herkes konuşmacılara ayrılır": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting in the same room: everyone on the microphone is separated into speakers"
          }
        }
      }
    },
    "Aynı toplantı hedefte zaten var: %@. İki kopyayı karşılaştırıp birini sil.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same meeting already exists at the destination: %@. Compare the two copies and delete one."
          }
        }
      }
