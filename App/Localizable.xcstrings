    "Konuşmacılar ayrılamadı (%@); metin tek konuşmacı olarak kaydedildi. İnternete bağlanıp \"Tekrar işle\"yi dene.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speakers couldn't be separated (%@); the text was saved as a single speaker. Connect to the internet and try \"Reprocess\"."
