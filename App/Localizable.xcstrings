    "Anahtar Keychain'den okunamadı (%@, kod %lld). İzin penceresinde \"Her Zaman İzin Ver\"i seç.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the key from the Keychain (%@, code %lld). Choose \"Always Allow\" in the permission dialog."
          }
        }
      }
    },
    "Anahtarlar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys"
          }
        }
      }
    },
    "Anahtarlar macOS Anahtar Zinciri'nde saklanır ve hiçbir zaman gösterilmez. Terminal'den eklediysen ilk kullanımda çıkan izin penceresinde \"Her Zaman İzin Ver\"i seç.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys are stored in the macOS Keychain and are never shown. If you added them from Terminal, choose \"Always Allow\" in the permission dialog on first use."
          }
        }
      }
    },
    "Anahtarı yapıştır": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the key"
          }
        }
      }
    },
