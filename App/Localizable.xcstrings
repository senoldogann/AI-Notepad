        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the recording screen"
          }
        }
      }
    },
    "Kayıt hemen başlayabilir; canlı metin model hazır olunca gelir.": {
      "localizations": {
        "en": {
          "stringUnit": {
