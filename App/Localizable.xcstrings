    "Bitiriliyor… Son cümleler ve konuşmacılar tamamlanıyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finishing… completing the last sentences and speakers."
          }
        }
      }
