      }
    },
    "Konuşma tanıma modeli (%@) yüklenemedi. İnternet bağlantını ve disk alanını kontrol edip uygulamayı yeniden aç.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The speech recognition model (%@) couldn't be loaded. Check your internet connection and disk space, then reopen the app."
          }
        }
      }
    },
    "Konuşma tanıma modeli hazır değil.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The speech recognition model isn't ready."
          }
        }
      }
    },
    "Konuşma tanımanın doğru yazması gereken adlar, şirket ve ürün adları, kısaltmalar; satır başına bir tane (2–40 karakter, en fazla 5 sözcük; en fazla 30 kullanılır). Bulut motorunda (Deepgram, ElevenLabs) uygulanır. Toplantılarda verdiğin konuşmacı adları ve sözlük terimleri zaten kendiliğinden eklenir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names, company and product names and abbreviations that speech recognition should spell correctly; one per line (2–40 characters, at most 5 words; up to 30 are used). Applies to the cloud engine (Deepgram, ElevenLabs). Speaker names you give and glossary terms from meetings are added automatically."
          }
        }
      }
    },
    "Konuşmacı %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker %lld"
          }
        }
      }
    },
    "Konuşmacı ayırma başarısız: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker separation failed: %@"
          }
        }
      }
    },
    "Konuşmacı ayırma modeli indirilemedi; internete bağlanıp \"Modeli yeniden yükle\"ye bas.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The speaker separation model couldn't be downloaded; connect to the internet and click \"Reload model\"."
