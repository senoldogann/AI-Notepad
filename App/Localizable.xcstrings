    "Bu Mac Apple ile doğrulanamadı (DeviceCheck). İnternet bağlantını kontrol edip yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac couldn't be verified with Apple (DeviceCheck). Check your internet connection and try again."
          }
        }
      }
    },
    "Bu Mac Apple tarafından doğrulanamadı; uygulamayı yeniden açıp tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple couldn't verify this Mac; reopen the app and try again."
          }
        }
      }
    },
    "Bu Mac Apple'ın cihaz doğrulamasını (DeviceCheck) desteklemiyor; ücretsiz deneme başlatılamıyor. Abone olarak devam edebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac doesn't support Apple's device verification (DeviceCheck), so a free trial can't start. You can continue by subscribing."
          }
        }
      }
    },
    "Bu Mac doğrulanamadı; uygulamayı yeniden açıp tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac couldn't be verified; reopen the app and try again."
          }
        }
      }
    },
    "Bu Mac'te": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this Mac"
          }
        }
      }
    },
    "Bu Mac'te deneme kullanıldı": {
