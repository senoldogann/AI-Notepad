<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime altında mikrofon ("Sen") için gerekli. Sistem sesi (Core Audio tap) ayrı yetki istemez. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Hardened runtime altında takvim ve anımsatıcılar (EventKit): yaklaşan toplantılar, görevleri Anımsatıcılar'a ekleme. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- Notu istendiğinde Apple Notlar'a yazmak için (AppleScript; kullanıcı izni sorulur). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- iCloud eşitlemesi: biten toplantılar iCloud Drive kapsayıcısında (iPhone uygulamasıyla ortak). -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.senoldogan.AINotepad</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.senoldogan.AINotepad</string>
	</array>
</dict>
</plist>
