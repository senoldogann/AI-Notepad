    "NSCalendarsFullAccessUsageDescription": {
      "comment": "Privacy - Calendars Full Access Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-Notepad shows your upcoming meetings and saves a recording under the name and attendees of the meeting in progress."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-Notepad sıradaki toplantılarını gösterir ve kaydı süren toplantının adı ve katılımcılarıyla kaydeder."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-Notepad uses the microphone to transcribe in-person meetings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-Notepad yüz yüze toplantıyı yazıya dökmek için mikrofonu kullanır."
          }
        }
      }
    }
